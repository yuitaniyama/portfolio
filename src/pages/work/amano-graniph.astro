	.amano-pager a:hover,
	.amano-pager a:focus-visible {
		opacity: 0.7;
	}

	.amano-pager__next {
		text-align: right;
		align-items: flex-end;
	}

	.amano-pager__label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
