---
// Yoshitaka Amano × Graniph — Fashion Design case study (Project 04).
// A standalone page (same pattern as freedom-tax-japan.astro), not in
// the `work` content collection, so the hubstep [id].astro template and
// its collections stay untouched. Reuses the shared case-study layout
// classes from global.css (content-grid, case-study-body, case-index,
// case-section, section-eyebrow, .prose) and the same CaseHeader /
// EnlargeableImage / Placeholder components as the other case studies.
//
// No final image assets exist for this project yet — every photographic
// visual below is a <Ph> (Placeholder) labeled with the asset name from
// the content brief (e.g. "amano-collection-hero"), so a real <img> can
// be dropped in later without touching layout or copy. The three visuals
// the brief calls out as HTML/typography rather than images (first-week
// performance, customer reactions, the two process flows) are built as
// real markup, not placeholders.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import Ph from '../../components/Placeholder.astro';

const sections = [
	{ id: 'outcome', title: 'A collection that sold fast — and created genuine excitement' },
	{ id: 'the-challenge', title: "The challenge wasn't reproduction. It was translation." },
	{ id: 'exploration', title: 'I needed to see the ideas before I could judge them.' },
	{ id: 'creative-bet', title: 'Not every commercial decision has to be the safest one.' },
	{ id: 'making-it-physical', title: 'A strong graphic was not enough. It had to survive becoming fabric.' },
	{ id: 'what-i-learned', title: 'Good translation is not literal translation.' },
];

const kpis = [
	{ value: '70%', label: 'of my designs sold through more than 50% of their inventory in the first week' },
	{ value: '96.2%', label: 'first-week sell-through for the best-performing item' },
];

const explorationFlow = ['Explore', 'Compare', 'Eliminate', 'Refine'];
const productionFlow = ['Design', 'Specification', 'Print Test', 'Sample', 'Refinement', 'Production'];
---

<BaseLayout title="Translating Yoshitaka Amano's World into Wearable Products — Yui Taniyama" lang="en">
	<article class="content-grid">
		<!-- VISUAL 00 — amano-collection-hero (large, dominant; no title/meta overlay) -->
		<div class="amano-hero">
			<Ph label="amano-collection-hero — Final collection collage" ratio="16 / 10" />
		</div>

		<CaseHeader
			eyebrow="Fashion Design · Licensed Collaboration"
			title="Translating Yoshitaka Amano's World into Wearable Products"
			meta={[
				{ label: 'Role', value: 'Fashion Designer' },
				{
					label: 'Scope',
					value: 'Concept Development · Garment Design · Artwork Selection & Adaptation · Material & Print Review · Styling Direction',
				},
				{ label: 'Collaborators', value: 'IP Sales · Graphic Design · Production · Manager' },
				{ label: 'Period', value: 'May 2022 – May 2023' },
			]}
			intro={[
				"I designed a fashion collection that aimed to preserve the delicacy, intensity, and atmosphere of Yoshitaka Amano's artwork while making it work as clothing — across silhouette, material, print, and production.",
			]}
		/>

		<div class="case-study-body">
			<nav class="case-index" aria-label="Case study sections">
				<div class="case-index__eyebrow">In this case study</div>
				<ol>
					{
						sections.map((s) => (
							<li>
								<a href={`#${s.id}`}>{s.title}</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="case-sections">
				<!-- 01 OUTCOME -->
				<section id="outcome" class="case-section">
					<div class="section-eyebrow">After launch</div>
					<h2>A collection that sold fast — and created genuine excitement</h2>

					<div class="prose">
						<p>The collection performed strongly from its first week on sale.</p>
					</div>

					<!-- VISUAL 01 — first-week-performance [HTML typography, not an image] -->
					<div class="amano-kpis">
						{
							kpis.map((kpi) => (
								<div class="amano-kpi">
									<div class="amano-kpi__value">{kpi.value}</div>
									<div class="amano-kpi__label">{kpi.label}</div>
								</div>
							))
						}
					</div>

					<div class="amano-outcome-reactions">
						<div class="section-eyebrow">Customer reactions</div>
						<h3 class="amano-subheading">The numbers were only part of the story.</h3>

						<!-- VISUAL 02 — customer-reactions [HTML quote treatment, not an image] -->
						<div class="amano-quote">
							<p class="amano-quote__text">"I want everything from this collaboration…"</p>
							<p class="amano-quote__attribution">Customer post on X · translated from Japanese</p>
						</div>
						<div class="amano-quote">
							<p class="amano-quote__text">"If I saw this walking past the store, there's no way I wouldn't buy it."</p>
							<p class="amano-quote__attribution">Customer post on X · translated from Japanese</p>
						</div>

						<div class="prose">
							<p>
								The response suggested that the collection was doing more than translating a well-known IP into
								clothing — <strong>the products themselves were creating enough visual and emotional pull to drive
								both purchase and conversation.</strong>
							</p>
						</div>
					</div>
				</section>

				<!-- 02 THE CHALLENGE -->
				<section id="the-challenge" class="case-section">
					<div class="section-eyebrow">Preserving the feeling, not just the image</div>
					<h2>The challenge wasn't reproduction. It was translation.</h2>

					<div class="prose">
						<p>
							Yoshitaka Amano's work can feel incredibly delicate — almost fragile — while still carrying{' '}
							<strong>a distinct sense of tension, darkness, and strength.</strong>
						</p>
						<p>
							When I reviewed existing apparel using his artwork, I often felt that this balance was being lost.
							Heavy-looking prints, glossy finishes, or coarse fabrics could reproduce the image while changing the
							feeling of the original work.
						</p>
					</div>

					<div class="amano-quote">
						<p class="amano-quote__text">
							How could the clothes preserve the feeling of entering Amano's world, rather than simply placing his
							artwork onto a garment?
						</p>
					</div>

					<!-- VISUAL 03 — existing-apparel-review (kept compact — supporting evidence, not the focus) -->
					<div class="amano-compact-row">
						<figure class="amano-compact-row__visual">
							<Ph label="existing-apparel-review — Existing apparel using Amano's artwork" ratio="4 / 3" />
						</figure>
						<div class="amano-notes">
							<div class="amano-notes__heading">What I noticed</div>
							<ul class="amano-notes__list">
								<li>Materials sometimes fought against the delicacy of the artwork</li>
								<li>Some print finishes changed the character of the original image</li>
								<li>Reproducing the artwork alone did not necessarily preserve its atmosphere</li>
							</ul>
						</div>
					</div>
				</section>

				<!-- 03 EXPLORATION -->
				<section id="exploration" class="case-section">
					<div class="section-eyebrow">From artwork to garment</div>
					<h2>I needed to see the ideas before I could judge them.</h2>

					<div class="prose">
						<p>
							One thing I had learned through fashion design was that an idea that sounds right in conversation does
							not always work once it becomes visual.
						</p>
						<p>
							Sometimes an artwork that seemed like an obvious choice fell flat when placed on a garment. At other
							times, <strong>an unexpected combination immediately felt right.</strong>
						</p>
						<p>
							So I explored broadly before narrowing the collection — testing different relationships between
							artwork, silhouette, placement, material, and print.
						</p>
						<p>
							For this collection, I was also thinking about two overlapping audiences: people drawn through familiar
							fantasy imagery, and people who were deeply interested in Amano's artwork itself.
						</p>
						<p>
							The aim was not to design separately for each group, but to{' '}
							<strong>build a lineup that could satisfy both.</strong>
						</p>
					</div>

					<!-- VISUAL 04 — collection-exploration (large — communicates the volume of work explored) -->
					<figure class="amano-exploration-visual">
						<Ph label="collection-exploration — Large set of garment design explorations" ratio="4 / 3" />
					</figure>

					<div class="amano-flow">
						{
							explorationFlow.map((step, i) => (
								<Fragment>
									<span class="amano-flow__step">{step}</span>
									{i < explorationFlow.length - 1 && (
										<span class="amano-flow__arrow" aria-hidden="true">
											→
										</span>
									)}
								</Fragment>
							))
						}
					</div>
				</section>

				<!-- 04 A CREATIVE BET -->
				<section id="creative-bet" class="case-section">
					<div class="section-eyebrow">Design decision</div>
					<h2>Not every commercial decision has to be the safest one.</h2>

					<div class="prose">
						<p>One of the more debated pieces in the lineup was a vivid red sleeveless dress.</p>
						<p>
							Bright red and the silhouette were considered a more challenging choice for the expected customer, but{' '}
							<strong>I felt the combination of the artwork, color, and composition created something unusually
							strong.</strong>
						</p>
						<p>
							Rather than using the original artwork literally, I extended its visual world through color and
							composition to create a garment with its own presence.
						</p>
					</div>

					<div class="amano-quote">
						<p class="amano-quote__text">I advocated for keeping it in the lineup.</p>
					</div>

					<div class="prose">
						<p>The dress went on to sell through 54.2% of its inventory in the first week.</p>
						<p>
							The result reinforced something I already suspected:{' '}
							<strong>commercial thinking and creative instinct do not always have to pull in opposite
							directions.</strong>
						</p>
					</div>

					<!-- VISUAL 05 — red-dress-design-decision (strongest visual after the Hero) -->
					<div class="amano-bet-sequence">
						<div class="amano-bet-sequence__row">
							<figure class="amano-bet-sequence__step">
								<Ph label="red-dress-design-decision — Original artwork" ratio="3 / 4" />
								<figcaption class="section-eyebrow">Original artwork</figcaption>
							</figure>
							<figure class="amano-bet-sequence__step">
								<Ph label="red-dress-design-decision — Artwork adaptation" ratio="3 / 4" />
								<figcaption class="section-eyebrow">Artwork adaptation</figcaption>
							</figure>
							<figure class="amano-bet-sequence__step">
								<Ph label="red-dress-design-decision — Garment design" ratio="3 / 4" />
								<figcaption class="section-eyebrow">Garment design</figcaption>
							</figure>
						</div>
						<figure class="amano-bet-sequence__final">
							<Ph label="red-dress-design-decision — Final product (modeled red dress)" ratio="3 / 4" />
							<figcaption class="section-eyebrow">Final product</figcaption>
						</figure>
						<div class="amano-kpi amano-kpi--inline">
							<div class="amano-kpi__value">54.2%</div>
							<div class="amano-kpi__label">first-week sell-through</div>
						</div>
					</div>
				</section>

				<!-- 05 MAKING IT PHYSICAL -->
				<section id="making-it-physical" class="case-section">
					<div class="section-eyebrow">From visual idea to product</div>
					<h2>A strong graphic was not enough. It had to survive becoming fabric.</h2>

					<div class="prose">
						<p>Once the lineup was selected, the concepts had to become manufacturable products.</p>
						<p>
							The process moved from design specifications into material selection, print methods, sampling, and
							refinement.
						</p>
						<p>
							For printed pieces, the factory typically prepared multiple test versions. I compared them against the
							original artwork, looking at color reproduction, fine detail, print quality, and how the result
							behaved on the chosen fabric.
						</p>
						<p>The goal was not simply to find the most accurate print.</p>
						<p>
							It was to find the combination of <strong>artwork × material × print technique</strong> that preserved
							the character of the original work as closely as possible.
						</p>
					</div>

					<!-- VISUAL 06 — design-to-production-flow [HTML flow, not an image] -->
					<div class="amano-flow">
						{
							productionFlow.map((step, i) => (
								<Fragment>
									<span class="amano-flow__step">{step}</span>
									{i < productionFlow.length - 1 && (
										<span class="amano-flow__arrow" aria-hidden="true">
											→
										</span>
									)}
								</Fragment>
							))
						}
					</div>

					<!-- VISUAL 07 — print-material-testing (main visual in this section) -->
					<div class="amano-compact-row amano-compact-row--wide">
						<figure class="amano-compact-row__visual">
							<Ph label="print-material-testing — Blue printed fabric samples" ratio="4 / 3" />
						</figure>
						<div class="amano-notes">
							<div class="amano-notes__heading">What I checked</div>
							<ul class="amano-notes__list">
								<li>Color reproduction</li>
								<li>Fine artwork detail</li>
								<li>Print quality</li>
								<li>Material compatibility</li>
							</ul>
						</div>
					</div>

					<!-- Small supporting moment, not a major section -->
					<div class="amano-supporting">
						<h3 class="amano-supporting__heading">Extending the direction beyond the garment</h3>
						<div class="prose">
							<p>
								I also shared styling and model direction with the photography team — including the overall mood,
								coordination, and accessory references — to help the final imagery stay consistent with the
								collection.
							</p>
						</div>
						<div class="amano-supporting__visual">
							<Ph label="Styling / model direction reference (small, supporting)" ratio="4 / 3" />
						</div>
					</div>
				</section>

				<!-- 06 WHAT I LEARNED -->
				<section id="what-i-learned" class="case-section">
					<div class="section-eyebrow">What stayed with me</div>
					<h2>Good translation is not literal translation.</h2>

					<div class="prose">
						<p>
							After launch, I reviewed sales performance, visited stores, and spoke with sales staff to understand how
							customers were actually responding.
						</p>
						<p>
							Comparing those observations with our expectations helped me see which assumptions held up — and which
							did not.
						</p>
					</div>

					<ol class="amano-learnings">
						<li>
							<div class="amano-learnings__index">01</div>
							<h3 class="amano-learnings__heading">Design the whole product, not just the artwork.</h3>
							<div class="prose amano-learnings__body">
								<p>
									The strongest products were not simply the ones that reproduced Amano's artwork most faithfully.
								</p>
								<p>
									They were the ones where the <strong>artwork, material, silhouette, and print technique</strong> worked
									together as one product.
								</p>
							</div>
						</li>
						<li>
							<div class="amano-learnings__index">02</div>
							<h3 class="amano-learnings__heading">Creative instinct and commercial thinking can coexist.</h3>
							<div class="prose amano-learnings__body">
								<p>
									The red dress was a risk from a conventional merchandising perspective, but I believed the artwork
									and color could create a stronger emotional connection.
								</p>
								<p>
									Its performance reinforced{' '}
									<strong>the value of making informed creative bets rather than optimizing every decision for
									familiarity.</strong>
								</p>
							</div>
						</li>
						<li>
							<div class="amano-learnings__index">03</div>
							<h3 class="amano-learnings__heading">Make ideas tangible before trusting your assumptions.</h3>
							<div class="prose amano-learnings__body">
								<p>This project reinforced a habit that still influences how I design today:</p>
							</div>
							<p class="amano-learnings__takeaway">
								Ideas need to become tangible before they can really be judged. Making them visible, comparing
								alternatives, and observing what happens in the real world helps me challenge my own assumptions.
							</p>
						</li>
					</ol>
				</section>
			</div>
		</div>

		<nav class="amano-pager" aria-label="Case study navigation">
			<a href="/work/freedom-tax-japan/">
				<span class="amano-pager__label">Previous case study</span>
				<span class="amano-pager__title">Bringing Research and Testing to Freedom Tax Japan's Redesign</span>
			</a>
			<a href="/" class="amano-pager__next">
				<span class="amano-pager__label">Back to</span>
				<span class="amano-pager__title">All work →</span>
			</a>
		</nav>
	</article>
</BaseLayout>

<style>
	/* Vertical rhythm inside a section: heading, then blocks spaced evenly
	   (same two rules as freedom-tax-japan.astro — each standalone case
	   study page defines its own copy of this rather than it living in
	   global.css, since it's specific to how .case-section is used here). */
	.case-section > :global(* + *) {
		margin-top: var(--space-4);
	}

	.case-section > h2 + :global(*) {
		margin-top: var(--space-4);
	}

	/* Hero — large and dominant, full content-grid width (not capped like
	   FTJ's narrower hero), with nothing overlaid on top of it. */
	.amano-hero {
		margin-top: var(--space-6);
		margin-bottom: var(--space-6);
	}

	.amano-subheading {
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	/* KPI statements — editorial, not dashboard cards: no borders, no
	   background, just scale and whitespace. Side by side on desktop,
	   stacked on mobile. */
	.amano-kpis {
		display: flex;
		gap: var(--space-8);
		flex-wrap: wrap;
	}

	.amano-kpi {
		flex: 1 1 14rem;
	}

	.amano-kpi__value {
		font-size: clamp(3rem, 2.2rem + 3.5vw, 4.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.amano-kpi__label {
		margin-top: var(--space-2);
		max-width: 28rem;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		line-height: 1.6;
	}

	/* A single inline KPI (the red dress result) reuses the same type
	   treatment at a smaller scale — a secondary result, not the section's
	   headline numbers. */
	.amano-kpi--inline {
		margin-top: var(--space-4);
	}

	.amano-kpi--inline .amano-kpi__value {
		font-size: var(--text-h2);
	}

	.amano-outcome-reactions {
		margin-top: var(--space-8);
	}

	/* Pull quotes / emphasized statements — reused for the customer quotes,
	   the core design question, and the "I advocated..." moment, so the
	   page has one quote vocabulary rather than three different ones. */
	.amano-quote {
		margin-top: var(--space-4);
		padding-left: var(--space-3);
		border-left: 2px solid var(--color-border);
	}

	.amano-quote__text {
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.4;
	}

	.amano-quote__attribution {
		margin-top: var(--space-1);
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	/* Compact supporting visual + short notes list, side by side — used
	   for the existing-apparel review and (in its --wide variant) the
	   print/material testing photo. */
	.amano-compact-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-6);
		align-items: start;
	}

	.amano-compact-row--wide {
		grid-template-columns: 1.6fr 1fr;
		align-items: center;
	}

	.amano-compact-row__visual {
		margin: 0;
	}

	.amano-notes__heading {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.amano-notes__list {
		margin: var(--space-2) 0 0;
		padding-left: 1.1em;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		line-height: 1.75;
	}

	.amano-notes__list li + li {
		margin-top: var(--space-1);
	}

	/* The exploration visual is deliberately large — the point is to
	   communicate volume, not to show individual designs in detail. */
	.amano-exploration-visual {
		margin: 0;
	}

	/* Explore → Compare → Eliminate → Refine, and the production flow —
	   one lightweight flow component for both. Plain text + arrows, no
	   boxes or diagram chrome, so it stays editorial rather than reading
	   as a process diagram. */
	.amano-flow {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
		font-weight: 600;
	}

	.amano-flow__arrow {
		color: var(--color-text-muted);
	}

	/* The red-dress sequence: three smaller steps leading into one larger
	   final product, so the final garment visibly receives the most
	   emphasis rather than all four images competing equally. */
	.amano-bet-sequence__row {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-3);
	}

	.amano-bet-sequence__step,
	.amano-bet-sequence__final {
		margin: 0;
	}

	.amano-bet-sequence__step figcaption,
	.amano-bet-sequence__final figcaption {
		margin-top: var(--space-2);
	}

	.amano-bet-sequence__final {
		margin-top: var(--space-6);
		max-width: 28rem;
		margin-inline: auto;
	}

	/* Small closing moment — styling/photo-shoot direction. Deliberately
	   narrower than the rest of the section so it reads as a brief,
	   supporting aside rather than another full section. */
	.amano-supporting {
		margin-top: var(--space-8);
		max-width: 28rem;
	}

	.amano-supporting__heading {
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	.amano-supporting__visual {
		margin-top: var(--space-3);
	}

	/* Learnings — a plain numbered list, not cards: small index, heading,
	   short body, separated by a hairline rather than any container.
	   Deliberately the same vocabulary as freedom-tax-japan.astro's
	   .ftj-learnings section rather than a new pattern. */
	.amano-learnings {
		list-style: none;
		margin: var(--space-8) 0 0;
		padding: 0;
	}

	.amano-learnings li {
		padding: var(--space-6) 0;
		border-top: 1px solid var(--color-border);
	}

	.amano-learnings li:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.amano-learnings__index {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.amano-learnings__heading {
		margin-top: var(--space-2);
		font-size: var(--text-h3);
		font-weight: 700;
		line-height: 1.2;
	}

	.amano-learnings__body {
		margin-top: var(--space-2);
		max-width: var(--measure);
	}

	/* Concluding thought of Learning 03 — part of the same list item as
	   its heading and body (no divider, small gap), set larger and
	   stronger than body text but smaller than the learning heading, in
	   the same column width as the body above it. */
	.amano-learnings__takeaway {
		margin: var(--space-3) 0 0;
		max-width: var(--measure);
		font-size: clamp(1.1875rem, 1.1rem + 0.5vw, 1.5rem);
		font-weight: 600;
		line-height: 1.4;
	}

	/* Footer navigation: Previous / Back to all work (same pattern as
	   freedom-tax-japan.astro's .ftj-pager). */
	.amano-pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
		margin-top: var(--space-16);
		padding: var(--space-6) 0 0;
		border-top: 1px solid var(--color-border);
	}

