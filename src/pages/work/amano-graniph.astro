---
// Yoshitaka Amano × Graniph — Fashion Design case study (Project 04).
// A standalone page (same pattern as freedom-tax-japan.astro), not in
// the `work` content collection, so the hubstep [id].astro template and
// its collections stay untouched. Reuses the shared case-study layout
// classes from global.css (content-grid, case-study-body, case-index,
// case-section, section-eyebrow, .prose) and the same CaseHeader /
// EnlargeableImage / Placeholder components as the other case studies.
//
// No final image assets exist for this project yet — every photographic
// visual below is a <Ph> (Placeholder) labeled with the asset name from
// the content brief (e.g. "amano-collection-hero"), so a real <img> can
// be dropped in later without touching layout or copy. The three visuals
// the brief calls out as HTML/typography rather than images (first-week
// performance, customer reactions, the two process flows) are built as
// real markup, not placeholders.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import Ph from '../../components/Placeholder.astro';

const sections = [
	{ id: 'outcome', title: 'A collection that sold fast — and created genuine excitement' },
	{ id: 'the-challenge', title: "The challenge wasn't reproduction. It was translation." },
	{ id: 'exploration', title: 'I needed to see the ideas before I could judge them.' },
	{ id: 'creative-bet', title: 'Not every commercial decision has to be the safest one.' },
	{ id: 'making-it-physical', title: 'A strong graphic was not enough. It had to survive becoming fabric.' },
	{ id: 'what-i-learned', title: 'Good translation is not literal translation.' },
];

const kpis = [
	{ value: '70%', label: 'of my designs sold through more than 50% of their inventory in the first week' },
	{ value: '96.2%', label: 'first-week sell-through for the best-performing item' },
];

const explorationFlow = ['Explore', 'Compare', 'Eliminate', 'Refine'];
const productionFlow = ['Design', 'Specification', 'Print Test', 'Sample', 'Refinement', 'Production'];
---

<BaseLayout title="Translating Yoshitaka Amano's World into Wearable Products — Yui Taniyama" lang="en">
	<article class="content-grid">
		<!-- VISUAL 00 — amano-collection-hero (large, dominant; no title/meta overlay) -->
		<div class="amano-hero">
			<img
				class="amano-img"
				src="/amano-graniph/hero/amano-collection-hero.png"
				alt="The finished Amano × Graniph collection: garments from the lineup shown on models in a collage"
				width="2400"
				height="1254"
				loading="eager"
				decoding="async"
			/>
		</div>

		<CaseHeader
			eyebrow="Fashion Design · Licensed Collaboration"
			title="Translating Yoshitaka Amano's World into Wearable Products"
			meta={[
				{ label: 'Role', value: 'Fashion Designer' },
				{
					label: 'Scope',
					value: 'Concept Development · Garment Design · Artwork Selection & Adaptation · Material & Print Review · Styling Direction',
				},
				{ label: 'Collaborators', value: 'IP Sales · Graphic Design · Production · Manager' },
				{ label: 'Period', value: 'May 2022 – May 2023' },
			]}
			intro={[
				"I designed a fashion collection that aimed to preserve the delicacy, intensity, and atmosphere of Yoshitaka Amano's artwork while making it work as clothing — across silhouette, material, print, and production.",
			]}
		/>

		<div class="case-study-body">
			<nav class="case-index" aria-label="Case study sections">
				<div class="case-index__eyebrow">In this case study</div>
				<ol>
					{
						sections.map((s) => (
							<li>
								<a href={`#${s.id}`}>{s.title}</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="case-sections">
				<!-- 01 OUTCOME -->
				<section id="outcome" class="case-section">
					<div class="section-eyebrow">After launch</div>
					<h2>A collection that sold fast — and created genuine excitement</h2>

					<div class="prose">
						<p>The collection performed strongly from its first week on sale.</p>
					</div>

					<!-- VISUAL 01 — first-week-performance [HTML typography, not an image] -->
					<div class="amano-kpis">
						{
							kpis.map((kpi) => (
								<div class="amano-kpi">
									<div class="amano-kpi__value">{kpi.value}</div>
									<div class="amano-kpi__label">{kpi.label}</div>
								</div>
							))
						}
					</div>

					<div class="amano-outcome-reactions">
						<div class="section-eyebrow">Customer reactions</div>
						<h3 class="amano-subheading">The numbers were only part of the story.</h3>

						<!-- VISUAL 02 — customer-reactions [HTML quote treatment, not an image] -->
						<div class="amano-quote amano-quote--customer">
							<p class="amano-quote__text">"I want everything from this collaboration…"</p>
							<p class="amano-quote__attribution">Customer post on X · translated from Japanese</p>
						</div>
						<div class="amano-quote amano-quote--customer">
							<p class="amano-quote__text">"If I saw this walking past the store, there's no way I wouldn't buy it."</p>
							<p class="amano-quote__attribution">Customer post on X · translated from Japanese</p>
						</div>

						<div class="prose">
							<p>
								The response suggested that the collection was doing more than translating a well-known IP into
								clothing — <strong>the products themselves were creating enough visual and emotional pull to drive
								both purchase and conversation.</strong>
							</p>
						</div>
					</div>
				</section>

				<!-- 02 THE CHALLENGE -->
				<section id="the-challenge" class="case-section">
					<div class="section-eyebrow">Preserving the feeling, not just the image</div>
					<h2>The challenge wasn't reproduction. It was translation.</h2>

					<div class="prose">
						<p>
							Yoshitaka Amano's work can feel incredibly delicate — almost fragile — while still carrying{' '}
							<strong>a distinct sense of tension, darkness, and strength.</strong>
						</p>
						<p>
							When I reviewed existing apparel using his artwork, I often felt that this balance was being lost.
							Heavy-looking prints, glossy finishes, or coarse fabrics could reproduce the image while changing the
							feeling of the original work.
						</p>
					</div>

					<div class="amano-quote">
						<p class="amano-quote__text">
							How could the clothes preserve the feeling of entering Amano's world, rather than simply placing his
							artwork onto a garment?
						</p>
					</div>

					<!-- VISUAL 03 — existing-apparel-review (kept compact — supporting evidence, not the focus) -->
					<div class="amano-compact-row">
						<figure class="amano-compact-row__visual">
							<img
								class="amano-img"
								src="/amano-graniph/challenge/existing-apparel-review.png"
								alt="Review of existing apparel that uses Yoshitaka Amano's artwork"
								width="2400"
								height="2093"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<div class="amano-notes amano-notes--dark">
							<div class="amano-notes__heading">What I noticed</div>
							<ul class="amano-notes__list">
								<li>Materials sometimes fought against the delicacy of the artwork</li>
								<li>Some print finishes changed the character of the original image</li>
								<li>Reproducing the artwork alone did not necessarily preserve its atmosphere</li>
							</ul>
						</div>
					</div>
				</section>

				<!-- 03 EXPLORATION -->
				<section id="exploration" class="case-section">
					<div class="section-eyebrow">From artwork to garment</div>
					<h2>I needed to see the ideas before I could judge them.</h2>

					<div class="prose">
						<p>
							One thing I had learned through fashion design was that an idea that sounds right in conversation does
							not always work once it becomes visual.
						</p>
						<p>
							Sometimes an artwork that seemed like an obvious choice fell flat when placed on a garment. At other
							times, <strong>an unexpected combination immediately felt right.</strong>
						</p>
						<p>
							So I explored broadly before narrowing the collection — testing different relationships between
							artwork, silhouette, placement, material, and print.
						</p>
						<p>
							For this collection, I was also thinking about two overlapping audiences: people drawn through familiar
							fantasy imagery, and people who were deeply interested in Amano's artwork itself.
						</p>
						<p>
							The aim was not to design separately for each group, but to{' '}
							<strong>build a lineup that could satisfy both.</strong>
						</p>
					</div>

					<!-- VISUAL 04 — collection-exploration (large — communicates the volume of work explored) -->
					<figure class="amano-exploration-visual">
						<img
							class="amano-img"
							src="/amano-graniph/exploration/collection-exploration.png"
							alt="A large sheet of garment design explorations: T-shirts, shirts, dresses, and skirts"
							width="1800"
							height="2591"
							loading="lazy"
							decoding="async"
						/>
					</figure>

					<div class="amano-flow">
						{
							explorationFlow.map((step, i) => (
								<Fragment>
									<span class="amano-flow__step">{step}</span>
									{i < explorationFlow.length - 1 && (
										<span class="amano-flow__arrow" aria-hidden="true">
											→
										</span>
									)}
								</Fragment>
							))
						}
					</div>
				</section>

				<!-- 04 A CREATIVE BET -->
				<section id="creative-bet" class="case-section">
					<div class="section-eyebrow">Design decision</div>
					<h2>Not every commercial decision has to be the safest one.</h2>

					<div class="prose">
						<p>One of the more debated pieces in the lineup was a vivid red sleeveless dress.</p>
						<p>
							Bright red and the silhouette were considered a more challenging choice for the expected customer, but{' '}
							<strong>I felt the combination of the artwork, color, and composition created something unusually
							strong.</strong>
						</p>
						<p>
							Rather than using the original artwork literally, I extended its visual world through color and
							composition to create a garment with its own presence.
						</p>
					</div>

					<div class="amano-quote">
						<p class="amano-quote__text">I advocated for keeping it in the lineup.</p>
					</div>

					<div class="prose">
						<p>The dress went on to sell through 54.2% of its inventory in the first week.</p>
						<p>
							The result reinforced something I already suspected:{' '}
							<strong>commercial thinking and creative instinct do not always have to pull in opposite
							directions.</strong>
						</p>
					</div>

					<!-- VISUAL 05 — red-dress-design-decision (strongest visual after the Hero) -->
					<!-- The three steps share one set of equal-size frames (so they read as
					     a matched sequence), and the whole visual can be enlarged as a unit —
					     the enlarged view is a clone of [data-zoom-content], see the script. -->
					<div class="amano-zoomable" data-zoom-trigger>
						<button type="button" class="amano-zoomable__btn" aria-label="Enlarge this visual">
							<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M6 2H2v4M10 2h4v4M6 14H2v-4M10 14h4v-4" />
							</svg>
						</button>
						<div class="amano-bet-sequence" data-zoom-content>
							<div class="amano-bet-sequence__media amano-bet-sequence__c1">
								<Ph label="red-dress-design-decision — Original artwork" ratio="3 / 4" />
							</div>
							<div class="amano-bet-sequence__caption amano-bet-sequence__c1">
								<div class="section-eyebrow">Original artwork</div>
							</div>

							<span class="amano-bet-sequence__arrow" aria-hidden="true">→</span>

							<div class="amano-bet-sequence__media amano-bet-sequence__c3">
								<img
									class="amano-bet-sequence__img amano-bet-sequence__img--contain"
									src="/amano-graniph/creative-bet/red-dress-2-artwork-adaptation.png"
									alt="The red dress design with the adapted artwork placed on the hem, front and back"
									width="1000"
									height="858"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="amano-bet-sequence__caption amano-bet-sequence__c3">
								<div class="section-eyebrow">Artwork adaptation</div>
							</div>

							<span class="amano-bet-sequence__arrow" aria-hidden="true">→</span>

							<div class="amano-bet-sequence__media amano-bet-sequence__c5">
								<img
									class="amano-bet-sequence__img"
									src="/amano-graniph/creative-bet/red-dress-3-final-product.png"
									alt="The finished red sleeveless dress worn by a model"
									width="610"
									height="855"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="amano-bet-sequence__caption amano-bet-sequence__c5">
								<div class="section-eyebrow">Final product</div>
								<p class="amano-bet-sequence__metric">
									<strong>54.2%</strong> first-week sell-through
								</p>
							</div>
						</div>
					</div>

					<dialog class="amano-zoom-dialog" aria-label="Enlarged view">
						<button type="button" class="amano-zoom-dialog__close" aria-label="Close enlarged view">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M6 6l12 12M18 6L6 18" />
							</svg>
						</button>
						<div class="amano-zoom-dialog__body"></div>
					</dialog>
				</section>

				<!-- 05 MAKING IT PHYSICAL -->
				<section id="making-it-physical" class="case-section">
					<div class="section-eyebrow">From visual idea to product</div>
					<h2>A strong graphic was not enough. It had to survive becoming fabric.</h2>

					<div class="prose">
						<p>Once the lineup was selected, the concepts had to become manufacturable products.</p>
						<p>
							The process moved from design specifications into material selection, print methods, sampling, and
							refinement.
						</p>
						<p>
							For printed pieces, the factory typically prepared multiple test versions. I compared them against the
							original artwork, looking at color reproduction, fine detail, print quality, and how the result
							behaved on the chosen fabric.
						</p>
						<p>The goal was not simply to find the most accurate print.</p>
						<p>
							It was to find the combination of <strong>artwork × material × print technique</strong> that preserved
							the character of the original work as closely as possible.
						</p>
					</div>

					<!-- VISUAL 06 — design-to-production-flow [HTML flow, not an image] -->
					<div class="amano-diagram">
						<ol class="amano-diagram__list" aria-label="From design to production">
							{
								productionFlow.map((step, i) => (
									<li
										class:list={[
											'amano-diagram__node',
											(i === 0 || i === productionFlow.length - 1) && 'amano-diagram__node--terminal',
										]}
									>
										{step}
									</li>
								))
							}
						</ol>
					</div>

					<!-- VISUAL 07 — print-material-testing (main visual in this section) -->
					<div class="amano-compact-row amano-compact-row--wide">
						<figure class="amano-compact-row__visual">
							<img
								class="amano-img"
								src="/amano-graniph/making-it-physical/print-material-testing.png"
								alt="Blue printed fabric test samples of Amano's artwork, pinned up for comparison"
								width="1160"
								height="1523"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<div class="amano-notes">
							<div class="amano-notes__heading">What I checked</div>
							<ul class="amano-notes__list">
								<li>Color reproduction</li>
								<li>Fine artwork detail</li>
								<li>Print quality</li>
								<li>Material compatibility</li>
							</ul>
						</div>
					</div>

					<!-- Small supporting moment, not a major section -->
					<div class="amano-supporting">
						<h3 class="amano-supporting__heading">Extending the direction beyond the garment</h3>
						<div class="prose amano-supporting__text">
							<p>
								I also shared styling and model direction with the photography team — including the overall mood,
								coordination, and accessory references — to help the final imagery stay consistent with the
								collection.
							</p>
						</div>
						<div class="amano-supporting__visual">
							<img
								class="amano-img"
								src="/amano-graniph/making-it-physical/styling-direction.png"
								alt="Styling and model direction reference shared with the photography team"
								width="2400"
								height="2523"
								loading="lazy"
								decoding="async"
							/>
						</div>
					</div>
				</section>

				<!-- 06 WHAT I LEARNED -->
				<section id="what-i-learned" class="case-section">
					<div class="section-eyebrow">What stayed with me</div>
					<h2>Good translation is not literal translation.</h2>

					<div class="prose">
						<p>
							After launch, I reviewed sales performance, visited stores, and spoke with sales staff to understand how
							customers were actually responding.
						</p>
						<p>
							Comparing those observations with our expectations helped me see which assumptions held up — and which
							did not.
						</p>
					</div>

					<ol class="amano-learnings">
						<li>
							<div class="amano-learnings__index">01</div>
							<h3 class="amano-learnings__heading">Design the whole product, not just the artwork.</h3>
							<div class="prose amano-learnings__body">
								<p>
									The strongest products were not simply the ones that reproduced Amano's artwork most faithfully.
								</p>
								<p>
									They were the ones where the <strong>artwork, material, silhouette, and print technique</strong> worked
									together as one product.
								</p>
							</div>
						</li>
						<li>
							<div class="amano-learnings__index">02</div>
							<h3 class="amano-learnings__heading">Creative instinct and commercial thinking can coexist.</h3>
							<div class="prose amano-learnings__body">
								<p>
									The red dress was a risk from a conventional merchandising perspective, but I believed the artwork
									and color could create a stronger emotional connection.
								</p>
								<p>
									Its performance reinforced{' '}
									<strong>the value of making informed creative bets rather than optimizing every decision for
									familiarity.</strong>
								</p>
							</div>
						</li>
						<li>
							<div class="amano-learnings__index">03</div>
							<h3 class="amano-learnings__heading">Make ideas tangible before trusting your assumptions.</h3>
							<div class="prose amano-learnings__body">
								<p>This project reinforced a habit that still influences how I design today:</p>
							</div>
							<p class="amano-learnings__takeaway">
								Ideas need to become tangible before they can really be judged. Making them visible, comparing
								alternatives, and observing what happens in the real world helps me challenge my own assumptions.
							</p>
						</li>
					</ol>
				</section>
			</div>
		</div>

		<nav class="amano-pager" aria-label="Case study navigation">
			<a href="/work/freedom-tax-japan/">
				<span class="amano-pager__label">Previous case study</span>
				<span class="amano-pager__title">Bringing Research and Testing to Freedom Tax Japan's Redesign</span>
			</a>
			<a href="/" class="amano-pager__next">
				<span class="amano-pager__label">Back to</span>
				<span class="amano-pager__title">All work →</span>
			</a>
		</nav>
	</article>
</BaseLayout>

<style>
	/* This case study's own accent for the active Section Index item —
	   kept local to the page, same approach as FTJ's blue and hubstep's
	   teal (--color-accent). */
	.case-index a.is-active {
		color: #d43a3d;
	}

	/* Vertical rhythm inside a section: heading, then blocks spaced evenly
	   (same two rules as freedom-tax-japan.astro — each standalone case
	   study page defines its own copy of this rather than it living in
	   global.css, since it's specific to how .case-section is used here). */
	.case-section > :global(* + *) {
		margin-top: var(--space-4);
	}

	.case-section > h2 + :global(*) {
		margin-top: var(--space-4);
	}

	/* Hero — large and dominant, full content-grid width (not capped like
	   FTJ's narrower hero), with nothing overlaid on top of it. */
	.amano-hero {
		margin-top: var(--space-6);
		margin-bottom: var(--space-6);
	}

	/* Real photos/screens render at their own aspect ratio — no crop,
	   no border, no zoom affordance. */
	.amano-img {
		display: block;
		width: 100%;
		height: auto;
	}

	.amano-subheading {
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	/* KPI statements — editorial, not dashboard cards: no borders, no
	   background, just scale and whitespace. Side by side on desktop,
	   stacked on mobile. */
	.amano-kpis {
		display: flex;
		gap: var(--space-8);
		flex-wrap: wrap;
	}

	.amano-kpi {
		flex: 1 1 14rem;
	}

	.amano-kpi__value {
		font-size: clamp(3rem, 2.2rem + 3.5vw, 4.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.amano-kpi__label {
		margin-top: var(--space-2);
		max-width: 28rem;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		line-height: 1.6;
	}

	.amano-outcome-reactions {
		margin-top: var(--space-8);
	}

	/* Pull quotes / emphasized statements — reused for the customer quotes,
	   the core design question, and the "I advocated..." moment, so the
	   page has one quote vocabulary rather than three different ones. */
	.amano-quote {
		margin-top: var(--space-4);
		padding-left: var(--space-3);
		border-left: 2px solid var(--color-border);
	}

	.amano-quote__text {
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.4;
	}

	/* Customer voices pick up the case study's accent red (same color as
	   the active Section Index item). */
	.amano-quote--customer .amano-quote__text {
		color: #d43a3d;
	}

	.amano-quote__attribution {
		margin-top: var(--space-1);
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	/* Compact supporting visual + short notes list, side by side — used
	   for the existing-apparel review and (in its --wide variant) the
	   print/material testing photo. */
	.amano-compact-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-6);
		align-items: start;
	}

	.amano-compact-row--wide {
		grid-template-columns: 1.6fr 1fr;
		align-items: center;
	}

	.amano-compact-row__visual {
		margin: 0;
	}

	.amano-notes__heading {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.amano-notes__list {
		margin: var(--space-2) 0 0;
		padding-left: 1.1em;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		line-height: 1.75;
	}

	.amano-notes--dark .amano-notes__list {
		color: var(--color-text);
	}

	.amano-notes__list li + li {
		margin-top: var(--space-1);
	}

	/* The exploration visual is deliberately large — the point is to
	   communicate volume, not to show individual designs in detail. */
	.amano-exploration-visual {
		margin: 0;
		/* The sheet is a tall portrait; at full column width it would run
		   well over a screen and a half, so cap it. */
		max-width: 44rem;
	}

	/* Explore → Compare → Eliminate → Refine, and the production flow —
	   one lightweight flow component for both. Plain text + arrows, no
	   boxes or diagram chrome, so it stays editorial rather than reading
	   as a process diagram. */
	.amano-flow {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
		font-weight: 600;
	}

	.amano-flow__arrow {
		color: var(--color-text-muted);
	}

	/* The red-dress sequence: original artwork → adaptation → final
	   product in one horizontal row. Row 1 holds equal-size frames (3:4)
	   with the arrows centered on them; row 2 holds the captions, so the
	   arrows line up with the images rather than with the captions. The
	   sell-through result sits under the final product as a small
	   supporting metric, not its own block. */
	.amano-bet-sequence {
		display: grid;
		grid-template-columns: 1fr auto 1fr auto 1fr;
		column-gap: var(--space-2);
		row-gap: var(--space-2);
		align-items: start;
	}

	.amano-bet-sequence__media {
		grid-row: 1;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #f2f2f2;
	}

	.amano-bet-sequence__caption {
		grid-row: 2;
	}

	.amano-bet-sequence__caption .section-eyebrow {
		margin-bottom: 0;
	}

	.amano-bet-sequence__c1 {
		grid-column: 1;
	}

	.amano-bet-sequence__c3 {
		grid-column: 3;
	}

	.amano-bet-sequence__c5 {
		grid-column: 5;
	}

	.amano-bet-sequence__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* The adaptation is a flat drawing (front + back) on white; show all
	   of it inside the shared frame instead of cropping it. */
	.amano-bet-sequence__img--contain {
		object-fit: contain;
		background: #ffffff;
	}

	.amano-bet-sequence__arrow {
		grid-row: 1;
		align-self: center;
		color: var(--color-text-muted);
	}

	.amano-bet-sequence__arrow:nth-of-type(1) {
		grid-column: 2;
	}

	.amano-bet-sequence__arrow:nth-of-type(2) {
		grid-column: 4;
	}

	.amano-bet-sequence__metric {
		margin-top: var(--space-1);
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	.amano-bet-sequence__metric strong {
		font-size: var(--text-body);
		font-weight: 700;
		color: var(--color-text);
	}

	/* Small closing moment — styling/photo-shoot direction. Heading on
	   top, then copy and image side by side across the full column, so
	   there's no empty space beside a narrow stack. Kept modest in
	   scale (a supporting aside, not another section). */
	.amano-supporting {
		margin-top: var(--space-8);
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: var(--space-6);
		row-gap: var(--space-3);
		align-items: start;
	}

	.amano-supporting__heading {
		grid-column: 1 / -1;
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	.amano-supporting__text {
		grid-column: 1;
	}

	.amano-supporting__visual {
		grid-column: 2;
	}

	/* Production flow as a simple diagram: boxes joined by arrows, rounded
	   ends for the start and finish. Built in HTML/CSS (not an image) so
	   it stays sharp, wraps responsively, and is editable as text. On a
	   narrow column it turns vertical. */
	.amano-diagram {
		container-type: inline-size;
	}

	.amano-diagram__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: stretch;
		gap: 1.5rem;
	}

	.amano-diagram__node {
		position: relative;
		flex: 1 1 0;
		min-width: 0;
		min-height: 3.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-1);
		border: 1px solid var(--color-text);
		background: #ffffff;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.3;
		text-align: center;
	}

	.amano-diagram__node--terminal {
		border-radius: 999px;
	}

	/* Connector: ::after is the line across the gap, ::before the arrowhead. */
	.amano-diagram__node:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 100%;
		width: 1.5rem;
		height: 1px;
		background: var(--color-text);
	}

	.amano-diagram__node:not(:last-child)::before {
		content: '';
		position: absolute;
		top: 50%;
		left: calc(100% + 1.5rem - 7px);
		width: 6px;
		height: 6px;
		border-top: 1px solid var(--color-text);
		border-right: 1px solid var(--color-text);
		transform: translateY(-50%) rotate(45deg);
	}

	@container (max-width: 46rem) {
		.amano-diagram__list {
			flex-direction: column;
			align-items: flex-start;
		}

		.amano-diagram__node {
			flex: none;
			width: min(100%, 16rem);
		}

		.amano-diagram__node:not(:last-child)::after {
			top: 100%;
			left: 50%;
			width: 1px;
			height: 1.5rem;
		}

		.amano-diagram__node:not(:last-child)::before {
			top: calc(100% + 1.5rem - 7px);
			left: calc(50% - 3px);
			transform: rotate(135deg);
		}
	}

	/* Enlarge-as-a-unit for the red-dress sequence. The visual itself
	   stays a plain grid; this adds a click target + icon, and a dialog
	   that shows a larger copy of the whole sequence. Desktop/tablet only
	   — on a phone the steps already stack at full width. */
	.amano-zoomable {
		position: relative;
		cursor: zoom-in;
	}

	.amano-zoomable__btn {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 2;
		width: 28px;
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: none;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.85);
		color: var(--color-text);
		opacity: 0.75;
		cursor: zoom-in;
		transition: opacity 150ms ease;
	}

	.amano-zoomable__btn svg {
		width: 16px;
		height: 16px;
	}

	.amano-zoomable:hover .amano-zoomable__btn,
	.amano-zoomable__btn:focus-visible {
		opacity: 1;
	}

	.amano-zoom-dialog {
		width: min(94vw, 88rem);
		max-height: 92vh;
		margin: auto;
		padding: var(--space-8) var(--space-6) var(--space-6);
		border: none;
		background: #ffffff;
		color: var(--color-text);
		overflow: auto;
	}

	.amano-zoom-dialog::backdrop {
		background: rgba(17, 17, 17, 0.85);
	}

	.amano-zoom-dialog__close {
		position: absolute;
		top: var(--space-2);
		right: var(--space-2);
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: none;
		border-radius: 4px;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	.amano-zoom-dialog__close svg {
		width: 20px;
		height: 20px;
	}

	.amano-zoom-dialog__close:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	/* Learnings — a plain numbered list, not cards: small index, heading,
	   short body, separated by a hairline rather than any container.
	   Deliberately the same vocabulary as freedom-tax-japan.astro's
	   .ftj-learnings section rather than a new pattern. */
	.amano-learnings {
		list-style: none;
		margin: var(--space-8) 0 0;
		padding: 0;
	}

	.amano-learnings li {
		padding: var(--space-6) 0;
		border-top: 1px solid var(--color-border);
	}

	.amano-learnings li:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.amano-learnings__index {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.amano-learnings__heading {
		margin-top: var(--space-2);
		font-size: var(--text-h3);
		font-weight: 700;
		line-height: 1.2;
	}

	.amano-learnings__body {
		margin-top: var(--space-2);
		max-width: var(--measure);
	}

	/* Concluding thought of Learning 03 — part of the same list item as
	   its heading and body (no divider, small gap), set larger and
	   stronger than body text but smaller than the learning heading, in
	   the same column width as the body above it. */
	.amano-learnings__takeaway {
		margin: var(--space-3) 0 0;
		max-width: var(--measure);
		font-size: clamp(1.1875rem, 1.1rem + 0.5vw, 1.5rem);
		font-weight: 600;
		line-height: 1.4;
	}

	/* Footer navigation: Previous / Back to all work (same pattern as
	   freedom-tax-japan.astro's .ftj-pager). */
	.amano-pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
		margin-top: var(--space-16);
		padding: var(--space-6) 0 0;
		border-top: 1px solid var(--color-border);
	}

	.amano-pager a {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		text-decoration: none;
		transition: opacity 150ms ease;
	}

	.amano-pager a:hover,
	.amano-pager a:focus-visible {
		opacity: 0.7;
	}

	.amano-pager__next {
		text-align: right;
		align-items: flex-end;
	}

	.amano-pager__label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.amano-pager__title {
		font-size: var(--text-h3);
		font-weight: 700;
		line-height: 1.2;
	}

	@media (max-width: 640px) {
		.amano-compact-row,
		.amano-compact-row--wide,
		.amano-pager {
			grid-template-columns: 1fr;
		}

		/* Three narrow columns would be too small to read on a phone —
		   stack the steps (frame, then caption, then a down arrow), with
		   explicit desktop placement reset to normal flow. */
		.amano-bet-sequence {
			grid-template-columns: 1fr;
		}

		.amano-bet-sequence__media,
		.amano-bet-sequence__caption,
		.amano-bet-sequence__arrow,
		.amano-bet-sequence__arrow:nth-of-type(1),
		.amano-bet-sequence__arrow:nth-of-type(2),
		.amano-bet-sequence__c1,
		.amano-bet-sequence__c3,
		.amano-bet-sequence__c5 {
			grid-column: 1;
			grid-row: auto;
		}

		.amano-bet-sequence__arrow {
			transform: rotate(90deg);
			justify-self: start;
			margin-block: var(--space-1);
		}

		.amano-supporting {
			grid-template-columns: 1fr;
		}

		.amano-supporting__text,
		.amano-supporting__visual {
			grid-column: 1;
		}

		.amano-zoomable {
			cursor: default;
		}

		.amano-zoomable__btn {
			display: none;
		}

		.amano-pager__next {
			text-align: left;
			align-items: flex-start;
		}
	}
</style>

<script>
	// Enlarge the red-dress sequence as one unit: show a copy of the whole
	// visual in a modal <dialog> (native Esc + focus handling). Skipped on
	// phones, where the steps already stack at full width.
	const zoomTrigger = document.querySelector<HTMLElement>('[data-zoom-trigger]');
	const zoomContent = document.querySelector<HTMLElement>('[data-zoom-content]');
	const zoomDialog = document.querySelector<HTMLDialogElement>('.amano-zoom-dialog');
	if (zoomTrigger && zoomContent && zoomDialog) {
		const body = zoomDialog.querySelector<HTMLElement>('.amano-zoom-dialog__body')!;
		const isPhone = () => window.matchMedia('(max-width: 640px)').matches;

		zoomTrigger.addEventListener('click', () => {
			if (isPhone()) return;
			const copy = zoomContent.cloneNode(true) as HTMLElement;
			copy.removeAttribute('data-zoom-content');
			copy.querySelectorAll('img').forEach((img) => img.setAttribute('loading', 'eager'));
			body.replaceChildren(copy);
			zoomDialog.showModal();
		});

		// Close from the X button or by clicking the dark backdrop.
		zoomDialog.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target === zoomDialog || target.closest('.amano-zoom-dialog__close')) zoomDialog.close();
		});
	}

	// Section Index scrollspy — identical behavior to the other case
	// study pages (see freedom-tax-japan.astro / [id].astro).
	const sections = document.querySelectorAll<HTMLElement>('.case-sections .case-section[id]');
	const links = document.querySelectorAll<HTMLAnchorElement>('.case-index a[href^="#"]');
	if (sections.length && links.length) {
		const setActive = (id: string) => {
			links.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === `#${id}`));
		};
		const headerH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 0;
		let observer: IntersectionObserver | undefined;
		const visible = new Set<string>();

		const build = () => {
			observer?.disconnect();
			visible.clear();
			observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
					let current: string | undefined;
					let bestTop = Infinity;
					visible.forEach((id) => {
						const top = document.getElementById(id)!.getBoundingClientRect().top;
						if (top < bestTop) {
							bestTop = top;
							current = id;
						}
					});
					if (current) setActive(current);
				},
				{ rootMargin: `-${headerH() + 8}px 0px -70% 0px`, threshold: 0 }
			);
			sections.forEach((s) => observer!.observe(s));
		};

		build();
		window.addEventListener('resize', build);
	}
</script>
