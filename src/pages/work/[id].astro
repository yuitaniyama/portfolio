// Sections that render a custom visual in place of a plain placeholder.
// Keyed by full section id. The component always replaces only the
// FIRST entry in that section's `visuals` list — any additional
// entries still render as plain placeholders below it.
// (Applies to "flat" sections only — see workSections below.)
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const SECTION_DIAGRAMS: Record<string, any> = {};

// Small eyebrow label shown above a section's <h2>, keyed by the
// section's exact title (stable across which content system — flat or
// block — a given section happens to use). Text stays normal-case here;
// `.section-eyebrow`'s CSS applies the visual uppercase transform, same
// as the original Impact-only eyebrow this generalizes.
const SECTION_EYEBROWS: Record<string, string> = {
	'From a DM Tool to a Sales Platform': 'Context',
	'Making an Ambiguous Product Tangible': 'Process',
	'Shipping Exposed the Real UX Problems': 'After launch',
	'Redefining Home & Sales Report': 'Core UX challenge',
	'Rethinking List Upload': 'Workflow improvement',
	'Evolving the Product Across the Sales Workflow': 'Product evolution',
	'Future Exploration — AI-assisted Sales Workflow': 'Future exploration',
	'What I Learned Designing an Evolving Product': 'Learnings',
	Impact: 'Impact',
	Background: 'Background',
	'Joining an Existing Product': 'Context',
	'From Initial Design to Real-World Requirements': 'Real-world feedback',
	'Redesigning the Address-Label Confirmation Flow': 'Selected design work',
	'Redesigning the List Upload Flow': 'Selected design work',
	'Extending the Design System': 'Design System',
	'Communicating the Product': 'Product Communication',
	'Product Expansion & Adoption': 'Expansion & Adoption',
	'What I Learned': 'Learnings',
};

// Visual placement is editorial, not automatic: a "block" section is
// split into an ordered sequence of prose chunks and explicit visual
// markers (see src/content.config.ts) so a visual can sit at a
// specific point in the narrative instead of always right after the
// heading. This map resolves a block's `ref` to a component, keyed by
// "<section folder id>/<ref>".
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const BLOCK_VISUALS: Record<string, any> = {
	'hubstep-sfa-platform/sections/01-product-transformation/before': BeforeDiagram,
	'hubstep-sfa-platform/sections/01-product-transformation/after': AfterDiagram,
