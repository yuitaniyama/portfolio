export async function getStaticPaths() {
	const projects = await getCollection('work', ({ data }) => !data.draft);
	const allSections = await getCollection('workSections');
	const allSectionMeta = await getCollection('workSectionMeta');
	const allBlocks = await getCollection('workBlocks');

	return projects.map((project) => {
		const slug = project.id.replace(/\/_meta$/, '');
		const sections = allSections
			.filter((s) => s.id.startsWith(`${slug}/sections/`))
			.sort((a, b) => a.id.localeCompare(b.id));
		const sectionMeta = allSectionMeta
			.filter((s) => s.id.startsWith(`${slug}/sections/`))
			.sort((a, b) => a.id.localeCompare(b.id));
		const blocks = allBlocks.filter((b) => b.id.startsWith(`${slug}/sections/`));
		return {
			params: { id: slug },
			props: { project, sections, sectionMeta, blocks },
		};
	});
}

const { project, sections, sectionMeta, blocks } = Astro.props;
const { data } = project;
const slug = project.id.replace(/\/_meta$/, '');
const introParagraphs = data.intro.trim().split(/\n\s*\n/);

const sortKey = (id: string) => id.split('/sections/')[1];
const slugify = (title: string) =>
	title
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');

// Every section — "flat" (one flowing body) or "block" (an ordered,
// explicitly-placed sequence) — is normalized to the same shape here:
// { sortKey, title, priority, blocks }. The template below then has a
// single rendering path, regardless of which kind a section is.
const flatSections = await Promise.all(
	sections.map(async (section) => {
		const { Content } = await render(section);
		const Diagram = SECTION_DIAGRAMS[section.id] ?? null;
		const remainingVisuals = Diagram ? (section.data.visuals ?? []).slice(1) : (section.data.visuals ?? []);

		const sectionBlocks = [];
		if (Diagram) sectionBlocks.push({ type: 'visual', Component: Diagram });
		if (remainingVisuals.length > 0) sectionBlocks.push({ type: 'placeholder-list', items: remainingVisuals });
		sectionBlocks.push({ type: 'prose', Content });
		if (section.data.cards && section.data.cards.length > 0) {
			sectionBlocks.push({ type: 'cards', cards: section.data.cards });
		}

		return {
			sortKey: sortKey(section.id),
			title: section.data.title,
			priority: section.data.priority,
			blocks: sectionBlocks,
		};
	})
);

const blockSections = await Promise.all(
	sectionMeta.map(async (meta) => {
		const folderId = meta.id.replace(/\/_meta$/, '');
		const ownBlocks = blocks
			.filter((b) => b.id.startsWith(`${folderId}/blocks/`))
			.sort((a, b) => a.id.localeCompare(b.id));

		const sectionBlocks = await Promise.all(
			ownBlocks.map(async (block) => {
				if (block.data.type === 'visual') {
					const Component = BLOCK_VISUALS[`${folderId}/${block.data.ref}`] ?? null;
					return { type: 'visual', Component };
				}
				if (block.data.type === 'placeholder-list') {
					return { type: 'placeholder-list', items: block.data.items ?? [] };
				}
				const { Content } = await render(block);
				return { type: 'prose', Content };
			})
		);

		return {
			sortKey: sortKey(folderId),
			title: meta.data.title,
			priority: meta.data.priority,
			blocks: sectionBlocks,
		};
	})
);

const renderedSections = [...flatSections, ...blockSections]
	.sort((a, b) => a.sortKey.localeCompare(b.sortKey))
	.map((section) => ({ ...section, slug: slugify(section.title) }));
---

<BaseLayout
	title={`${data.title} — Yui Taniyama`}
	lang="en"
	translationHref={slug === 'hubstep-sfa-platform' ? '/ja/work/hubstep-sfa-platform/' : undefined}
>
	<article class="content-grid">
		{
			slug === 'hubstep-sfa-platform' ? (
				<HubstepHero />
			) : slug === 'hubstep-foundation' ? (
				<FoundationHero />
			) : (
				<div class="case-hero">
					{data.heroVisual && <p class="visual-placeholder__label">{data.heroVisual}</p>}
				</div>
			)
		}

		<CaseHeader eyebrow={data.eyebrow} title={data.title} meta={data.meta} intro={introParagraphs} challenges={data.challenges} />

		<div class="case-study-body">
			<nav class="case-index" aria-label="Case study sections">
				<div class="case-index__eyebrow">In this case study</div>
				<ol>
					{
						renderedSections.map((section) => (
							<li>
								<a href={`#${section.slug}`}>{section.title}</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="case-sections">
				{
					renderedSections.map((section) => (
						<section id={section.slug} class:list={['case-section', `case-section--${section.priority}`]}>
							{SECTION_EYEBROWS[section.title] && (
								<div class="section-eyebrow">{SECTION_EYEBROWS[section.title]}</div>
							)}
							<h2>{section.title}</h2>

							{section.blocks.map(({ type, Content, Component, items, cards }) => (
								type === 'visual' ? (
									Component && (
										<div class="case-visuals case-visuals--diagram">
											<Component />
										</div>
									)
								) : type === 'placeholder-list' ? (
									items && items.length > 0 && (
										<div class="case-visuals">
											{items.map((v) => (
												<div class="visual-placeholder">{v}</div>
											))}
										</div>
									)
								) : type === 'cards' ? (
									cards && cards.length > 0 && (
										<div class="case-cards">
											{cards.map((card) => (
												<div class="case-card">
													<div class="case-card__title">{card.title}</div>
													<p class="case-card__body">{card.body}</p>
													{card.visual && (
														<div class="visual-placeholder visual-placeholder--card">{card.visual}</div>
													)}
												</div>
											))}
										</div>
									)
								) : (
									Content && (
										<div class="prose">
											<Content />
										</div>
									)
								)
							))}
						</section>
					))
				}
			</div>
		</div>

		<NextCaseStudy currentSlug={slug} />
	</article>
</BaseLayout>

<script>
	// Section Index scrollspy: highlights whichever `.case-section` is
	// currently "current" as the reader scrolls, using the same
	// header-height custom property BaseLayout's script keeps up to
	// date, so the active section stays accurate under the sticky
	// header rather than switching a beat early or late.
	const sections = document.querySelectorAll<HTMLElement>('.case-sections .case-section[id]');
	const links = document.querySelectorAll<HTMLAnchorElement>('.case-index a[href^="#"]');
	if (sections.length && links.length) {
		const linkFor = (id: string) => document.querySelector<HTMLAnchorElement>(`.case-index a[href="#${id}"]`);

		const setActive = (id: string) => {
			links.forEach((a) => a.classList.toggle('is-active', a === linkFor(id)));
		};

		const headerH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 0;

		let observer: IntersectionObserver | undefined;
		const observedIds = new Set<string>();

		const build = () => {
			observer?.disconnect();
			observedIds.clear();

			observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) observedIds.add(entry.target.id);
						else observedIds.delete(entry.target.id);
					});

					// Several sections can be "intersecting" the band at once
					// (a short section, or fast scrolling) — the one closest
					// to the top of that band reads as current.
					let current: string | undefined;
					let bestTop = Infinity;
					observedIds.forEach((id) => {
						const el = document.getElementById(id);
						if (!el) return;
						const top = el.getBoundingClientRect().top;
						if (top < bestTop) {
							bestTop = top;
							current = id;
						}
					});

					if (current) setActive(current);
				},
				{ rootMargin: `-${headerH() + 8}px 0px -70% 0px`, threshold: 0 }
			);

			sections.forEach((s) => observer!.observe(s));
		};

		build();
		// The header's real height can change (resize, font load) after
		// the observer's rootMargin was computed — rebuilding on resize
		// keeps the active-section band aligned with the actual header.
		window.addEventListener('resize', build);
	}
</script>
