<script>
	// Section Index scrollspy (same behavior as the shared case-study
	// template): the section nearest the top of the reading band is "current".
	const sections = document.querySelectorAll<HTMLElement>('.case-sections .case-section[id]');
	const links = document.querySelectorAll<HTMLAnchorElement>('.case-index a[href^="#"]');
	if (sections.length && links.length) {
		const setActive = (id: string) => {
			links.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === `#${id}`));
		};
		const headerH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 0;
		let observer: IntersectionObserver | undefined;
		const visible = new Set<string>();

		const build = () => {
			observer?.disconnect();
			visible.clear();
			observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
					let current: string | undefined;
					let bestTop = Infinity;
					visible.forEach((id) => {
						const top = document.getElementById(id)!.getBoundingClientRect().top;
						if (top < bestTop) {
							bestTop = top;
							current = id;
						}
					});
					if (current) setActive(current);
				},
				{ rootMargin: `-${headerH() + 8}px 0px -70% 0px`, threshold: 0 }
			);
			sections.forEach((s) => observer!.observe(s));
		};

		build();
		window.addEventListener('resize', build);
	}
</script>
