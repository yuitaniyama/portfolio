---
// Freedom Tax Japan — Supporting Case Study (Project 03), WIREFRAME.
// A standalone page (not in the `work` content collection) so the two
// hubstep case studies and the shared [id].astro template stay untouched.
// It reuses the shared case-study layout classes from global.css
// (content-grid, case-meta, case-study-body, case-index, case-section).
// Every visual is a neutral gray Placeholder: swap a <Ph> for an <img>
// (or a real component) when the final visual is ready.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import Ph from '../../components/Placeholder.astro';
import ScrollableProductPreview from '../../components/ScrollableProductPreview.astro';
import EnlargeableImage from '../../components/EnlargeableImage.astro';

const sections = [
	{ id: 'outcome', title: 'What the project produced' },
	{ id: 'research', title: 'Understanding the market before designing' },
	{ id: 'design-exploration', title: 'Turning insights into design decisions' },
	{ id: 'usability-testing', title: 'Testing the experience with users' },
	{ id: 'learning', title: 'What I took forward' },
];

const outcomes = [
	{ value: '15', label: 'Competitors analyzed' },
	{ value: '4', label: 'Moderated usability testing sessions' },
	{ value: 'Multiple UI ideas', label: 'Incorporated into the redesign' },
	{ value: 'New landing page', label: 'Launched before the 2025 tax season' },
];

// Each example uses whichever comparison structure best explains that
// piece of work (3-step before/reference/implemented, 3-step
// before/proposal/implemented, or a simpler 2-step exploration/
// implemented) rather than being forced into one identical shape.
const designExamples = [
	{
		eyebrow: '01 — Competitive research',
		heading: 'Making tax-season timing visible',
		body: [
			'The team was <strong>repeatedly asked when users could file their taxes</strong>, even though the timing followed a predictable annual schedule.',
			'During the competitive audit, I found a UK tax service using a persistent notification bar for time-sensitive filing information. <strong>I proposed applying a similar pattern to FTJ so users could see the relevant tax-season timing without needing to ask.</strong>',
			'<strong>The idea was adopted</strong>, and during usability testing <strong>participants found the timing information clear and easy to understand.</strong>',
		],
		// This example gets a 2x2 editorial grid instead of the default
		// single-row/arrow treatment — four screens is one too many to
		// read comfortably in a row, and the 4-step sequence (before →
		// reference → proposal → implemented) is clear enough from
		// numbering alone without arrows spelling it out.
		gridLayout: true,
		// Each step holds an `images` array rather than a single image —
		// only Example 03's "Exploration" step actually uses more than
		// one (two directions explored side by side before the team
		// converged on the implemented version), but keeping the shape
		// consistent means one render path handles every step.
		steps: [
			{ tag: 'Before', images: [{ label: 'Previous FTJ hero', file: 'tax-season-before', width: 3270, height: 1636 }] },
			{
				tag: 'Competitive reference',
				images: [
					{
						label: 'Competitive reference — UK tax service notification bar',
						file: 'tax-season-reference',
						width: 2880,
						height: 1408,
					},
				],
				caption: 'Pattern identified during competitive research',
			},
			{
				tag: 'My proposal',
				images: [{ label: 'My wireframe for the FTJ notification bar', file: 'tax-season-proposal', width: 3840, height: 2160 }],
			},
			{
				tag: 'Implemented',
				images: [{ label: 'Implemented FTJ notification bar', file: 'tax-season-implemented', width: 2610, height: 1322 }],
			},
		],
	},
	{
		eyebrow: '02 — User behavior',
		heading: 'Making high-interest content easier to explore',
		body: [
			'Interaction data showed <strong>strong engagement with Tax Guide content, even near the bottom of the landing page.</strong>',
			'<strong>I proposed a more scannable article layout. The direction was adopted</strong>, with the final implementation simplified to fit the no-code platform.',
		],
		// 2-row grid like Example 01 — 3 items wrap naturally into a
		// 2-up top row (Before, My proposal) and a single-item bottom
		// row (Implemented), same editorial tone across both examples.
		gridLayout: true,
		steps: [
			{ tag: 'Before', images: [{ label: 'Previous resource section', file: 'tax-guide-before', width: 1160, height: 461 }] },
			{
				tag: 'My proposal',
				images: [{ label: 'My Tax Guide / resource UI proposal', file: 'tax-guide-proposal', width: 1160, height: 646 }],
			},
			{
				tag: 'Implemented',
				images: [{ label: 'Implemented resource section', file: 'tax-guide-implemented', width: 2360, height: 1205 }],
				caption: 'Thumbnail and author elements were omitted due to platform constraints.',
			},
		],
	},
	{
		eyebrow: '03 — Collaboration',
		heading: 'Designing for feedback of different lengths',
		body: [
			'My mentor proposed creating a dedicated "Wall of Gratitude" to surface more customer feedback.',
			'<strong>I explored flexible layouts for feedback of different lengths</strong>, and the adopted direction <strong>made longer responses easier to scan.</strong>',
		],
		steps: [
			{
				tag: 'Exploration',
				images: [
					{ label: 'Wall of Gratitude layout exploration', file: 'wall-of-gratitude-exploration', width: 1600, height: 693 },
				],
			},
			{
				tag: 'Implemented',
				images: [{ label: 'Implemented Wall of Gratitude', file: 'wall-of-gratitude-implemented', width: 1280, height: 764 }],
			},
		],
	},
];

const setup = ['4 participants', '30–60 min / session', 'Moderated sessions', 'Prototype walkthrough', 'Comments + behavior documented'];

// Participants are anonymized, so there are no real photos or screen
// captures to show per person. Each gets a small circular "vibe" photo
// (free-license stock, Unsplash License — no attribution required)
// tied to an unrelated interest, purely as a lightweight, generic
// visual identifier — not a claim that this is what the person looks
// like.
const participants = [
	{
		name: 'Lynn',
		context: 'Long-term resident in Japan, already working with an accountant.',
		reacted:
			'She was interested in the promise of making tax filing easier over time, but felt unclear about what the free consultation included and whether the service was meant for someone in her situation.',
		revealed: 'The overall value proposition was appealing, but the service fit and first step were not always obvious.',
		photo: 'lynn-tennis',
	},
	{
		name: 'Neil',
		context: 'User familiar with tax filing in both Japan and the US.',
		reacted:
			'He found parts of the experience easy to understand, but some labels and sections felt ambiguous. He also questioned the difference between certain CTAs and wanted more direct wording in a few places.',
		revealed: 'A stronger information hierarchy and clearer action labels were needed to reduce interpretation effort.',
		photo: 'neil-glasses',
	},
	{
		name: 'Joshua',
		context: 'Freelancer with prior tax-filing experience and an existing accountant.',
		reacted:
			'He saw the service as trustworthy, responded positively to the visuals and quantitative proof, and felt the overall flow was clear. At the same time, price remained the most important factor in whether he would consider switching.',
		revealed: 'Trust signals were effective, but pricing clarity remained central to decision-making.',
		photo: 'joshua-golf',
	},
	{
		name: 'Victor',
		context: 'User reviewing the portal and input flow in more detail.',
		reacted:
			'He hesitated around field formats, naming conventions, and income categories, and would have benefited from clearer examples, helper text, and more guided input patterns.',
		revealed:
			'The portal experience needed more support at moments where users had to map real-life situations into the product’s structure.',
		photo: 'victor-cat',
	},
];

const learnings = [
	{
		title: 'Research before solutions',
		body: 'Competitive research gave the team a shared starting point before discussing solutions.',
	},
	{
		title: 'Testing reveals what reviews miss',
		body: 'Usability testing exposed confusion that was difficult to notice through internal design reviews alone.',
	},
	{
		title: 'Design is collaborative',
		body: 'Working with a senior designer taught me how to contribute ideas without treating product design as an individual exercise.',
	},
];
---

<BaseLayout title="Freedom Tax Japan — Yui Taniyama">
	<article class="content-grid">
		<CaseHeader
			eyebrow="Supporting Case Study"
			title="Bringing Research and Testing to Freedom Tax Japan's Redesign"
			description="A B2C tax-filing service for English-speaking residents in Japan."
			meta={[
				{ label: 'Role', value: 'UI/UX Design Intern' },
				{ label: 'Environment', value: 'English-speaking startup' },
				{ label: 'Collaboration', value: 'Senior UI/UX Designer, Founder' },
				{ label: 'Focus', value: 'Competitive Research · UI Exploration · Usability Testing' },
			]}
			intro={[
				'Freedom Tax Japan helps English-speaking residents in Japan navigate tax filing. As a UI/UX design intern, I worked alongside a senior designer and the founder, contributing research, design exploration, and usability testing to the redesign.',
			]}
		/>

		<div class="ftj-hero">
			<img
				class="ftj-hero__img"
				src="/freedom-tax-japan/hero/hero2.png"
				alt="FreedomTax Japan landing page and design exploration screens"
				width="3200"
				height="2400"
				loading="eager"
				decoding="async"
			/>
		</div>

		<div class="case-study-body">
			<nav class="case-index" aria-label="Case study sections">
				<div class="case-index__eyebrow">In this case study</div>
				<ol>
					{
						sections.map((s) => (
							<li>
								<a href={`#${s.id}`}>{s.title}</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="case-sections">
				<!-- 01 OUTCOME -->
				<section id="outcome" class="case-section">
					<div class="section-eyebrow">01 — Outcome</div>
					<h2>What the project produced</h2>

					<dl class="ftj-stats">
						{
							outcomes.map((o) => (
								<div class="ftj-stat">
									<dt class="ftj-stat__value">{o.value}</dt>
									<dd class="ftj-stat__label">{o.label}</dd>
								</div>
							))
						}
					</dl>

					<div class="prose">
						<p>
							The redesign combined competitive research, collaborative design exploration, and usability testing.{' '}
							<strong>Several of the UI ideas I proposed were incorporated into the final direction</strong>, while{' '}
							<strong>user testing helped uncover issues that were difficult to identify through internal design reviews alone.</strong>
						</p>
					</div>

					<ScrollableProductPreview
					src="/freedom-tax-japan/outcome/final-landing-page.png"
					alt="Final FreedomTax Japan landing page design"
					label="Final landing page"
					height={480}
				/>
				</section>

				<!-- 02 RESEARCH -->
				<section id="research" class="case-section">
					<div class="section-eyebrow">02 — Research</div>
					<h2>Understanding the market before designing</h2>

					<figure class="ftj-audit">
						<EnlargeableImage
							src="/freedom-tax-japan/research/competitive-audit.png"
							alt="Competitive analysis mapping the user flows of 15 tax-filing services"
							enlargeable={false}
						/>
						<figcaption class="ftj-audit__caption">Competitive analysis (Desktop)</figcaption>
					</figure>

					<div class="ftj-research-row">
						<figure class="ftj-research-row__visual">
							<EnlargeableImage
								src="/freedom-tax-japan/research/app-competitive-audit.png"
								alt="Competitive audit of app-based tax-filing experiences"
								enlargeable={false}
							/>
							<figcaption class="ftj-audit__caption">Competitive analysis (App)</figcaption>
						</figure>
						<div class="prose ftj-research-row__text">
							<p>
								I reviewed 15 competing services and <strong>mapped their user flows to understand how tax-related
								services communicated value, built trust, and guided users toward the next step.</strong>
							</p>
							<p>I shared the findings with the team and used them as input for our redesign discussions.</p>
						</div>
					</div>

					<div class="ftj-synthesis">
						<div class="section-eyebrow">Research synthesis</div>
						<h3 class="ftj-synthesis__heading">Two characteristics that shaped the redesign</h3>
						<div class="prose">
							<p>
								The competitive audit helped us <strong>narrow the discussion to two characteristics that became central
								to the redesign: trust and convenience.</strong>
							</p>
						</div>

						<div class="ftj-synthesis__grid">
							<div class="ftj-synthesis__item">
								<div class="ftj-synthesis__tag">
									<span class="ftj-synthesis__num">01</span>
									<span class="ftj-synthesis__label">Trust</span>
								</div>
								<h4 class="ftj-synthesis__item-heading">Trust needed to be visible, not assumed</h4>
								<p class="ftj-synthesis__body">
									Users needed <strong>clear evidence that a tax service was credible</strong> — through expertise,
									customer experiences, social proof, and transparent information about the company.
								</p>
								<p class="ftj-synthesis__keywords">Expertise · Social proof · Customer experience · Transparency</p>
							</div>

							<div class="ftj-synthesis__item">
								<div class="ftj-synthesis__tag">
									<span class="ftj-synthesis__num">02</span>
									<span class="ftj-synthesis__label">Convenience</span>
								</div>
								<h4 class="ftj-synthesis__item-heading">Convenience was about reducing uncertainty, not just steps</h4>
								<p class="ftj-synthesis__body">
									A convenient experience meant knowing what to do next, understanding complex terms, seeing progress,
									and knowing the expected time and cost — while still being able to get support when needed.
								</p>
								<p class="ftj-synthesis__keywords">Clear actions · Progress · Plain language · Price &amp; time transparency</p>
							</div>
						</div>
					</div>
				</section>

				<!-- 03 DESIGN EXPLORATION -->
				<section id="design-exploration" class="case-section">
					<div class="section-eyebrow">03 — Design exploration</div>
					<h2>Turning insights into design decisions</h2>

					<div class="prose">
						<p>
							Not every design direction started from the same source. Some came from competitive research, others from
							user behavior or team discussions. The following are three proposals I contributed that were incorporated
							into the product.
						</p>
					</div>

					<div class="ftj-examples">
						{
							designExamples.map((example) => (
								<div class="ftj-example">
									<div class="section-eyebrow">{example.eyebrow}</div>
									<h3 class="ftj-example__heading">{example.heading}</h3>

									<div class="prose">
										{example.body.map((p) => (
											<p set:html={p} />
										))}
									</div>

									{example.gridLayout ? (
										<div class="ftj-steps-grid">
											{example.steps.map((step, i) => (
												<figure
											class:list={[
												'ftj-steps-grid__item',
												i === example.steps.length - 1 && example.steps.length % 2 !== 0 && 'ftj-steps-grid__item--full',
											]}
										>
													<div class="section-eyebrow">
														{String(i + 1).padStart(2, '0')} — {step.tag}
													</div>
													<div class="ftj-steps__images">
														{step.images.map((image) => (
															<img
																class="ftj-steps__img"
																src={`/freedom-tax-japan/design-exploration/${image.file}.png`}
																alt={image.label}
																width={image.width}
																height={image.height}
																loading="lazy"
																decoding="async"
															/>
														))}
													</div>
													{step.caption && <figcaption class="ftj-audit__caption">{step.caption}</figcaption>}
												</figure>
											))}
										</div>
									) : (
										<div class="ftj-steps">
											{example.steps.map((step, i) => (
												<figure class="ftj-steps__step">
													<div class="section-eyebrow">
														{String(i + 1).padStart(2, '0')} — {step.tag}
													</div>
													<div class="ftj-steps__images">
														{step.images.map((image) => (
															<img
																class="ftj-steps__img"
																src={`/freedom-tax-japan/design-exploration/${image.file}.png`}
																alt={image.label}
																width={image.width}
															height={image.height}
															loading="lazy"
															decoding="async"
														/>
													))}
														</div>
														{step.caption && <figcaption class="ftj-audit__caption">{step.caption}</figcaption>}
													</figure>
											))}
										</div>
									)}
								</div>
							))
						}
					</div>
				</section>

				<!-- 04 USABILITY TESTING (strongest section) -->
				<section id="usability-testing" class="case-section ftj-testing">
					<div class="section-eyebrow">04 — Usability testing</div>
					<h2>Testing the experience with users</h2>

					<div class="prose">
						<p>
							I planned and conducted four moderated usability testing sessions with participants I recruited, with input from
							my boss on the discussion guide.
						</p>
						<p>
							Each session lasted approximately 30–60 minutes and included a prototype walkthrough, follow-up questions, and
							discussion around trust, service understanding, and next actions.
						</p>
						<p>
							I documented participants’ comments alongside the exact screens they were reacting to, which made it easier to
							identify where the experience was clear and where confusion remained.
						</p>
						<p>
							I then reviewed the findings with the senior designer and the team. Rather than deciding on design changes
							independently, we identified issues together and explored possible responses collaboratively.
						</p>
					</div>

					<EnlargeableImage
						src="/freedom-tax-japan/usability-testing/usability-testing-documentation.png"
						alt="Usability testing documentation board, showing screens annotated with participant comments"
						enlargeable={false}
					/>

					<div class="ftj-setup">
						<div class="ftj-setup__label">Test setup</div>
						<ul>
							{setup.map((s) => <li>{s}</li>)}
						</ul>
					</div>

					<div class="ftj-insights-head">4 participant insights</div>
					<div class="ftj-insights">
						{
							participants.map((p) => (
								<article class="ftj-insight">
									<img
										class="ftj-avatar"
										src={`/freedom-tax-japan/usability-testing/${p.photo}.jpg`}
										alt=""
										width="120"
										height="120"
										loading="lazy"
										decoding="async"
									/>
									<h3 class="ftj-insight__name">{p.name}</h3>
									<dl>
										<dt>Context</dt>
										<dd>{p.context}</dd>
										<dt>What they reacted to</dt>
										<dd>{p.reacted}</dd>
										<dt>What it revealed</dt>
										<dd class="ftj-insight__revealed">{p.revealed}</dd>
									</dl>
								</article>
							))
						}
					</div>
				</section>

				<!-- 05 LEARNING -->
				<section id="learning" class="case-section">
					<div class="section-eyebrow">05 — Learning</div>
					<h2>What I took forward</h2>

					<ol class="ftj-learnings">
						{
							learnings.map((l, i) => (
								<li>
									<div class="ftj-learnings__num">{String(i + 1).padStart(2, '0')}</div>
									<div class="ftj-learnings__title">{l.title}</div>
									<p class="ftj-learnings__body">{l.body}</p>
								</li>
							))
						}
					</ol>
				</section>
			</div>
		</div>

		<nav class="ftj-pager" aria-label="Case study navigation">
			<a href="/work/hubstep-foundation/">
				<span class="ftj-pager__label">Previous case study</span>
				<span class="ftj-pager__title">Keeping hubstep Coherent While It Grew</span>
			</a>
			<a href="/" class="ftj-pager__next">
				<span class="ftj-pager__label">Back to</span>
				<span class="ftj-pager__title">All work →</span>
			</a>
		</nav>
	</article>
</BaseLayout>

<style>
	/* FTJ's own reserved accent (sampled from the product's brand blue,
	   same reasoning as the hubstep teal via --color-accent in
	   global.css) for the active Section Index item — kept local to
	   this page rather than promoted to a shared token, since it's a
	   per-case-study brand color, not a sitewide one. */
	.case-index a.is-active {
		color: #0496ce;
	}

	.ftj-hero {
		margin-top: var(--space-6);
	}

	/* hero2.png is 4:3 (a screen-collage composite, not a 16:9 banner like
	   the hubstep heroes). Run it full-bleed at that ratio and it reads
	   noticeably taller/heavier than the other case studies' hero bands —
	   capping its width (rather than cropping the image) keeps its
	   rendered height in the same neighborhood without forcing an exact
	   ratio match. */
	.ftj-hero__img {
		display: block;
		width: 100%;
		max-width: 44rem;
		height: auto;
		margin-inline: auto;
	}

	/* Vertical rhythm inside a section: heading, then blocks spaced evenly. */
	.case-section > :global(* + *) {
		margin-top: var(--space-4);
	}

	.case-section > h2 + :global(*) {
		margin-top: var(--space-4);
	}

	/* Outcome stats — 2×2, hairline separators instead of cards. */
	.ftj-stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		margin-bottom: 0;
		border-top: 1px solid var(--color-border);
	}

	.ftj-stat {
		padding: var(--space-3) var(--space-3) var(--space-3) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.ftj-stat__value {
		font-size: var(--text-h2);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: #154384;
	}

	.ftj-stat__label {
		margin: var(--space-1) 0 0;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.9em;
		line-height: 1.75;
	}

	/* Research: the competitive-audit visual, enlargeable since its value
	   is in showing the breadth of the audit, not being legible inline
	   at full width (per EnlargeableImage's existing lightbox pattern). */
	.ftj-audit__caption {
		margin: var(--space-2) 0 0;
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	/* App audit sits beside its own explanation rather than stacking as
	   a second full-width hero image — reads as an extension of the
	   research (smaller, paired with text) rather than competing with
	   the Desktop audit above. ~52/48 split, with a wide gap standing
	   in for "generous whitespace between them". */
	.ftj-research-row {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: var(--space-8);
		align-items: center;
		margin-top: var(--space-8);
	}

	.ftj-research-row__visual {
		margin: 0;
	}

	.ftj-research-row__text {
		max-width: none;
	}

	/* Research synthesis — two findings the audit narrowed the redesign
	   to. Deliberately plain (hairline + numbering, no card chrome) to
	   stay editorial rather than reading as a UI component. */
	.ftj-synthesis {
		margin-top: var(--space-8);
	}

	.ftj-synthesis__heading {
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	/* Card grid: rows are shared via subgrid, so each row (tag / heading /
	   body / keywords) takes the height of whichever card needs more —
	   the shorter card's cells stretch to match, which is what keeps the
	   heading block and the keywords line aligned across both cards
	   regardless of copy length, without hardcoding any heights. */
	.ftj-synthesis__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: auto auto auto auto;
		column-gap: var(--space-6);
		margin-top: var(--space-4);
	}

	.ftj-synthesis__item {
		display: grid;
		grid-template-rows: subgrid;
		grid-row: 1 / -1;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 20px;
