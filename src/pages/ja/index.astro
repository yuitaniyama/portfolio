---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Japanese homepage — a translated duplicate of src/pages/index.astro.
// Card copy is hand-authored per project, same as the English version;
// only hubstep-sfa-platform has a Japanese case study page so far, so
// the other two cards link out to their English pages rather than a
// Japanese page that doesn't exist yet.
const CARD_COPY: Record<
	string,
	{
		image?: { src: string; width: number; height: number };
		meta: string;
		description: string;
		skills: string[];
		href: string;
	}
> = {
	'hubstep-sfa-platform': {
		image: { src: '/home/selected-work/hubstep-sfa-cover.png', width: 7032, height: 3950 },
		meta: 'プロダクトデザイン・SFA / CRM',
		description: 'ダイレクトメール業務から、より広い営業ワークフローへ——プロダクトの転換をデザインする。',
		skills: ['ワークフロー設計', '情報設計', 'プロトタイピング'],
		href: '/ja/work/hubstep-sfa-platform/',
	},
	'hubstep-foundation': {
		image: { src: '/home/selected-work/hubstep-foundation-cover.png', width: 7032, height: 3950 },
		meta: 'プロダクトデザイン・UI/UX & デザインシステム',
		description:
			'開発途中からhubstepに参加し、実際の利用から得た知見をもとに、UI/UX、デザインシステム、プロダクトコミュニケーションを継続的に改善してきた。',
		skills: ['UI/UXデザイン', 'デザインシステム', 'プロダクトコミュニケーション'],
		href: '/ja/work/hubstep-foundation/',
	},
};

const allWork = await getCollection('work', ({ data }) => !data.draft);
const projects = allWork
	.sort((a, b) => a.data.order - b.data.order)
	.map((project) => {
		const slug = project.id.replace(/\/_meta$/, '');
		return { slug, title: project.data.title, copy: CARD_COPY[slug] };
	})
	.filter((p): p is typeof p & { copy: NonNullable<(typeof p)['copy']> } => Boolean(p.copy));

// Project 03 (Freedom Tax Japan) is a standalone page, not in the `work`
// collection, so its card is added here.
projects.push({
	slug: 'freedom-tax-japan',
	title: 'Freedom Tax Japan',
	copy: {
		image: { src: '/home/selected-work/freedom-tax-japan-cover.png', width: 7032, height: 3950 },
		meta: 'UXリサーチ・ユーザビリティテスト・サブケーススタディ',
		description: '日本在住の英語話者向けのB2C確定申告サービス。',
		skills: ['競合調査', 'UI探索', 'ユーザビリティテスト'],
		href: '/work/freedom-tax-japan/',
	},
});
---

<BaseLayout title="Yui Taniyama — プロダクトデザイナー" lang="ja" translationHref="/">
	<section class="content-grid hero">
		<h1 class="hero__headline">
			<span class="hero__line">昔から、人が毎日使うものを</span>{' '}
			<span class="hero__line">少しでも心地よくすることが</span>{' '}
			<span class="hero__line">好きだった。</span>
		</h1>

		<div class="prose hero__supporting">
			<p>
				ファッション業界でキャリアをスタートし、9年間で1,400点以上の商品の企画・デザインに携わった。現在はデジタルプロダクトのデザインをしている。
			</p>
			<p><strong>素材は違っても、プロセスは同じだ：</strong>リサーチ、スケッチ、プロトタイピング、改善、そして繰り返す。</p>
		</div>
		<a class="scroll-indicator" href="#work" aria-label="Scroll to selected work">
			<span class="scroll-indicator__label">Scroll</span>
			<span class="scroll-indicator__line" aria-hidden="true"></span>
		</a>
	</section>

	{
		projects.length > 0 && (
			<section id="work" class="content-grid selected-work">
				<div class="selected-work__label">主な実績</div>

				<div class="work-list">
					{
						projects.map((project, i) => (
							<a class="work-card" href={project.copy.href}>
								<span class="work-card__image-wrap">
									{project.copy.image ? (
										<img
											class="work-card__image"
											src={project.copy.image.src}
											alt={project.title}
											width={project.copy.image.width}
											height={project.copy.image.height}
											loading={i === 0 ? 'eager' : 'lazy'}
										/>
									) : (
										<span class="work-card__placeholder">ヒーロービジュアル — 準備中</span>
									)}
								</span>
								<div class="work-card__info">
									<div class="work-card__details">
										<p class="work-card__meta">{project.copy.meta}</p>
										<p class="work-card__description">{project.copy.description}</p>
									</div>

									<div class="work-card__skills">
										<div class="work-card__skills-label">主なスキル</div>
										<ul class="work-card__skills-list">
											{project.copy.skills.map((skill) => (
												<li>{skill}</li>
											))}
										</ul>
									</div>
								</div>
							</a>
						))
					}
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	/* Home interaction (large screens only): the hero stays pinned in
	   place while the Selected Work sheet rises from below and slides
	   over it. The hero is sized so that, at the top of the page, it fills
	   the screen except for a small strip where the sheet's top edge
	   peeks in as a hint that there is more below. The sticky offset is
	   the hero's natural position, so it never shifts — only the sheet
	   moves. Gated on width and height because a pinned hero taller
	   than the screen would leave its lower part unreachable: phones,
	   tablets and short windows keep the plain scrolling layout. */
	.hero {
		margin-top: var(--space-8);
	}

	.scroll-indicator {
		display: none;
	}

	@media (min-width: 1000px) and (min-height: 700px) {
		.hero {
			position: sticky;
			top: calc(var(--header-h, 5.5rem) + var(--space-8));
			align-content: start;
			min-height: calc(100svh - var(--header-h, 5.5rem) - var(--space-8) - 5rem);
			/* room for the scroll cue so it never sits on top of text */
			padding-bottom: 7rem;
		}

		/* The sheet that slides over the hero: opaque and above it. Its top
		   spacing is padding (not margin) so the sheet's own edge is what
		   covers the hero. */
		.selected-work {
			position: relative;
			z-index: 1;
			margin-top: 0;
			padding-top: var(--space-editorial);
			background: var(--color-bg);
			scroll-margin-top: var(--header-h, 5.5rem);
		}

		/* "Scroll" cue: a small label over a thin line with a short
		   segment running down it. Fades out once scrolling starts. */
		.scroll-indicator {
			position: absolute;
			left: 50%;
			bottom: var(--space-3);
			transform: translateX(-50%);
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-2);
			text-decoration: none;
			color: var(--color-text-muted);
			transition: opacity 300ms ease;
		}

		.scroll-indicator.is-hidden {
			opacity: 0;
			pointer-events: none;
		}
	}

	.scroll-indicator__label {
		font-size: var(--text-label);
		letter-spacing: 0.24em;
		text-transform: uppercase;
		/* letter-spacing adds trailing space after the last letter; offset
		   it so the label stays visually centered over the line. */
		margin-right: -0.24em;
	}

	.scroll-indicator__line {
		position: relative;
		display: block;
		width: 1px;
		height: 3.5rem;
		overflow: hidden;
		background: var(--color-border);
	}

	.scroll-indicator__line::after {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 40%;
		background: var(--color-text);
		animation: scroll-indicator-run 2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	@keyframes scroll-indicator-run {
		0% {
			transform: translateY(-100%);
		}
		100% {
			transform: translateY(250%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-indicator__line::after {
			animation: none;
			transform: translateY(0);
		}
	}

	.hero__headline {
		line-height: 1.15;
	}

	.hero__line {
		display: block;
	}

	.hero__supporting {
		margin-top: var(--space-4);
		color: var(--color-text-muted);
	}

	.hero__supporting strong {
		font-weight: 600;
		color: var(--color-text);
	}

	@media (max-width: 640px) {
		.hero__line {
			display: inline;
		}
	}

	.selected-work {
		margin-top: var(--space-editorial);
	}

	.selected-work__label {
		text-align: center;
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.work-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		margin-top: var(--space-6);
	}

	.work-card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.work-card__image-wrap {
		display: block;
		overflow: hidden;
	}

	.work-card__image {
		width: 100%;
		height: auto;
		transition: transform 400ms ease;
	}

	.work-card:hover .work-card__image,
	.work-card:focus-visible .work-card__image {
		transform: scale(1.015);
	}

	.work-card:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 4px;
	}

	.work-card__placeholder {
		aspect-ratio: 16 / 9;
		background: #eeeeee;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-muted);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
	}

	.work-card__info {
		margin-top: var(--space-3);
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.work-card__details {
		min-width: 0;
	}

	.work-card__meta {
		font-size: 1.125rem;
		color: var(--color-text-muted);
	}

	.work-card__description {
		margin-top: var(--space-2);
		max-width: var(--measure);
		color: var(--color-text-muted);
		font-family: var(--font-body);
		line-height: 1.75;
	}

	.work-card__skills {
		flex: none;
		max-width: 15rem;
	}

	.work-card__skills-label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: var(--space-1);
	}

	.work-card__skills-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}

	.work-card__skills-list li {
		font-size: 0.75rem;
		line-height: 1;
		padding: 0.45em 0.85em;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.work-card__info {
			flex-direction: column;
		}

		.work-card__skills {
			max-width: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.work-card__image {
			transition: none;
		}
	}
</style>

<script>
	// Hide the scroll cue once the visitor has started scrolling.
	const scrollIndicator = document.querySelector('.scroll-indicator');
	if (scrollIndicator) {
		const update = () => scrollIndicator.classList.toggle('is-hidden', window.scrollY > 40);
		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>
