---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Japanese homepage — a translated duplicate of src/pages/index.astro.
// Card copy is hand-authored per project, same as the English version;
// only hubstep-sfa-platform has a Japanese case study page so far, so
// the other two cards link out to their English pages rather than a
// Japanese page that doesn't exist yet.
const CARD_COPY: Record<
	string,
	{
		image?: { src: string; width: number; height: number };
		meta: string;
		description: string;
		skills: string[];
		href: string;
	}
> = {
	'hubstep-sfa-platform': {
		image: { src: '/home/selected-work/hubstep-sfa-cover.png', width: 7032, height: 3950 },
		meta: 'プロダクトデザイン・SFA / CRM',
		description: 'ダイレクトメール業務から、より広い営業ワークフローへ——プロダクトの転換をデザインする。',
		skills: ['ワークフロー設計', '情報設計', 'プロトタイピング'],
		href: '/ja/work/hubstep-sfa-platform/',
	},
	'hubstep-foundation': {
		image: { src: '/home/selected-work/hubstep-foundation-cover.png', width: 7032, height: 3950 },
		meta: 'プロダクトデザイン・UI/UX & デザインシステム',
		description:
			'開発途中からhubstepに参加し、実際の利用から得た知見をもとに、UI/UX、デザインシステム、プロダクトコミュニケーションを継続的に改善してきた。',
		skills: ['UI/UXデザイン', 'デザインシステム', 'プロダクトコミュニケーション'],
		href: '/work/hubstep-foundation/',
	},
};

const allWork = await getCollection('work', ({ data }) => !data.draft);
const projects = allWork
	.sort((a, b) => a.data.order - b.data.order)
	.map((project) => {
		const slug = project.id.replace(/\/_meta$/, '');
		return { slug, title: project.data.title, copy: CARD_COPY[slug] };
	})
	.filter((p): p is typeof p & { copy: NonNullable<(typeof p)['copy']> } => Boolean(p.copy));

// Project 03 (Freedom Tax Japan) is a standalone page, not in the `work`
// collection, so its card is added here.
projects.push({
	slug: 'freedom-tax-japan',
	title: 'Freedom Tax Japan',
	copy: {
		image: { src: '/home/selected-work/freedom-tax-japan-cover.png', width: 7032, height: 3950 },
		meta: 'UXリサーチ・ユーザビリティテスト・サブケーススタディ',
		description: '日本在住の英語話者向けのB2C確定申告サービス。',
		skills: ['競合調査', 'UI探索', 'ユーザビリティテスト'],
		href: '/work/freedom-tax-japan/',
	},
});
---

<BaseLayout title="Yui Taniyama — プロダクトデザイナー" lang="ja" translationHref="/">
	<section class="content-grid hero">
		<h1 class="hero__headline">
			<span class="hero__line">昔から、人が毎日使うものを</span>{' '}
			<span class="hero__line">少しでも心地よくすることが</span>{' '}
			<span class="hero__line">好きだった。</span>
		</h1>

		<div class="prose hero__supporting">
			<p>
				ファッション業界でキャリアをスタートし、10年間で1,200点以上の商品の企画・デザインに携わった。現在はデジタルプロダクトのデザインをしている。
			</p>
			<p><strong>素材は違っても、プロセスは同じだ：</strong>リサーチ、スケッチ、プロトタイピング、改善、そして繰り返す。</p>
		</div>
	</section>

	{
		projects.length > 0 && (
			<section class="content-grid selected-work">
				<div class="selected-work__label">主な実績</div>

				<div class="work-list">
					{
						projects.map((project, i) => (
							<a class="work-card" href={project.copy.href}>
								<span class="work-card__image-wrap">
									{project.copy.image ? (
										<img
											class="work-card__image"
											src={project.copy.image.src}
											alt={project.title}
											width={project.copy.image.width}
											height={project.copy.image.height}
											loading={i === 0 ? 'eager' : 'lazy'}
										/>
									) : (
										<span class="work-card__placeholder">ヒーロービジュアル — 準備中</span>
									)}
								</span>
								<div class="work-card__info">
									<div class="work-card__details">
										<p class="work-card__meta">{project.copy.meta}</p>
										<p class="work-card__description">{project.copy.description}</p>
									</div>

									<div class="work-card__skills">
										<div class="work-card__skills-label">主なスキル</div>
										<ul class="work-card__skills-list">
											{project.copy.skills.map((skill) => (
												<li>{skill}</li>
											))}
										</ul>
									</div>
								</div>
							</a>
						))
					}
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.hero {
		margin-top: var(--space-8);
	}

	.hero__headline {
		line-height: 1.15;
	}

	.hero__line {
		display: block;
	}

	.hero__supporting {
		margin-top: var(--space-4);
		color: var(--color-text-muted);
	}

	.hero__supporting strong {
		font-weight: 600;
		color: var(--color-text);
	}

	@media (max-width: 640px) {
		.hero__line {
			display: inline;
		}
	}

	.selected-work {
		margin-top: var(--space-editorial);
	}

	.selected-work__label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.work-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		margin-top: var(--space-4);
	}

	.work-card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.work-card__image-wrap {
		display: block;
		overflow: hidden;
	}

	.work-card__image {
		width: 100%;
		height: auto;
		transition: transform 400ms ease;
	}

	.work-card:hover .work-card__image,
	.work-card:focus-visible .work-card__image {
		transform: scale(1.015);
	}

	.work-card:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 4px;
	}

	.work-card__placeholder {
		aspect-ratio: 16 / 9;
		background: #eeeeee;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-muted);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
	}

	.work-card__info {
		margin-top: var(--space-3);
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.work-card__details {
		min-width: 0;
	}

	.work-card__meta {
		font-size: 1.125rem;
		color: var(--color-text-muted);
	}

	.work-card__description {
		margin-top: var(--space-2);
		max-width: var(--measure);
		color: var(--color-text-muted);
		font-family: var(--font-body);
		line-height: 1.75;
	}

	.work-card__skills {
		flex: none;
		max-width: 15rem;
	}

	.work-card__skills-label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: var(--space-1);
	}

	.work-card__skills-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}

	.work-card__skills-list li {
		font-size: 0.75rem;
		line-height: 1;
		padding: 0.45em 0.85em;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.work-card__info {
			flex-direction: column;
		}

		.work-card__skills {
			max-width: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.work-card__image {
			transition: none;
		}
	}
</style>
