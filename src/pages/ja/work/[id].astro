---
// Japanese case study route — currently serves only hubstep-sfa-platform
// (the one case study translated so far), reading from the workJa /
// workSectionMetaJa / workBlocksJa collections (src/content/work-ja/)
// instead of their English counterparts. Deliberately a separate file
// from ../../work/[id].astro rather than a shared template: with only
// one Japanese case study to support, forking this page keeps it simple
// and keeps the English route (already shared with a recruiter)
// completely untouched. Diagram components are reused as-is in English
// — they're visual/schematic, not prose, and only hubstep-sfa-platform's
// diagrams are imported here (not hubstep-foundation's, which has no
// Japanese version). If more Japanese case studies are added later,
// revisit whether this should become a shared template instead.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HubstepHero from '../../../components/HubstepHero.astro';
import CaseHeader from '../../../components/CaseHeader.astro';
import NextCaseStudy from '../../../components/NextCaseStudy.astro';
import BeforeDiagram from '../../../components/diagrams/BeforeDiagram.astro';
import AfterDiagram from '../../../components/diagrams/AfterDiagram.astro';
import RequirementsDesignSpecVisual from '../../../components/diagrams/RequirementsDesignSpecVisual.astro';
import EarlySystemFlowVisual from '../../../components/diagrams/EarlySystemFlowVisual.astro';
import Section03Walkthrough from '../../../components/diagrams/Section03Walkthrough.astro';
import IssueSources from '../../../components/diagrams/IssueSources.astro';
import ChallengeShift from '../../../components/diagrams/ChallengeShift.astro';
import MentalModelsShift from '../../../components/diagrams/MentalModelsShift.astro';
import BeforeDashboardsGrid from '../../../components/diagrams/BeforeDashboardsGrid.astro';
import LoginHomeFlowVisual from '../../../components/diagrams/LoginHomeFlowVisual.astro';
import UserJourneyVisual from '../../../components/diagrams/UserJourneyVisual.astro';
import TeamSharingArtifacts from '../../../components/diagrams/TeamSharingArtifacts.astro';
import OutcomeHomeSplit from '../../../components/diagrams/OutcomeHomeSplit.astro';
import OutcomeSalesSplit from '../../../components/diagrams/OutcomeSalesSplit.astro';
import AfterNavigationVisual from '../../../components/diagrams/AfterNavigationVisual.astro';
import FinalNavigationFlow from '../../../components/diagrams/FinalNavigationFlow.astro';
import BeforeListUploadFlowVisual from '../../../components/diagrams/BeforeListUploadFlowVisual.astro';
import MappingValidationGapVisual from '../../../components/diagrams/MappingValidationGapVisual.astro';
import ErrorRecoveryGapVisual from '../../../components/diagrams/ErrorRecoveryGapVisual.astro';
import MappingRuleLearningVisual from '../../../components/diagrams/MappingRuleLearningVisual.astro';
import SeparateWorkflowVisual from '../../../components/diagrams/SeparateWorkflowVisual.astro';
import IntegratedHomeDirectionVisual from '../../../components/diagrams/IntegratedHomeDirectionVisual.astro';
import StagedTransitionVisual from '../../../components/diagrams/StagedTransitionVisual.astro';
import CurrentSalesWorkflowVisual from '../../../components/diagrams/CurrentSalesWorkflowVisual.astro';
import AiHumanBoundaryVisual from '../../../components/diagrams/AiHumanBoundaryVisual.astro';
import VoiceToCrmExplorationVisual from '../../../components/diagrams/VoiceToCrmExplorationVisual.astro';
import DesignRoleEvolutionVisual from '../../../components/diagrams/DesignRoleEvolutionVisual.astro';
import ImpactContent from '../../../components/diagrams/ImpactContent.astro';
import { getCollection, render } from 'astro:content';

// Keyed by the Japanese section's exact title (mirrors SECTION_EYEBROWS
// in the English route, translated).
const SECTION_EYEBROWS: Record<string, string> = {
	'DMツールから営業プラットフォームへ': '背景',
	曖昧なプロダクトを具体化する: 'プロセス',
	リリースで見えてきた本当のUX課題: 'リリース後',
	'HomeとSales Reportの再定義': '中核となるUX課題',
	リスト登録を見直す: 'ワークフロー改善',
	営業ワークフロー全体でプロダクトを進化させる: 'プロダクトの進化',
	'今後の探索 — AIを活用した営業ワークフロー': '今後の探索',
	進化し続けるプロダクトのデザインから学んだこと: '学び',
	インパクト: 'インパクト',
};

// Same keys as BLOCK_VISUALS in the English route — the Japanese content
// tree mirrors the same folder/ref names, only hubstep-sfa-platform's
// subset is needed here.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const BLOCK_VISUALS: Record<string, any> = {
	'hubstep-sfa-platform/sections/01-product-transformation/before': BeforeDiagram,
	'hubstep-sfa-platform/sections/01-product-transformation/after': AfterDiagram,
	'hubstep-sfa-platform/sections/02-making-tangible/requirements-design-spec': RequirementsDesignSpecVisual,
	'hubstep-sfa-platform/sections/02-making-tangible/early-system-flow': EarlySystemFlowVisual,
	'hubstep-sfa-platform/sections/03-shipping-exposed/walkthrough': Section03Walkthrough,
	'hubstep-sfa-platform/sections/03-shipping-exposed/issue-sources': IssueSources,
	'hubstep-sfa-platform/sections/03-shipping-exposed/challenge-shift': ChallengeShift,
	'hubstep-sfa-platform/sections/02-making-tangible/mental-models-shift': MentalModelsShift,
	'hubstep-sfa-platform/sections/04-home-sales-report/before-dashboards-grid': BeforeDashboardsGrid,
	'hubstep-sfa-platform/sections/04-home-sales-report/login-home-flow': LoginHomeFlowVisual,
	'hubstep-sfa-platform/sections/04-home-sales-report/user-journey': UserJourneyVisual,
	'hubstep-sfa-platform/sections/04-home-sales-report/team-sharing': TeamSharingArtifacts,
	'hubstep-sfa-platform/sections/04-home-sales-report/outcome-home': OutcomeHomeSplit,
	'hubstep-sfa-platform/sections/04-home-sales-report/outcome-sales': OutcomeSalesSplit,
	'hubstep-sfa-platform/sections/04-home-sales-report/after-navigation': AfterNavigationVisual,
	'hubstep-sfa-platform/sections/04-home-sales-report/final-navigation-flow': FinalNavigationFlow,
	'hubstep-sfa-platform/sections/05-list-upload/before-upload-flow': BeforeListUploadFlowVisual,
	'hubstep-sfa-platform/sections/05-list-upload/mapping-validation-gap': MappingValidationGapVisual,
	'hubstep-sfa-platform/sections/05-list-upload/error-recovery-gap': ErrorRecoveryGapVisual,
	'hubstep-sfa-platform/sections/05-list-upload/mapping-rule-learning': MappingRuleLearningVisual,
	'hubstep-sfa-platform/sections/06-continuous-evolution/separate-workflow': SeparateWorkflowVisual,
	'hubstep-sfa-platform/sections/06-continuous-evolution/integrated-home-direction': IntegratedHomeDirectionVisual,
	'hubstep-sfa-platform/sections/06-continuous-evolution/staged-transition': StagedTransitionVisual,
	'hubstep-sfa-platform/sections/07-ai-workflow/current-sales-workflow': CurrentSalesWorkflowVisual,
	'hubstep-sfa-platform/sections/07-ai-workflow/ai-human-boundary': AiHumanBoundaryVisual,
	'hubstep-sfa-platform/sections/07-ai-workflow/voice-to-crm-exploration': VoiceToCrmExplorationVisual,
	'hubstep-sfa-platform/sections/08-status-reflection/design-role-evolution': DesignRoleEvolutionVisual,
	'hubstep-sfa-platform/sections/09-impact/impact-content': ImpactContent,
};

export async function getStaticPaths() {
	const projects = await getCollection('workJa', ({ data }) => !data.draft);
	const allSectionMeta = await getCollection('workSectionMetaJa');
	const allBlocks = await getCollection('workBlocksJa');

	return projects.map((project) => {
		const slug = project.id.replace(/\/_meta$/, '');
		const sectionMeta = allSectionMeta
			.filter((s) => s.id.startsWith(`${slug}/sections/`))
			.sort((a, b) => a.id.localeCompare(b.id));
		const blocks = allBlocks.filter((b) => b.id.startsWith(`${slug}/sections/`));
		return {
			params: { id: slug },
			props: { project, sectionMeta, blocks },
		};
	});
}

const { project, sectionMeta, blocks } = Astro.props;
const { data } = project;
const slug = project.id.replace(/\/_meta$/, '');
const introParagraphs = data.intro.trim().split(/\n\s*\n/);

const sortKey = (id: string) => id.split('/sections/')[1];

const blockSections = await Promise.all(
	sectionMeta.map(async (meta) => {
		const folderId = meta.id.replace(/\/_meta$/, '');
		const ownBlocks = blocks
			.filter((b) => b.id.startsWith(`${folderId}/blocks/`))
			.sort((a, b) => a.id.localeCompare(b.id));

		const sectionBlocks = await Promise.all(
			ownBlocks.map(async (block) => {
				if (block.data.type === 'visual') {
					const Component = BLOCK_VISUALS[`${folderId}/${block.data.ref}`] ?? null;
					return { type: 'visual', Component };
				}
				if (block.data.type === 'placeholder-list') {
					return { type: 'placeholder-list', items: block.data.items ?? [] };
				}
				const { Content } = await render(block);
				return { type: 'prose', Content };
			})
		);

		return {
			sortKey: sortKey(folderId),
			title: meta.data.title,
			priority: meta.data.priority,
			blocks: sectionBlocks,
		};
	})
);

const renderedSections = blockSections
	.sort((a, b) => a.sortKey.localeCompare(b.sortKey))
	// Section ids come from the content folder names (e.g. "02-making-tangible"),
	// not the titles: Japanese titles contain no a-z/0-9, so a title-derived
	// slug would be empty and every section would share an empty id.
	.map((section) => ({ ...section, slug: section.sortKey }));

// Slug-to-URL used only for the Section Index / NextCaseStudy links
// below — same slug as the English version (so its own path is
// "/ja/work/<slug>/"), since the content tree mirrors the English one
// folder-for-folder.
const translationHref = `/work/${slug}/`;
---

<BaseLayout title={`${data.title} — Yui Taniyama`} lang="ja" translationHref={translationHref}>
	<article class="content-grid">
		<HubstepHero />

		<CaseHeader eyebrow={data.eyebrow} title={data.title} meta={data.meta} intro={introParagraphs} challenges={data.challenges} lang="ja" />

		<div class="case-study-body">
			<nav class="case-index" aria-label="Case study sections">
				<div class="case-index__eyebrow">目次</div>
				<ol>
					{
						renderedSections.map((section) => (
							<li>
								<a href={`#${section.slug}`}>{section.title}</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="case-sections">
				{
					renderedSections.map((section) => (
						<section id={section.slug} class:list={['case-section', `case-section--${section.priority}`]}>
							{SECTION_EYEBROWS[section.title] && (
								<div class="section-eyebrow">{SECTION_EYEBROWS[section.title]}</div>
							)}
							<h2>{section.title}</h2>

							{section.blocks.map(({ type, Content, Component, items }) => (
								type === 'visual' ? (
									Component && (
										<div class="case-visuals case-visuals--diagram">
											<Component />
										</div>
									)
								) : type === 'placeholder-list' ? (
									items && items.length > 0 && (
										<div class="case-visuals">
											{items.map((v) => (
												<div class="visual-placeholder">{v}</div>
											))}
										</div>
									)
								) : (
									Content && (
										<div class="prose">
											<Content />
										</div>
									)
								)
							))}
						</section>
					))
				}
			</div>
		</div>

		<NextCaseStudy currentSlug={slug} lang="ja" forceEmpty />
	</article>
</BaseLayout>

<script>
	// Section Index scrollspy — identical behavior to the English route's
	// own copy of this script (see ../../work/[id].astro).
	const sections = document.querySelectorAll<HTMLElement>('.case-sections .case-section[id]');
	const links = document.querySelectorAll<HTMLAnchorElement>('.case-index a[href^="#"]');
	if (sections.length && links.length) {
		const linkFor = (id: string) => document.querySelector<HTMLAnchorElement>(`.case-index a[href="#${id}"]`);

		const setActive = (id: string) => {
			links.forEach((a) => a.classList.toggle('is-active', a === linkFor(id)));
		};

		const headerH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 0;

		let observer: IntersectionObserver | undefined;
		const observedIds = new Set<string>();

		const build = () => {
			observer?.disconnect();
			observedIds.clear();

			observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) observedIds.add(entry.target.id);
						else observedIds.delete(entry.target.id);
					});

					let current: string | undefined;
					let bestTop = Infinity;
					observedIds.forEach((id) => {
						const el = document.getElementById(id);
						if (!el) return;
						const top = el.getBoundingClientRect().top;
						if (top < bestTop) {
							bestTop = top;
							current = id;
						}
					});

					if (current) setActive(current);
				},
				{ rootMargin: `-${headerH() + 8}px 0px -70% 0px`, threshold: 0 }
			);

			sections.forEach((s) => observer!.observe(s));
		};

		build();
		window.addEventListener('resize', build);
	}
</script>
