---
import '../styles/global.css';

interface Props {
	title: string;
	// Current page's language, and (if it exists) the URL of this same
	// page in the other language — e.g. an English page passes
	// translationHref="/ja/about/" and a Japanese page passes
	// translationHref="/about/". Left undefined on an English page with
	// no Japanese version yet (most case studies): the switcher then
	// shows "日本語" as plain, non-clickable text instead of a dead link.
	lang?: 'en' | 'ja';
	translationHref?: string;
}

const { title, lang = 'en', translationHref } = Astro.props;

const nav = lang === 'ja' ? { about: 'プロフィール', email: 'メール' } : { about: 'About', email: 'Email' };

// Resume PDF shown in the header and footer. One English PDF
// (public/resume.pdf) serves both language versions of the site.
const resume = { label: 'Resume', href: '/resume.pdf' };
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Inter: headings and UI chrome (nav, labels, tags, meta), and
		     now the homepage hero headline too (see .hero__headline) —
		     Fraunces, Bricolage Grotesque, and Space Grotesk were each
		     tried there in turn, but a dedicated display font for a
		     single headline wasn't worth the mismatch it created with
		     the rest of the site's typography, so the hero stays on
		     Inter at a larger size instead.
		     Montserrat: body/reading copy (--font-body in global.css) —
		     adopted sitewide after testing it on the Freedom Tax Japan
		     page against zouk.mx's body-text treatment. -->
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="page-padding site-header">
			<nav class="site-nav">
				<a href={lang === 'ja' ? '/ja/' : '/'}>YUI TANIYAMA</a>
				<div class="site-nav__links">
					<a href={lang === 'ja' ? '/ja/about/' : '/about'}>{nav.about}</a>
					{resume && <a href={resume.href} target="_blank" rel="noopener">{resume.label}</a>}
					<a href="mailto:taniyama.yu65709@gmail.com">{nav.email}</a>
					<a href="https://www.linkedin.com/in/yui-taniyama" target="_blank" rel="noopener">LinkedIn</a>
					<span class="site-nav__lang">
						{
							lang === 'ja' ? (
								<Fragment>
									<a href={translationHref}>English</a>
									<span aria-hidden="true">/</span>
									<span class="site-nav__lang-current">日本語</span>
								</Fragment>
							) : (
								<Fragment>
									<span class="site-nav__lang-current">English</span>
									<span aria-hidden="true">/</span>
									{translationHref ? (
										<a href={translationHref}>日本語</a>
									) : (
										<span class="site-nav__lang-current">日本語</span>
									)}
								</Fragment>
							)
						}
					</span>
				</div>
			</nav>
		</header>

		<script>
			// Measures the real header height (not hardcoded — the header's
			// own padding/type scale already vary slightly by breakpoint) so
			// sticky-header-aware offsets (anchor scroll-margin, the Section
			// Index's sticky `top`) stay correct without duplicating layout
			// values in two places.
			const header = document.querySelector('.site-header');
			if (header) {
				const setHeaderHeight = () => {
					document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
				};
				setHeaderHeight();
				window.addEventListener('resize', setHeaderHeight);
			}
		</script>

		<main class="page-padding">
			<slot />
		</main>

		<footer class="site-footer page-padding">
			{resume && <a href={resume.href} target="_blank" rel="noopener">{resume.label}</a>}
			<a href="mailto:taniyama.yu65709@gmail.com">{nav.email}</a>
			<a href="https://www.linkedin.com/in/yui-taniyama" target="_blank" rel="noopener">LinkedIn</a>
		</footer>
	</body>
</html>
