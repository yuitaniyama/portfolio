---
// Section 06 (hubstep case study) — Release 1 vs Release 2 of the
// staged transition. The image already explains both releases, so no
// paired caption copy here. Plain full-width treatment, same weight as
// the other supporting visual in this section.
import EnlargeableImage from '../EnlargeableImage.astro';

const ja = Astro.url.pathname.startsWith('/ja/');
---

<EnlargeableImage
	src="/section-06/staged-sfa-transition.png"
	alt={ja ? 'リリース1では、使い慣れたDMの作業をHomeに取り込む。リリース2では、ナビゲーションを磨き込み、SFAのためにDMのリストを表示する' : 'Release 1 brings familiar DM work into Home; Release 2 refines navigation and surfaces DM lists for SFA'}
/>
