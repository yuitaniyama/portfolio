---
// Section 08 (hubstep-foundation case study) — what Classic mode kept
// from the legacy system versus what it improved. Note: the source
// document's second bullet under each heading appears to carry
// duplicated text from the unrelated Product Forms cards earlier in the
// same document (a likely copy/paste artifact) — that fragment is
// intentionally left out here rather than guessed at or reproduced
// verbatim into the wrong context.
const groups = [
	{
		title: 'Preserved',
		items: ['The basic operating flow that existing address-management users were used to', 'How information is found, and list structure'],
	},
	{
		title: 'Improved',
		items: ['Ease of use of the UI', 'Handling of new system requirements'],
	},
];
---

<div class="pic-grid">
	{
		groups.map((g) => (
			<div class="pic-card" class:list={[g.title === 'Improved' && 'pic-card--improved']}>
				<div class="pic-card__title">{g.title}</div>
				<ul class="pic-card__list">
					{g.items.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</div>
		))
	}
</div>

<style>
	.pic-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-3);
	}

	.pic-card {
		padding: var(--space-4);
		border-radius: 10px;
		background: #fafafa;
	}

	.pic-card--improved {
		background: rgba(10, 126, 113, 0.06);
	}

	.pic-card__title {
		font-weight: 700;
	}

	.pic-card__list {
		margin: var(--space-2) 0 0;
		padding-left: 1.1em;
		font-size: var(--text-label);
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	@container (max-width: 640px) {
		.pic-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
