---
// Section 07 (hubstep-foundation case study) — live preview of the
// shipped hubstep Lite LP, embedded directly (not a screenshot) so a
// reader can scroll through the actual page in a generic, unbranded
// laptop + phone device mockup (hand-built with CSS shapes, no logos or
// brand-identifiable hardware details).
//
// Both frames render their iframe at a fixed intrinsic size (desktop:
// 1280x900, comfortably past the site's own ~768px mobile breakpoint;
// phone: 390x844, a standard modern phone viewport) and scale it down
// with a container-query-unit transform to fit whatever width the frame
// actually has — so each reliably shows the site's real desktop/mobile
// layout even when the frame itself renders narrow (e.g. this portfolio
// viewed on a phone). The viewport's aspect-ratio mirrors the iframe's
// intrinsic ratio, so the visible height scales down by the same factor
// as the width — no dead space, no cropping.
const ja = Astro.url.pathname.startsWith('/ja/');
const LP_URL = 'https://hubstep.jp/lite/';
---

<div class="llp">
	<div class="llp__frames">
		<div class="llp__mock llp__mock--laptop">
			<div class="llp__laptop-screen">
				<span class="llp__laptop-camera" />
				<div class="llp__viewport llp__viewport--desktop">
					<iframe class="llp__iframe" src={LP_URL} title={ja ? 'hubstep Lite LP — デスクトッププレビュー' : 'hubstep Lite LP — desktop preview'} loading="lazy" />
				</div>
			</div>
			<div class="llp__laptop-hinge" />
			<div class="llp__laptop-base" />
		</div>

		<div class="llp__mock llp__mock--phone">
			<div class="llp__phone-body">
				<span class="llp__phone-island" />
				<div class="llp__viewport llp__viewport--mobile">
					<iframe class="llp__iframe" src={LP_URL} title={ja ? 'hubstep Lite LP — モバイルプレビュー' : 'hubstep Lite LP — mobile preview'} loading="lazy" />
				</div>
			</div>
		</div>
	</div>
	<a class="llp__cta" href={LP_URL} target="_blank" rel="noopener noreferrer">
		{ja ? 'LPを見る' : 'View the LP'}
		<span aria-hidden="true">→</span>
	</a>
</div>

<style>
	.llp {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-6);
	}

	.llp__frames {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: var(--space-6);
		width: 100%;
	}

	/* Scale-to-fit viewport: aspect-ratio mirrors the iframe's intrinsic
	   size, so as this box's width shrinks to fit its frame, its height
	   shrinks by the same proportion the iframe is scaled down by below —
	   the scaled iframe always exactly fills it. */
	.llp__viewport {
		container-type: inline-size;
		overflow: hidden;
		position: relative;
		background: #ffffff;
	}

	.llp__viewport--desktop {
		aspect-ratio: 1280 / 900;
	}

	.llp__viewport--mobile {
		aspect-ratio: 390 / 844;
	}

	.llp__iframe {
		position: absolute;
		top: 0;
		left: 0;
		border: none;
	}

	.llp__viewport--desktop .llp__iframe {
		width: 1280px;
		height: 900px;
		transform-origin: top left;
		transform: scale(calc(100cqw / 1280px));
	}

	.llp__viewport--mobile .llp__iframe {
		width: 390px;
		height: 844px;
		transform-origin: top left;
		transform: scale(calc(100cqw / 390px));
	}

	/* Generic, unbranded laptop silhouette — dark screen bezel with a
	   camera dot, a thin hinge, and a light keyboard-deck base. No logos
	   or brand-identifiable hardware details. */
	.llp__mock--laptop {
		flex: 1.8 1 0;
		min-width: 0;
		max-width: 640px;
	}

	.llp__laptop-screen {
		position: relative;
		background: #2b2b2d;
		border-radius: 12px 12px 4px 4px;
		padding: 14px 14px 8px;
	}

	.llp__laptop-camera {
		position: absolute;
		top: 5px;
		left: 50%;
		transform: translateX(-50%);
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: #555;
	}

	.llp__laptop-hinge {
		height: 6px;
		background: #b7b7ba;
	}

	.llp__laptop-base {
		position: relative;
		height: 12px;
		background: linear-gradient(#d8d8db, #c7c7ca);
		border-radius: 0 0 8px 8px;
	}

	.llp__laptop-base::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 15%;
		height: 4px;
		background: #b3b3b6;
		border-radius: 0 0 5px 5px;
	}

	/* Generic, unbranded phone silhouette — dark bezel with a pill-shaped
	   camera cutout. No logos or brand-identifiable hardware details. */
	.llp__mock--phone {
		flex: none;
		width: 200px;
	}

	.llp__phone-body {
		position: relative;
		background: #2b2b2d;
		border-radius: 34px;
		padding: 12px;
		box-shadow: 0 0 0 1.5px #b7b7ba;
	}

	.llp__phone-island {
		position: absolute;
		top: 20px;
		left: 50%;
		transform: translateX(-50%);
		width: 34%;
		height: 16px;
		background: #2b2b2d;
		border-radius: 999px;
		z-index: 1;
	}

	.llp__viewport--mobile {
		border-radius: 22px;
	}

	.llp__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.75em 1.5em;
		border-radius: 999px;
		background: var(--color-text);
		color: #ffffff;
		font-weight: 600;
		font-size: var(--text-label);
		text-decoration: none;
		transition: opacity 150ms ease;
	}

	.llp__cta:hover,
	.llp__cta:focus-visible {
		opacity: 0.75;
	}

	@container (max-width: 640px) {
		.llp__frames {
			flex-direction: column;
			align-items: center;
		}

		.llp__mock--laptop {
			width: 100%;
			max-width: 420px;
		}
	}
</style>
