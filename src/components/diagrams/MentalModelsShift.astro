---
// Section 02 (hubstep case study) — a small "change" diagram, not another
// process flow: abstract discussion -> tangible hi-fidelity screens ->
// active discussion with a shared vision. Three columns: a visual on top,
// who is involved underneath. The middle visual is the real screens wall
// so readers can see what "hi-fidelity" meant here. One component serves
// both languages (chosen from the URL).
const ja = Astro.url.pathname.startsWith('/ja/');
const t = ja
	? {
			discussion: '抽象的な議論',
			screens: 'アイデアを\n高精度な画面へ',
			outcome: '議論が活発化\nビジョンが一致する',
			alt: 'hubstepのハイファイデザインの画面を並べた一覧',
			people: {
				stakeholders: 'ステークホルダー',
				sales: '営業チーム',
				cs: 'CSチーム',
				pdm: 'PdM',
				ux: 'UIUXデザイナー',
			},
		}
	: {
			discussion: 'Abstract discussion',
			screens: 'Ideas into\nhi-fidelity screens',
			outcome: 'Active discussion\nShared vision',
			alt: 'An overview of hubstep hi-fidelity screens laid out together',
			people: {
				stakeholders: 'Stakeholders',
				sales: 'Sales Team',
				cs: 'CS Team',
				pdm: 'PdM',
				ux: 'UIUX Designer',
			},
		};
const p = t.people;
const everyone = [p.stakeholders, p.sales, p.cs, p.pdm, p.ux];
---

<div class="ms">
	<div class="ms__row">
		<div class="ms__col">
			<div class="ms__visual ms__visual--loop">
				<svg class="ms__loop" viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M26 40a34 26 0 0 1 34-26 34 26 0 0 1 34 26" />
					<path d="M94 40a34 26 0 0 1-34 26 34 26 0 0 1-34-26" />
					<path d="M56 9l5 5-5 5" />
					<path d="M64 71l-5-5 5-5" />
				</svg>
				<p class="ms__label">{t.discussion}</p>
			</div>
			<ul class="ms__chips">
				{[p.stakeholders, p.sales, p.cs, p.pdm].map((c) => <li>{c}</li>)}
			</ul>
		</div>

		<div class="ms__arrow" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 12h16M14 6l6 6-6 6" />
			</svg>
		</div>

		<div class="ms__col">
			<div class="ms__visual ms__visual--image">
				<img src="/section-02/hifi-screens-overview.webp" alt={t.alt} width="2000" height="1138" loading="lazy" />
				<p class="ms__label ms__label--over">{t.screens}</p>
			</div>
			<ul class="ms__chips">
				<li>{p.ux}</li>
			</ul>
		</div>

		<div class="ms__arrow" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 12h16M14 6l6 6-6 6" />
			</svg>
		</div>

		<div class="ms__col">
			<div class="ms__visual ms__visual--outcome">
				<p class="ms__label">{t.outcome}</p>
			</div>
			<ul class="ms__chips">
				{everyone.map((c) => <li>{c}</li>)}
			</ul>
		</div>
	</div>
</div>

<style>
	.ms {
		container-type: inline-size;
		max-width: none;
		padding: 0;
	}

	.ms__row {
		display: grid;
		grid-template-columns: 1fr auto 1.35fr auto 1fr;
		column-gap: var(--space-2);
		align-items: start;
	}

	.ms__col {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		min-width: 0;
	}

	.ms__visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 140px;
	}

	.ms__label {
		position: relative;
		margin: 0;
		padding: 8px 12px;
		background: #fff;
		font-family: var(--font-heading);
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.35;
		text-align: center;
		white-space: pre-line;
		color: var(--color-text);
	}

	.ms__loop {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 100%;
		max-width: 150px;
		height: 100%;
		color: var(--color-text-muted);
	}

	.ms__visual--image {
		overflow: hidden;
		border-radius: 4px;
	}

	.ms__visual--image img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.ms__label--over {
		background: rgba(255, 255, 255, 0.92);
	}

	.ms__visual--outcome {
		border: 1px solid #c9c9c9;
		border-radius: 20px;
	}

	.ms__chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px;
	}

	.ms__chips li {
		padding: 3px 10px;
		border-radius: 999px;
		background: #efefef;
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-text);
	}

	.ms__arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 140px;
		color: var(--color-text-muted);
	}

	.ms__arrow svg {
		width: 22px;
		height: 22px;
	}

	@container (max-width: 640px) {
		.ms__row {
			grid-template-columns: 1fr;
			row-gap: var(--space-2);
		}

		.ms__visual {
			height: 112px;
		}

		.ms__arrow {
			height: auto;
			transform: rotate(90deg);
		}
	}
</style>
