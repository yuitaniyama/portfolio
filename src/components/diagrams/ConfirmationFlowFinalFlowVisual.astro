---
// Section 04 (hubstep-foundation case study) — the resulting end-to-end
// flow for confirming an address label. Originally built as an HTML step
// flow (numbered pill nodes); replaced with the designer's own flow
// diagram image once one was provided.
import EnlargeableImage from '../EnlargeableImage.astro';

const ja = Astro.url.pathname.startsWith('/ja/');
---

<EnlargeableImage
	src={ja ? '/hubstep-foundation/section-05/section05_design_flow_japanese.png' : '/hubstep-foundation/en/section-05/section05-final-flow.png'}
	alt={ja ? '宛先リストを確定するまでのフロー：宛先リストを開く、すべてのタブで全体像を確認、状態ごとの件数を把握、各タブで問題のあるリストを確認、必要な除外・確認を行う、解消済みの状態は警告が消える、確定ボタン有効化、宛先リストを確定' : 'End-to-end flow for confirming an address label: open the list, review all tabs, work through issues by status, handle required exclusions, then confirm and finalize'}
/>
