---
// Section 05 (hubstep-foundation case study) — recap pairing each
// structural problem with the corresponding solution in the redesigned
// List Upload flow, grouped into two columns (Problem / Solution) rather
// than repeating a "Problem" / "Solution" label on every row.
const problems = [
	{ title: 'Roles of different tasks were mixed together', detail: 'Operation, confirmation, and optional settings were collected into the same step.' },
	{ title: 'Hard to know what to do next', detail: 'Confirmation and operation ran together, making the next action hard to judge.' },
	{ title: 'Required checks were easy to miss', detail: 'Required confirmations and optional settings sat side by side on screen.' },
	{ title: 'Progress and completion were unclear', detail: 'Hard to tell current position, or how far there was left to go.' },
];

const solutions = [
	{ title: 'Reorganized around one goal per step', detail: 'The mixed handling was restructured into five goal-based steps.' },
	{ title: "Clarified each step's role", detail: 'Each screen was organized so what it\'s for is clear.' },
	{ title: 'Separated required actions from optional settings', detail: 'Required checks are prioritized; optional settings moved into their own step.' },
	{ title: 'Made progress and completion visible', detail: 'Step indicators and processing state show current position and what remains.' },
];
---

<div class="lurg-grid">
	<div class="lurg-group lurg-group--problem">
		<div class="lurg-group__label">Problem</div>
		{
			problems.map((item) => (
				<div class="lurg-card">
					<div class="lurg-card__title">{item.title}</div>
					<p class="lurg-card__detail">{item.detail}</p>
				</div>
			))
		}
	</div>
	<div class="lurg-group lurg-group--solution">
		<div class="lurg-group__label">Solution</div>
		{
			solutions.map((item) => (
				<div class="lurg-card">
					<div class="lurg-card__title">{item.title}</div>
					<p class="lurg-card__detail">{item.detail}</p>
				</div>
			))
		}
	</div>
</div>

<style>
	.lurg-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-3);
		align-items: start;
	}

	.lurg-group {
		padding: var(--space-4);
		border-radius: 14px;
		background: #ececec;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.lurg-group--solution {
		background: rgba(10, 126, 113, 0.08);
	}

	.lurg-group__label {
		font-size: 1.2em;
		font-weight: 500;
		color: var(--color-text-muted);
	}

	.lurg-group--solution .lurg-group__label {
		color: var(--color-accent);
	}

	.lurg-card {
		padding: var(--space-3);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.7);
	}

	.lurg-card__title {
		font-weight: 600;
		font-size: 0.95em;
	}

	.lurg-card__detail {
		margin: 0.4em 0 0;
		font-size: var(--text-label);
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	@container (max-width: 640px) {
		.lurg-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
