---
// Section 08 (hubstep-foundation case study) — post-launch adoption.
// Shown as rounded ratios and percentages only, never absolute case
// counts: the underlying figures are internal company data, so the page
// conveys the trend without revealing the business's scale. The trend
// chart is drawn relative to the Sep 2025 baseline (1×) for the same
// reason; the two endpoints are the only data points the source gives.
const ja = Astro.url.pathname.startsWith('/ja/');

const stats = [
	{ value: ja ? '約15倍' : '~15×', label: ja ? 'hubstepの案件数の伸び' : 'Growth in hubstep cases', detail: ja ? '2025年9月〜2026年9月' : 'Sep 2025 – Sep 2026', wide: true },
	{ value: ja ? '約60%' : '~60%', label: ja ? '全体の移行率' : 'Overall migration rate', detail: ja ? '2026年9月' : 'Sep 2026' },
	{ value: ja ? '約80%' : '~80%', label: ja ? 'DMNETの移行率' : 'DMNET migration rate', detail: ja ? '2026年9月' : 'Sep 2026' },
];

const growth = 15;
---

<div class="as-wrap">
	<div class="as-grid">
		{
			stats.map((s) => (
				<div class:list={['as-card', { 'as-card--wide': s.wide }]}>
					<div class="as-card__value">{s.value}</div>
					<div class="as-card__label">{s.label}</div>
					<div class="as-card__detail">{s.detail}</div>
				</div>
			))
		}
	</div>

	<div class="as-trend">
		<div class="as-trend__title">{ja ? '2025年9月を基準としたhubstepの案件数' : 'Hubstep cases relative to Sep 2025'}</div>
		<div class="as-trend__bars">
			<div class="as-trend__point">
				<div class="as-trend__bar" style={`height: ${100 / growth}%`} />
				<div class="as-trend__point-value">{ja ? '1倍' : '1×'}</div>
				<div class="as-trend__point-label">{ja ? '2025年9月' : 'Sep 2025'}</div>
			</div>
			<div class="as-trend__point">
				<div class="as-trend__bar as-trend__bar--end" style="height: 100%" />
				<div class="as-trend__point-value">{ja ? '約15倍' : '~15×'}</div>
				<div class="as-trend__point-label">{ja ? '2026年9月' : 'Sep 2026'}</div>
			</div>
		</div>
	</div>
</div>

<style>
	.as-wrap {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: var(--space-4);
		align-items: stretch;
	}

	.as-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-3);
	}

	.as-card {
		background: rgba(244, 255, 252, 0.6);
		border-radius: 10px;
		padding: var(--space-4);
	}

	.as-card--wide {
		grid-column: 1 / -1;
	}

	.as-card__value {
		font-size: var(--text-h3);
		font-weight: 700;
		line-height: 1.1;
	}

	.as-card__label {
		margin-top: var(--space-2);
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	.as-card__detail {
		margin-top: var(--space-1);
		font-size: var(--text-label);
		color: var(--color-text-muted);
		opacity: 0.75;
	}

	.as-trend {
		background: rgba(244, 255, 252, 0.6);
		border-radius: 10px;
		padding: var(--space-4);
		display: flex;
		flex-direction: column;
	}

	.as-trend__title {
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	.as-trend__bars {
		flex-grow: 1;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: var(--space-6);
		margin-top: var(--space-3);
		min-height: 120px;
	}

	.as-trend__point {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		height: 100%;
		width: 3rem;
	}

	.as-trend__bar {
		width: 100%;
		background: var(--color-border);
		border-radius: 4px 4px 0 0;
	}

	.as-trend__bar--end {
		background: var(--color-accent);
	}

	.as-trend__point-value {
		margin-top: var(--space-2);
		font-weight: 700;
	}

	.as-trend__point-label {
		margin-top: 0.2em;
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	@container (max-width: 640px) {
		.as-wrap {
			grid-template-columns: 1fr;
		}

		.as-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
