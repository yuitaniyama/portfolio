---
// Impact section (hubstep SFA case study), organized as two Problem /
// result rows so it mirrors the Problem and Result boxes at the top of the
// page: one row for the "before release" problem (design time saved) and
// one for the "after release" problem (the UI/UX issues worked on). Each
// row has a big number on the left and its explanation on the right.
// One component serves both languages (chosen from the URL).
const ja = Astro.url.pathname.startsWith('/ja/');

const t = ja
	? {
			p1Tag: 'Problem 1 — リリース前',
			p1Value: '約2か月',
			p1Label: 'PdMの見積もりによる、デザイン期間の短縮',
			p1Lead: 'ラピッドプロトタイピングが、初期のデザインフェーズを加速させた。',
			p1Body: '初期のワークフローを、Figma Makeで編集可能な画面にすることで、計画していたデザイン期間が約2か月短縮された。',
			p2Tag: 'Problem 2 — リリース後',
			p2Value: '45',
			p2Label: 'UI/UXの課題に対応',
			p2Items: [
				{ value: '28', label: 'リリース後の改善プロジェクト' },
				{ value: '14', label: '自ら見つけた課題' },
				{ value: '3', label: '業務フロー単位のUX改善' },
			],
			aside: '設計したページ・モーダルの状態：185（91ページ · 94モーダル）',
		}
	: {
			p1Tag: 'Problem 1 — Before release',
			p1Value: '~2 months',
			p1Label: 'Estimated design time saved, according to the PdM',
			p1Lead: 'Rapid prototyping accelerated the initial design phase.',
			p1Body: 'Turning early workflows into editable screens with Figma Make shortened the planned design timeline by ~2 months.',
			p2Tag: 'Problem 2 — After release',
			p2Value: '45',
			p2Label: 'UI/UX issues addressed',
			p2Items: [
				{ value: '28', label: 'post-launch improvement projects' },
				{ value: '14', label: 'issues I identified proactively' },
				{ value: '3', label: 'workflow-level UX improvements' },
			],
			aside: 'Pages & modal states designed: 185 (91 pages · 94 modal states)',
		};
---

<div class="impact">
	<section class="impact-row">
		<div class="impact-row__tag">{t.p1Tag}</div>
		<div class="impact-row__grid">
			<div class="impact-stat">
				<div class="impact-stat__value">{t.p1Value}</div>
				<div class="impact-stat__label">{t.p1Label}</div>
			</div>
			<div class="impact-text">
				<p class="impact-text__lead">{t.p1Lead}</p>
				<p class="impact-text__body">{t.p1Body}</p>
			</div>
		</div>
	</section>

	<section class="impact-row">
		<div class="impact-row__tag">{t.p2Tag}</div>
		<div class="impact-row__grid">
			<div class="impact-stat">
				<div class="impact-stat__value">{t.p2Value}</div>
				<div class="impact-stat__label">{t.p2Label}</div>
			</div>
			<dl class="impact-breakdown">
				{
					t.p2Items.map((item) => (
						<div class="impact-breakdown__item">
							<dt class="impact-breakdown__value">{item.value}</dt>
							<dd class="impact-breakdown__label">{item.label}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<p class="impact-aside">{t.aside}</p>
</div>

<style>
	.impact {
		container-type: inline-size;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.impact-row {
		padding: var(--space-4);
		background: rgba(244, 255, 252, 0.6);
		border-radius: 20px;
	}

	.impact-row__tag {
		font-family: var(--font-sans);
		font-size: var(--text-label);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.impact-row__grid {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: var(--space-6);
		align-items: center;
		margin-top: var(--space-3);
	}

	.impact-stat__value {
		font-family: var(--font-sans);
		font-size: clamp(2.5rem, 2rem + 2.5vw, 3.75rem);
		font-weight: 700;
		line-height: 1.05;
		color: #007e70;
	}

	.impact-stat__label {
		margin-top: var(--space-2);
		font-size: var(--text-label);
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.impact-text {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.impact-text p {
		margin: 0;
		line-height: 1.6;
	}

	.impact-text__lead {
		font-weight: 600;
		color: var(--color-text);
	}

	.impact-text__body {
		color: var(--color-text-muted);
	}

	.impact-breakdown {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.impact-breakdown__item {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
	}

	.impact-breakdown__value {
		flex: none;
		min-width: 3rem;
		font-family: var(--font-sans);
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.1;
		color: var(--color-text);
	}

	.impact-breakdown__label {
		margin: 0;
		line-height: 1.5;
		color: var(--color-text);
	}

	.impact-aside {
		margin: 0;
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	@container (max-width: 600px) {
		.impact-row__grid {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
	}
</style>
