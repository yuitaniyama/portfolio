---
// Section 08 (hubstep case study) — the closing reflection infographic
// (early stage → later stage). A conceptual diagram, not a product
// screenshot under inspection, so it renders plainly at full width with
// no expand icon or lightbox — just visible at a comfortable size.
import EnlargeableImage from '../EnlargeableImage.astro';

const ja = Astro.url.pathname.startsWith('/ja/');
---

<EnlargeableImage
	src="/section-08/design-role-evolution.png"
	alt={ja ? '初期：曖昧なアイデアを具体的にする。後期：成長するプロダクトを、ユーザーにとって一貫したものにする。' : 'Early stage: making an ambiguous idea tangible. Later stage: making a growing product coherent for users.'}
	enlargeable={false}
/>
