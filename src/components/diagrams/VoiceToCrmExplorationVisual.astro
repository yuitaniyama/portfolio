---
// Section 07 (hubstep case study) — the personal voice-to-CRM
// prototype flow: voice input, AI summary/proposed updates, human
// review and approval, reflection across hubstep. Wide, multi-step
// sequence, so it reuses the existing click-to-expand lightbox.
import EnlargeableImage from '../EnlargeableImage.astro';

const ja = Astro.url.pathname.startsWith('/ja/');
---

<EnlargeableImage
	src="/section-07/voice-to-crm-exploration.png"
	alt={ja ? '個人での探索：音声入力からAIによる要約、人によるレビューと承認を経て、hubstep全体に反映される' : 'Personal exploration: voice input to AI summary, human review and approval, then reflected across hubstep'}
/>
