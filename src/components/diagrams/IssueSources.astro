---
// Section 03 (hubstep case study) — the three places post-release
// issues surfaced from, exactly as stated in the surrounding prose:
// sales-team feedback, friction the designer noticed personally, and
// workflows grown more complex as the product expanded. Presented as
// three parallel, unordered boxes (a "Problem" label, an icon and one
// line each; no numbering, no sequence arrows) rather than a process —
// they happened at the same time, not in order. Same plain card look as
// the Problem / Result boxes in the case header.
import DiagramIcon from './DiagramIcon.astro';

const ja = Astro.url.pathname.startsWith('/ja/');

const sources = [
	{ icon: 'mail', text: ja ? '社内営業チームからのフィードバック' : 'Feedback from the internal sales team' },
	{ icon: 'activity', text: ja ? '自分自身がプロダクトを使う中で感じた使いにくさ' : 'Friction I noticed while using the product myself' },
	{ icon: 'analysis', text: ja ? 'hubstepがDMの枠を超えて拡張したことで複雑化したワークフロー' : 'Workflows that had grown more complex as hubstep expanded beyond DM' },
];
---

<div class="is-grid">
	{
		sources.map((s) => (
			<div class="is-item">
				<span class="is-item__tag">Problem</span>
				<DiagramIcon name={s.icon} />
				<p class="is-item__text">{s.text}</p>
			</div>
		))
	}
</div>

<style>
	.is-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
	}

	.is-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-4) var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 20px;
		box-shadow: 0 4px 16px -8px rgba(17, 17, 17, 0.12);
	}

	.is-item__tag {
		margin-bottom: var(--space-1);
		font-family: var(--font-sans);
		font-size: var(--text-label);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.is-item__text {
		margin: 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	@container (max-width: 640px) {
		.is-grid {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}
	}
</style>
