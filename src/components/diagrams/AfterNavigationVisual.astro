---
// Section 04 (hubstep case study) — the improved navigation in the
// redesigned product, under "Navigation". A detailed before/after
// annotated diagram, so it reuses the existing click-to-expand
// lightbox (same pattern as the flow map and user journeys) rather
// than the scroll-to-explore preview.
import EnlargeableImage from '../EnlargeableImage.astro';

const ja = Astro.url.pathname.startsWith('/ja/');
---

<EnlargeableImage
	src="/section-04/section04-after-navigation.png"
	alt={ja ? '再設計したAccount HomeとSales Dashboard / Sales Reportの間の、改善したナビゲーション' : 'Improved navigation between the redesigned Account Home and Sales Dashboard / Sales Report'}
/>
