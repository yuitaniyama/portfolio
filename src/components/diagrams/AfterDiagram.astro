---
// AFTER half of the DM -> SFA workflow diagram (hubstep case study).
// Split out from the combined DmToSfaDiagram so BEFORE and AFTER can be
// placed independently within the section's narrative. Visual design
// unchanged — this is a straight extraction.
import DiagramIcon from './DiagramIcon.astro';

const actionCards = [
	{ icon: 'mail', label: 'Direct Mail' },
	{ icon: 'phone', label: 'Call' },
	{ icon: 'plus', label: 'Other Actions' },
];

const contextCards = [
	{ icon: 'briefcase', label: 'Opportunities' },
	{ icon: 'check', label: 'TODO' },
	{ icon: 'activity', label: 'Activities' },
	{ icon: 'history', label: 'History' },
	{ icon: 'analysis', label: 'Analysis' },
	{ icon: 'arrow', label: 'Next Action' },
];
---

<div class="wf">
	<div class="wf-block">
		<div class="wf-label">After</div>
		<div class="wf-diagram wf-diagram--after">
			<div class="wf-card wf-card--source">
				<DiagramIcon name="clipboard" />
				<span>List / Contacts</span>
			</div>

			<div class="wf-stem" aria-hidden="true" />

			<div class="wf-branch">
				{
					actionCards.map((c) => (
						<div class="wf-card">
							<DiagramIcon name={c.icon} />
							<span>{c.label}</span>
						</div>
					))
				}
			</div>

			<div class="wf-stem" aria-hidden="true" />

			<div class="wf-branch">
				{
					contextCards.map((c) => (
						<div class="wf-card">
							<DiagramIcon name={c.icon} />
							<span>{c.label}</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</div>

<style>
	.wf {
		--card-w: 8rem;
		padding: var(--space-4) 0;
	}

	.wf-block {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.wf-label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: var(--space-3);
	}

	.wf-diagram {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.wf-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
		width: var(--card-w);
		padding: var(--space-2);
		border-radius: 6px;
		background: #fafafa;
		font-size: 0.875em;
		font-weight: 600;
		text-align: center;
		line-height: 1.3;
	}

	/* One connected conceptual model, read top to bottom — List/Contacts
	   -> ways to act -> broader sales context — not three independent
	   rows. Each transition is a single centered stem; each branch's
	   horizontal line spans ONLY from its first card's center to its
	   last card's center (never the full row width), with one short
	   tick per card. No arrows: conceptual groupings, not a literal
	   technical sequence. */
	.wf-diagram--after {
		flex-direction: column;
		align-items: center;
		gap: 0;
	}

	.wf-stem {
		width: 1px;
		height: 1.25rem;
		background: var(--color-border);
	}

	.wf-branch {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
		width: fit-content;
		max-width: 100%;
		margin-inline: auto;
	}

	.wf-branch::before {
		content: '';
		position: absolute;
		top: 0;
		left: calc(var(--card-w) / 2);
		right: calc(var(--card-w) / 2);
		height: 1px;
		background: var(--color-border);
	}

	.wf-branch > .wf-card {
		margin-top: 1.25rem;
	}

	.wf-branch > .wf-card::before {
		content: '';
		position: absolute;
		top: -1.25rem;
		left: 50%;
		width: 1px;
		height: 1.25rem;
		background: var(--color-border);
	}

	/* Below ~tablet width the branch lines can no longer land precisely
	   (cards start wrapping to a second row), so simplify: keep the
	   stems, drop the horizontal branch geometry, and let the cards
	   group by plain proximity instead. A container query (not a media
	   query) because the available width here is set by the Reading
	   Column, not the viewport. */
	@container (max-width: 860px) {
		.wf-branch::before,
		.wf-branch > .wf-card::before {
			display: none;
		}

		.wf-branch > .wf-card {
			margin-top: 0;
		}
	}

	@container (max-width: 640px) {
		.wf-card {
			width: 7rem;
			font-size: 0.8em;
		}
	}
</style>
