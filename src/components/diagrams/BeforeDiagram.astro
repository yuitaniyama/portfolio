---
// BEFORE half of the DM -> SFA workflow diagram (hubstep case study).
// Split out from the combined DmToSfaDiagram so BEFORE and AFTER can be
// placed independently within the section's narrative. Visual design
// unchanged — this is a straight extraction.
import DiagramIcon from './DiagramIcon.astro';
---

<div class="wf">
	<div class="wf-block">
		<div class="wf-label">Before</div>
		<div class="wf-diagram wf-diagram--before">
			<div class="wf-card">
				<DiagramIcon name="clipboard" />
				<span>List</span>
			</div>
			<div class="wf-connector" />
			<div class="wf-card">
				<DiagramIcon name="mail" />
				<span>Direct Mail</span>
			</div>
			<div class="wf-connector" />
			<div class="wf-card">
				<DiagramIcon name="analysis" />
				<span>Result</span>
			</div>
		</div>
	</div>
</div>

<style>
	.wf {
		padding: var(--space-4) 0;
	}

	.wf-block {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.wf-label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: var(--space-3);
	}

	.wf-diagram {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.wf-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
		width: 8rem;
		padding: var(--space-2);
		border-radius: 6px;
		background: #fafafa;
		font-size: 0.875em;
		font-weight: 600;
		text-align: center;
		line-height: 1.3;
	}

	.wf-connector {
		width: 2rem;
		height: 1px;
		background: var(--color-border);
		flex: 0 0 auto;
		margin: 0 var(--space-2);
	}

	@container (max-width: 640px) {
		.wf-diagram--before {
			flex-direction: column;
		}

		.wf-diagram--before .wf-connector {
			width: 1px;
			height: 1.25rem;
			flex: 0 0 auto;
			margin: var(--space-1) 0;
		}

		.wf-card {
			width: 7rem;
			font-size: 0.8em;
		}
	}
</style>
