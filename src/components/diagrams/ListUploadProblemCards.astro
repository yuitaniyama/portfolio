---
// Section 05 (hubstep-foundation case study) — the three structural
// problems with the original 3-step List Upload flow, mirroring the
// three-item, unordered layout used for IssueSources.astro elsewhere.
import DiagramIcon from './DiagramIcon.astro';

const ja = Astro.url.pathname.startsWith('/ja/');

const problems = [
	{
		icon: 'layers',
		title: ja ? '性質の異なる作業が混在していた' : 'Roles of different tasks were mixed together',
		text: ja ? '操作・確認・任意の設定が同じステップに集まり、多くの判断を一度に迫られることが多かった。' : 'Operation, confirmation, and optional settings collected in the same step, often forcing a decision all at once.',
	},
	{
		icon: 'list',
		title: ja ? '情報の優先度が不明確だった' : 'Priority of information was unclear',
		text: ja ? '画面上で、次に何を確認し、何に対応すべきかを判断しづらかった。' : 'Hard to judge on-screen what to check or act on next.',
	},
	{
		icon: 'help-circle',
		title: ja ? 'ガイダンスが不足していた' : 'Guidance was insufficient',
		text: ja ? '今どこにいて、次に何をすればよいのかが分かりづらかった。' : 'Where you were, and what to do next, was hard to understand.',
	},
];
---

<div class="lupc-grid">
	{
		problems.map((p) => (
			<div class="lupc-item">
				<DiagramIcon name={p.icon} />
				<div class="lupc-item__title">{p.title}</div>
				<p class="lupc-item__text">{p.text}</p>
			</div>
		))
	}
</div>

<style>
	.lupc-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
	}

	.lupc-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-3);
		background: #fafafa;
		border-radius: 10px;
	}

	.lupc-item__title {
		font-weight: 600;
		font-size: 0.95em;
	}

	.lupc-item__text {
		margin: 0;
		font-size: var(--text-label);
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	@container (max-width: 640px) {
		.lupc-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
