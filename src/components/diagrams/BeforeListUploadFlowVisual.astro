---
// Section 05 (hubstep case study) — the existing six-step List Upload
// flow before the redesign, with the friction identified at each step.
// A wide, detail-dense flow diagram, so it reuses the existing
// click-to-expand lightbox and gets full Reading Column width rather
// than being shrunk to fit.
import EnlargeableImage from '../EnlargeableImage.astro';

const ja = Astro.url.pathname.startsWith('/ja/');
---

<EnlargeableImage
	src="/section-05/before-list-upload-flow.png"
	alt={ja ? '既存の6ステップのリスト登録フロー。各ステップで見つかった摩擦を示している' : 'Existing six-step List Upload flow, with friction identified at each step'}
/>
