---
// Shared case study header: eyebrow → title → optional short description
// → meta row → divider → intro. Used by every case study page so the
// hero structure, meta grid and type scale stay one system. Meta
// categories differ per project (passed in as label/value pairs); only
// facts that exist in that project's content should be listed.
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	titleNote?: string;
	meta: { label: string; value: string }[];
	intro: string[];
}

const { eyebrow, title, description, titleNote, meta, intro } = Astro.props;
---

<p class="case-eyebrow">{eyebrow}</p>
<h1>{title}</h1>
{titleNote && <p class="case-title-note">{titleNote}</p>}
{description && <p class="case-description">{description}</p>}

{
	meta.length > 0 && (
		<div class="case-meta">
			{meta.map((m) => (
				<div>
					<div class="case-meta__label">{m.label}</div>
					<div class="case-meta__value">{m.value}</div>
				</div>
			))}
		</div>
	)
}

<div class="prose case-body case-intro">
	{intro.map((p) => <p>{p}</p>)}
</div>

<style>
	.case-eyebrow {
		margin: var(--space-3) 0 var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	/* Reuses the existing `.prose h3` style (body size, 600, 1.3) —
	   no subtitle-specific size. */
	.case-description {
		margin: var(--space-2) 0 0;
		max-width: var(--measure);
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	.case-title-note {
		margin-top: var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		font-style: italic;
	}
</style>
