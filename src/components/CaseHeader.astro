---
// Shared case study header: eyebrow → title → optional short description
// → Project Intro block (Project Info + lead copy). Used by every case
// study page so the hero structure, project-info/intro grid and type
// scale stay one system. Meta categories differ per project (passed in
// as label/value pairs); only facts that exist in that project's
// content should be listed.
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	titleNote?: string;
	meta: { label: string; value: string }[];
	intro: string[];
	lang?: 'en' | 'ja';
}

const { eyebrow, title, description, titleNote, meta, intro, lang = 'en' } = Astro.props;
const projectInfoLabel = lang === 'ja' ? 'プロジェクト情報' : 'Project Info';

// A meta value listing several items uses " · " as its delimiter (e.g.
// Focus: "UI/UX Design · Design Systems · Product Communication") — split
// those into their own lines so a multi-item value reads as a short
// vertical list under its label, instead of one run-on sentence.
const metaRows = meta.map((m) => ({ label: m.label, values: m.value.split(' · ') }));
---

<p class="case-eyebrow">{eyebrow}</p>
<h1>{title}</h1>
{titleNote && <p class="case-title-note">{titleNote}</p>}
{description && <p class="case-description">{description}</p>}

<div class="case-intro-grid">
	{
		metaRows.length > 0 && (
			<div class="case-project-info">
				<div class="case-project-info__heading">{projectInfoLabel}</div>
				<dl class="case-project-info__list">
					{metaRows.map((m) => (
						<div class="case-project-info__item">
							<dt class="case-project-info__label">{m.label}</dt>
							{m.values.map((v) => (
								<dd class="case-project-info__value">{v}</dd>
							))}
						</div>
					))}
				</dl>
			</div>
		)
	}

	<div class="prose case-intro">
		{intro.map((p) => <p>{p}</p>)}
	</div>
</div>

<style>
	.case-eyebrow {
		margin: var(--space-3) 0 var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	/* Reuses the existing `.prose h3` style (body size, 600, 1.3) —
	   no subtitle-specific size. */
	.case-description {
		margin: var(--space-2) 0 0;
		max-width: var(--measure);
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	.case-title-note {
		margin-top: var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		font-style: italic;
	}
</style>
