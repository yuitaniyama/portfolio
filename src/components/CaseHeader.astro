---
// Shared case study header: eyebrow → title → optional short description
// → Project Intro block (Project Info + lead copy). Used by every case
// study page so the hero structure, project-info/intro grid and type
// scale stay one system. Meta categories differ per project (passed in
// as label/value pairs); only facts that exist in that project's
// content should be listed.
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	titleNote?: string;
	meta: { label: string; value: string }[];
	intro: string[];
	// Optional "box" summary of the project's core problems; rendered
	// right after the first intro paragraph, which should end by
	// introducing them (e.g. "...two different design challenges:").
	challenges?: { tag: string; label: string; heading: string; body: string; linkLabel?: string; href?: string }[];
	lang?: 'en' | 'ja';
}

const { eyebrow, title, description, titleNote, meta, intro, challenges, lang = 'en' } = Astro.props;
const projectInfoLabel = lang === 'ja' ? 'プロジェクト情報' : 'Project Info';

// A meta value listing several items uses " · " as its delimiter (e.g.
// Focus: "UI/UX Design · Design Systems · Product Communication") — split
// those into their own lines so a multi-item value reads as a short
// vertical list under its label, instead of one run-on sentence.
const metaRows = meta.map((m) => ({ label: m.label, values: m.value.split(' · ') }));
---

<p class="case-eyebrow">{eyebrow}</p>
<h1>{title}</h1>
{titleNote && <p class="case-title-note">{titleNote}</p>}
{description && <p class="case-description">{description}</p>}

<div class="case-intro-grid">
	{
		metaRows.length > 0 && (
			<div class="case-project-info">
				<div class="case-project-info__heading">{projectInfoLabel}</div>
				<dl class="case-project-info__list">
					{metaRows.map((m) => (
						<div class="case-project-info__item">
							<dt class="case-project-info__label">{m.label}</dt>
							{m.values.map((v) => (
								<dd class="case-project-info__value">{v}</dd>
							))}
						</div>
					))}
				</dl>
			</div>
		)
	}

	<div class="prose case-intro">
		{
			intro.map((p, i) => (
				<Fragment>
					<p>{p}</p>
					{i === 0 && challenges && challenges.length > 0 && (
						<div class="case-challenges">
							{challenges.map((c) => (
								<div class="case-challenge">
									<div class="case-challenge__tag">
										<span class="case-challenge__num">{c.tag}</span>
										<span class="case-challenge__label">{c.label}</span>
									</div>
									<h3 class="case-challenge__heading">{c.heading}</h3>
									<p class="case-challenge__body">{c.body}</p>
									{c.href && c.linkLabel ? (
										<a class="case-challenge__link" href={c.href}>
											{c.linkLabel} <span aria-hidden="true">→</span>
										</a>
									) : (
										<span />
									)}
								</div>
							))}
						</div>
					)}
				</Fragment>
			))
		}
	</div>
</div>

<style>
	.case-eyebrow {
		margin: var(--space-3) 0 var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	/* Reuses the existing `.prose h3` style (body size, 600, 1.3) —
	   no subtitle-specific size. */
	.case-description {
		margin: var(--space-2) 0 0;
		max-width: var(--measure);
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	/* Core-problem boxes in the intro — same plain card vocabulary as the
	   Freedom Tax Japan research-synthesis cards (hairline border, soft
	   radius, tag / colored heading / muted body / small footer line),
	   with hubstep's teal for the heading. Rows are shared via subgrid so
	   the headings and bodies line up across both cards. Font sizes are
	   explicit because the intro copy around them is set larger. */
	.case-challenges {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: auto auto auto auto;
		column-gap: var(--space-4);
		margin-top: var(--space-4);
	}

	.case-challenge {
		display: grid;
		grid-template-rows: subgrid;
		grid-row: 1 / -1;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 20px;
		box-shadow: 0 4px 16px -8px rgba(17, 17, 17, 0.12);
	}

	.case-challenge__tag {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
	}

	.case-challenge__num {
		color: var(--color-text-muted);
	}

	.case-challenge__label {
		text-transform: uppercase;
		font-weight: 700;
		color: var(--color-text);
	}

	.case-challenge__heading {
		margin: var(--space-2) 0 0;
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
		color: #007e70;
	}

	.case-challenge__body {
		margin: var(--space-2) 0 0;
		font-size: 1rem;
		line-height: 1.75;
		color: var(--color-text-muted);
	}

	.case-challenge__link {
		margin-top: var(--space-3);
		font-family: var(--font-sans);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
		line-height: 1.5;
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.case-challenge__link:hover,
	.case-challenge__link:focus-visible {
		color: var(--color-text);
	}

	@media (max-width: 640px) {
		.case-challenges {
			grid-template-columns: 1fr;
			grid-template-rows: none;
			row-gap: var(--space-3);
		}

		.case-challenge {
			grid-template-rows: auto;
			grid-row: auto;
		}
	}

	.case-title-note {
		margin-top: var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		font-style: italic;
	}
</style>
