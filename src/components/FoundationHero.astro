---
// Hero for the hubstep-foundation case study — a single finished
// composition (designed by the user in Figma), not a layered/live
// build like HubstepHero. Same "no in-graphic caption" rule: the page's
// own <h1> below carries the title.

const ja = Astro.url.pathname.startsWith('/ja/');
---

<img
	class="fh"
	src="/hubstep-foundation/hero/hero.png"
	alt={ja ? 'hubstepのプロダクト画面と、hubstep LiteのLP（デスクトップとモバイル）' : 'hubstep product screen alongside the hubstep Lite LP (desktop and mobile)'}
	width="6000"
	height="2928"
	loading="eager"
	decoding="async"
/>

<style>
	.fh {
		width: 100%;
		height: auto;
		display: block;
		margin-top: var(--space-3);
		margin-bottom: var(--space-6);
	}
</style>
