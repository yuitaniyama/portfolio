				context: 'ポータルと入力フローを、より詳しく確認したユーザー。',
				reacted:
					'フィールドの形式、命名ルール、所得の区分で迷っており、より明確な例、補助テキスト、ガイド付きの入力パターンがあれば助かっただろう。',
				revealed: '現実の状況をプロダクトの構造に当てはめなければならない場面で、ポータルの体験にはより多くのサポートが必要だった。',
			},
		],
	},
	learnings: [
		{
			title: 'ソリューションの前に、リサーチ',
			body: '競合調査は、解決策を議論する前に、チームに共通の出発点を与えてくれた。',
		},
		{
			title: 'テストは、レビューが見逃すものを明らかにする',
			body: 'ユーザビリティテストは、社内のデザインレビューだけでは気づきにくい混乱を明らかにした。',
		},
		{
			title: 'デザインは協働である',
			body: 'シニアデザイナーと働く中で、プロダクトデザインを個人の作業として扱わず、アイデアで貢献する方法を学んだ。',
		},
	],
	pager: {
		prev: { label: '前のケーススタディ', title: '成長するhubstepの一貫性を保つ', href: '/ja/work/hubstep-foundation/' },
		next: {
			label: '次のケーススタディ（英語版）',
			title: "Translating Yoshitaka Amano's World into Wearable Products",
			href: '/work/amano-graniph/',
		},
	},
};

const c = ja ? JA : EN;
const translationHref = ja ? '/work/freedom-tax-japan/' : '/ja/work/freedom-tax-japan/';

// Merge the shared image data (file / size / layout) with the per-language text.
const designExamples = c.examples.map((ex, i) => ({
	...ex,
	gridLayout: exampleImages[i].gridLayout,
	steps: ex.steps.map((step, j) => ({
		...step,
		images: exampleImages[i].steps[j].map((img, k) => ({ ...img, label: step.labels[k] })),
	})),
}));

const participants = c.testing.participants.map((p, i) => ({ ...p, photo: participantPhotos[i] }));
---

<BaseLayout title={c.pageTitle} lang={lang} translationHref={translationHref}>
	<article class="content-grid">
		<CaseHeader
			eyebrow={c.eyebrow}
			title={c.title}
			description={c.description}
			meta={c.meta}
			intro={c.intro}
			lang={lang}
		/>

		<div class="ftj-hero">
			<img
				class="ftj-hero__img"
				src="/freedom-tax-japan/hero/hero2.png"
				alt={c.heroAlt}
				width="3200"
				height="2400"
				loading="eager"
				decoding="async"
			/>
		</div>

		<div class="case-study-body">
			<nav class="case-index" aria-label="Case study sections">
				<div class="case-index__eyebrow">{c.indexLabel}</div>
				<ol>
					{
						c.sections.map((s) => (
							<li>
								<a href={`#${s.id}`}>{s.title}</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="case-sections">
				<!-- 01 OUTCOME -->
				<section id="outcome" class="case-section">
					<div class="section-eyebrow">{c.sections[0].eyebrow}</div>
					<h2>{c.sections[0].title}</h2>

					<dl class="ftj-stats">
						{
							c.outcomes.map((o) => (
								<div class="ftj-stat">
									<dt class="ftj-stat__value">{o.value}</dt>
									<dd class="ftj-stat__label">{o.label}</dd>
								</div>
							))
						}
					</dl>

					<div class="prose">
						<p set:html={c.outcomeText} />
					</div>

					<ScrollableProductPreview
						src="/freedom-tax-japan/outcome/final-landing-page.png"
						alt={c.finalLanding.alt}
						label={c.finalLanding.label}
						height={480}
					/>
				</section>

				<!-- 02 RESEARCH -->
				<section id="research" class="case-section">
					<div class="section-eyebrow">{c.sections[1].eyebrow}</div>
					<h2>{c.sections[1].title}</h2>

					<figure class="ftj-audit">
						<EnlargeableImage
							src="/freedom-tax-japan/research/competitive-audit.png"
							alt={c.research.auditAlt}
							enlargeable={false}
						/>
						<figcaption class="ftj-audit__caption">{c.research.auditCaption}</figcaption>
					</figure>

					<div class="ftj-research-row">
						<figure class="ftj-research-row__visual">
							<EnlargeableImage
								src="/freedom-tax-japan/research/app-competitive-audit.png"
								alt={c.research.appAlt}
								enlargeable={false}
							/>
							<figcaption class="ftj-audit__caption">{c.research.appCaption}</figcaption>
						</figure>
						<div class="prose ftj-research-row__text">
							{c.research.text.map((p) => <p set:html={p} />)}
						</div>
					</div>

					<div class="ftj-synthesis">
						<div class="section-eyebrow">{c.synthesis.eyebrow}</div>
						<h3 class="ftj-synthesis__heading">{c.synthesis.heading}</h3>
						<div class="prose">
							<p set:html={c.synthesis.text} />
						</div>

						<div class="ftj-synthesis__grid">
							{
								c.synthesis.items.map((item) => (
									<div class="ftj-synthesis__item">
										<div class="ftj-synthesis__tag">
											<span class="ftj-synthesis__num">{item.num}</span>
											<span class="ftj-synthesis__label">{item.label}</span>
										</div>
										<h4 class="ftj-synthesis__item-heading">{item.heading}</h4>
										<p class="ftj-synthesis__body" set:html={item.body} />
										<p class="ftj-synthesis__keywords" set:html={item.keywords} />
									</div>
								))
							}
						</div>
					</div>
				</section>

				<!-- 03 DESIGN EXPLORATION -->
				<section id="design-exploration" class="case-section">
					<div class="section-eyebrow">{c.sections[2].eyebrow}</div>
					<h2>{c.sections[2].title}</h2>

					<div class="prose">
						<p>{c.designIntro}</p>
					</div>

					<div class="ftj-examples">
						{
							designExamples.map((example) => (
								<div class="ftj-example">
									<div class="section-eyebrow">{example.eyebrow}</div>
									<h3 class="ftj-example__heading">{example.heading}</h3>

									<div class="prose">
										{example.body.map((p) => (
											<p set:html={p} />
										))}
									</div>

									{example.gridLayout ? (
										<div class="ftj-steps-grid">
											{example.steps.map((step, i) => (
												<figure
													class:list={[
														'ftj-steps-grid__item',
														i === example.steps.length - 1 && example.steps.length % 2 !== 0 && 'ftj-steps-grid__item--full',
													]}
												>
													<div class="section-eyebrow">
														{String(i + 1).padStart(2, '0')} — {step.tag}
													</div>
													<div class="ftj-steps__images">
														{step.images.map((image) => (
															<img
																class="ftj-steps__img"
																src={`/freedom-tax-japan/design-exploration/${image.file}.png`}
																alt={image.label}
																width={image.width}
																height={image.height}
																loading="lazy"
																decoding="async"
															/>
														))}
													</div>
													{step.caption && <figcaption class="ftj-audit__caption">{step.caption}</figcaption>}
												</figure>
											))}
										</div>
									) : (
										<div class="ftj-steps">
											{example.steps.map((step, i) => (
												<figure class="ftj-steps__step">
													<div class="section-eyebrow">
														{String(i + 1).padStart(2, '0')} — {step.tag}
													</div>
													<div class="ftj-steps__images">
														{step.images.map((image) => (
															<img
																class="ftj-steps__img"
																src={`/freedom-tax-japan/design-exploration/${image.file}.png`}
																alt={image.label}
																width={image.width}
																height={image.height}
																loading="lazy"
																decoding="async"
															/>
														))}
													</div>
													{step.caption && <figcaption class="ftj-audit__caption">{step.caption}</figcaption>}
												</figure>
											))}
										</div>
									)}
								</div>
							))
						}
					</div>
				</section>

				<!-- 04 USABILITY TESTING (strongest section) -->
				<section id="usability-testing" class="case-section ftj-testing">
					<div class="section-eyebrow">{c.sections[3].eyebrow}</div>
					<h2>{c.sections[3].title}</h2>

					<div class="prose">
						{c.testing.text.map((p) => <p>{p}</p>)}
					</div>

					<EnlargeableImage
						src="/freedom-tax-japan/usability-testing/usability-testing-documentation.png"
						alt={c.testing.boardAlt}
						enlargeable={false}
					/>

					<div class="ftj-setup">
						<div class="ftj-setup__label">{c.testing.setupLabel}</div>
						<ul>
							{c.testing.setup.map((s) => <li>{s}</li>)}
						</ul>
					</div>

					<div class="ftj-insights-head">{c.testing.insightsHead}</div>
					<div class="ftj-insights">
						{
							participants.map((p) => (
								<article class="ftj-insight">
									<img
										class="ftj-avatar"
										src={`/freedom-tax-japan/usability-testing/${p.photo}.jpg`}
										alt=""
										width="120"
										height="120"
										loading="lazy"
										decoding="async"
									/>
									<h3 class="ftj-insight__name">{p.name}</h3>
									<dl>
										<dt>{c.testing.dt.context}</dt>
										<dd>{p.context}</dd>
										<dt>{c.testing.dt.reacted}</dt>
										<dd>{p.reacted}</dd>
										<dt>{c.testing.dt.revealed}</dt>
										<dd class="ftj-insight__revealed">{p.revealed}</dd>
									</dl>
								</article>
							))
						}
					</div>
				</section>

				<!-- 05 LEARNING -->
				<section id="learning" class="case-section">
					<div class="section-eyebrow">{c.sections[4].eyebrow}</div>
					<h2>{c.sections[4].title}</h2>

					<ol class="ftj-learnings">
						{
							c.learnings.map((l, i) => (
								<li>
									<div class="ftj-learnings__num">{String(i + 1).padStart(2, '0')}</div>
									<div class="ftj-learnings__title">{l.title}</div>
									<p class="ftj-learnings__body">{l.body}</p>
								</li>
							))
						}
					</ol>
				</section>
			</div>
		</div>

		<nav class="ftj-pager" aria-label="Case study navigation">
			<a href={c.pager.prev.href}>
				<span class="ftj-pager__label">{c.pager.prev.label}</span>
				<span class="ftj-pager__title">{c.pager.prev.title}</span>
			</a>
			<a href={c.pager.next.href} class="ftj-pager__next">
				<span class="ftj-pager__label">{c.pager.next.label}</span>
				<span class="ftj-pager__title">{c.pager.next.title}</span>
			</a>
		</nav>
	</article>
</BaseLayout>

<style>
	/* FTJ's own reserved accent (sampled from the product's brand blue,
	   same reasoning as the hubstep teal via --color-accent in
	   global.css) for the active Section Index item — kept local to
	   this page rather than promoted to a shared token, since it's a
	   per-case-study brand color, not a sitewide one. */
	.case-index a.is-active {
		color: #0496ce;
	}

	.ftj-hero {
		margin-top: var(--space-6);
	}

	/* hero2.png is 4:3 (a screen-collage composite, not a 16:9 banner like
	   the hubstep heroes). Run it full-bleed at that ratio and it reads
	   noticeably taller/heavier than the other case studies' hero bands —
	   capping its width (rather than cropping the image) keeps its
	   rendered height in the same neighborhood without forcing an exact
	   ratio match. */
	.ftj-hero__img {
		display: block;
		width: 100%;
		max-width: 44rem;
		height: auto;
		margin-inline: auto;
	}

	/* Vertical rhythm inside a section: heading, then blocks spaced evenly. */
	.case-section > :global(* + *) {
		margin-top: var(--space-4);
	}

	.case-section > h2 + :global(*) {
		margin-top: var(--space-4);
	}

	/* Outcome stats — 2×2, hairline separators instead of cards. */
	.ftj-stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		margin-bottom: 0;
		border-top: 1px solid var(--color-border);
	}

	.ftj-stat {
		padding: var(--space-3) var(--space-3) var(--space-3) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.ftj-stat__value {
		font-size: var(--text-h2);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: #154384;
	}

	.ftj-stat__label {
		margin: var(--space-1) 0 0;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.9em;
		line-height: 1.75;
	}

	/* Research: the competitive-audit visual, enlargeable since its value
	   is in showing the breadth of the audit, not being legible inline
	   at full width (per EnlargeableImage's existing lightbox pattern). */
	.ftj-audit__caption {
		margin: var(--space-2) 0 0;
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	/* App audit sits beside its own explanation rather than stacking as
	   a second full-width hero image — reads as an extension of the
	   research (smaller, paired with text) rather than competing with
	   the Desktop audit above. ~52/48 split, with a wide gap standing
	   in for "generous whitespace between them". */
	.ftj-research-row {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: var(--space-8);
		align-items: center;
		margin-top: var(--space-8);
	}

	.ftj-research-row__visual {
		margin: 0;
	}

	.ftj-research-row__text {
		max-width: none;
	}

	/* Research synthesis — two findings the audit narrowed the redesign
	   to. Deliberately plain (hairline + numbering, no card chrome) to
	   stay editorial rather than reading as a UI component. */
	.ftj-synthesis {
		margin-top: var(--space-8);
	}

	.ftj-synthesis__heading {
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	/* Card grid: rows are shared via subgrid, so each row (tag / heading /
	   body / keywords) takes the height of whichever card needs more —
	   the shorter card's cells stretch to match, which is what keeps the
	   heading block and the keywords line aligned across both cards
	   regardless of copy length, without hardcoding any heights. */
	.ftj-synthesis__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: auto auto auto auto;
		column-gap: var(--space-6);
		margin-top: var(--space-4);
	}

	.ftj-synthesis__item {
		display: grid;
		grid-template-rows: subgrid;
		grid-row: 1 / -1;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 20px;
		box-shadow: 0 4px 16px -8px rgba(17, 17, 17, 0.12);
	}

	.ftj-synthesis__tag {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
	}

	.ftj-synthesis__num,
	.ftj-learnings__num {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.ftj-synthesis__label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
	}

	.ftj-synthesis__item-heading {
		/* h4 isn't covered by global.css's h1/h2/h3 margin reset, so its
		   UA default margin-bottom (~1em) was adding extra space here on
		   top of the next element's own margin-top — reset it explicitly. */
		margin: var(--space-2) 0 0;
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
		color: #154384;
	}

	.ftj-synthesis__body {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.9em;
		line-height: 1.75;
	}

	.ftj-synthesis__body strong {
		font-weight: 600;
	}

	.ftj-synthesis__keywords {
		margin-top: var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	/* Design exploration: each example gets generous room to breathe
	   (space-editorial-ish gap) since the visuals carry the story and
	   shouldn't feel cramped together. */
	.ftj-examples {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
	}

	.ftj-insights-head,
	.ftj-setup__label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.ftj-example__heading {
		margin-top: var(--space-2);
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	/* Flexbox rather than a fixed-column grid so a 2-step (exploration →
	   implemented) and a 3-step (before → reference → implemented)
	   example both lay out correctly without separate markup. */
	.ftj-steps {
		display: flex;
		align-items: flex-start;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.ftj-steps__step {
		flex: 1;
		min-width: 0;
		margin: 0;
	}

	.ftj-steps__step .section-eyebrow {
		margin-bottom: var(--space-2);
	}

	/* Real screenshots, not a uniform placeholder box — each renders at
	   its own natural aspect ratio (no crop/distortion), so steps in the
	   same row can end at different heights when their source images
	   have different proportions. */
	.ftj-steps__img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* A step can hold more than one image (Example 03's "Exploration"
	   step shows two directions explored before the team converged) —
	   stacked in place rather than spilling into their own columns, so
	   they still read as one step in the Before/Exploration/Implemented
	   sequence rather than a whole extra step. */
	.ftj-steps__images {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	/* Example 01 only: 2x2 editorial grid instead of a single row, so
	   four screens can run much larger. No arrows — numbering + the
	   existing eyebrow label style (reused as-is, not a new type style)
	   carry the sequence instead of a process-diagram feel. */
	.ftj-steps-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: var(--space-6);
		row-gap: var(--space-8);
		margin-top: var(--space-4);
	}

	.ftj-steps-grid__item {
		margin: 0;
	}

	/* A lone item in the last row (odd step count, e.g. Example 02's
	   3-step Before/My proposal/Implemented) spans both columns instead
	   of sitting half-width with an empty cell beside it — reads as the
	   result the other two lead up to, not a leftover. */
	.ftj-steps-grid__item--full {
		grid-column: 1 / -1;
	}

	.ftj-steps-grid__item--full .ftj-steps__images {
		max-width: 60%;
	}

	.ftj-steps-grid__item .section-eyebrow {
		margin-bottom: var(--space-2);
	}

	/* Usability testing: the heaviest section — bigger heading, more air,
	   a tinted band for the setup summary, larger participant blocks. */
	.ftj-testing {
		margin-top: calc(var(--space-editorial) * 1.15);
	}

	.case-section.ftj-testing > h2 {
		font-size: var(--text-h2);
	}

	.ftj-setup {
		padding: var(--space-3) 0;
		border-top: 1px solid var(--color-text);
		border-bottom: 1px solid var(--color-border);
	}

	.ftj-setup ul {
		list-style: none;
		margin: var(--space-2) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
		font-weight: 600;
		font-size: 0.9em;
	}

	.ftj-insights-head {
		margin-top: var(--space-8);
	}

	.ftj-insights {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-8) var(--space-4);
	}

	.case-section > .ftj-insights {
		margin-top: var(--space-3);
	}

	/* Anonymized-participant avatar — a generic themed photo, not a
	   portrait of the actual person, cropped to a small circle so it
	   reads as a lightweight identifier rather than a "final" image. */
	.ftj-avatar {
		display: block;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		object-fit: cover;
	}

	.ftj-insight__name {
		margin-top: var(--space-3);
		font-size: var(--text-h3);
	}

	.ftj-insight dl {
		margin: var(--space-3) 0 0;
	}

	.ftj-insight dt {
		margin-top: var(--space-4);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.ftj-insight dt:first-child {
		margin-top: 0;
	}

	.ftj-insight dd {
		margin: var(--space-1) 0 0;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.9em;
