					'フィールドの形式、命名ルール、所得の区分で迷っており、より明確な例、補助テキスト、ガイド付きの入力パターンがあれば助かっただろう。',
				revealed: '現実の状況をプロダクトの構造に当てはめなければならない場面で、ポータルの体験にはより多くのサポートが必要だった。',
			},
		],
	},
	postLaunch: {
		facts: [
			{ label: 'デザイン刷新の時期', value: '新LPは、2025年1月の確定申告シーズンの前に公開された。' },
			{ label: '比較の条件', value: '2024年のシーズンは旧LP、2025年のシーズンは新LPに変わったため、それぞれ同じ期間を設定して比較した。' },
			{ label: '期間', value: '2024年1月1日〜24日（旧LP） vs 2025年1月1日〜24日（新LP）' },
		],
		metrics: [
			{ value: '+222%', label: 'ユーザー数' },
			{ value: '+93.4%', label: 'スクロール深度' },
		],
		note: 'これらの数字は、新LPの効果だけではなく、上司やメンターの事業活動の成果でもある。一方で、スクロール深度の向上は、新LPが、ユーザーにとってより直感的で使いやすいデザインになったことを示していると考えている。',
	},
	learnings: [
		{
			title: 'ソリューションの前に、リサーチ',
			body: '競合調査は、解決策を議論する前に、チームに共通の出発点を与えてくれた。',
		},
		{
			title: 'テストは、レビューが見逃すものを明らかにする',
			body: 'ユーザビリティテストは、社内のデザインレビューだけでは気づきにくい混乱を明らかにした。',
		},
		{
			title: 'デザインは協働である',
			body: 'シニアデザイナーと働く中で、プロダクトデザインを個人の作業として扱わず、アイデアで貢献する方法を学んだ。',
		},
	],
	pager: {
		prev: { label: '前のケーススタディ', title: '成長するhubstepの一貫性を保つ', href: '/ja/work/hubstep-foundation/' },
		next: {
			label: '次のケーススタディ',
			title: '天野喜孝の世界を、着られるプロダクトに翻訳する',
			href: '/ja/work/amano-graniph/',
		},
	},
};

const c = ja ? JA : EN;
const translationHref = ja ? '/work/freedom-tax-japan/' : '/ja/work/freedom-tax-japan/';

// Merge the shared image data (file / size / layout) with the per-language text.
const designExamples = c.examples.map((ex, i) => ({
	...ex,
	gridLayout: exampleImages[i].gridLayout,
	steps: ex.steps.map((step, j) => ({
		...step,
		images: exampleImages[i].steps[j].map((img, k) => ({ ...img, label: step.labels[k] })),
	})),
}));

const participants = c.testing.participants.map((p, i) => ({ ...p, photo: participantPhotos[i] }));
---

<BaseLayout title={c.pageTitle} lang={lang} translationHref={translationHref}>
	<article class="content-grid" style="--case-accent: #154384;">
		<CaseHeader
			eyebrow={c.eyebrow}
			title={c.title}
			description={c.description}
			meta={c.meta}
			intro={c.intro}
			challenges={c.challenges}
			lang={lang}
		/>

		<div class="case-study-body">
			<nav class="case-index" aria-label="Case study sections">
				<div class="case-index__eyebrow">{c.indexLabel}</div>
				<ol>
					{
						c.sections.map((s) => (
							<li>
								<a href={`#${s.id}`}>{s.title}</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="case-sections">
				<!-- 01 OUTCOME -->
				<section id="outcome" class="case-section">
					<div class="section-eyebrow">{c.sections[0].eyebrow}</div>
					<h2>{c.sections[0].title}</h2>

					<ol class="ftj-result-steps">
						{
							c.resultSteps.map((step, i) => (
								<li class="ftj-result-step">
									<span class="ftj-result-step__n">{String(i + 1).padStart(2, '0')}</span>
									<p class="ftj-result-step__text" set:html={step.text} />
									{step.stat && (
										<div class="ftj-result-step__stat">
											<div class="ftj-result-step__value">{step.stat.value}</div>
											<div class="ftj-result-step__label">{step.stat.label}</div>
										</div>
									)}
								</li>
							))
						}
					</ol>

					<ScrollableProductPreview
						src="/freedom-tax-japan/outcome/final-landing-page.png"
						alt={c.finalLanding.alt}
						label={c.finalLanding.label}
						height={480}
					/>
				</section>

				<!-- DETAILS: introduces the sections that unpack the Overview -->
				<div class="ftj-part">
					<div class="section-eyebrow">{c.detailsPart.label}</div>
					<h2 class="ftj-part__title">{c.detailsPart.title}</h2>
					<p class="ftj-part__lead">{c.detailsPart.lead}</p>
				</div>

				<!-- 02 RESEARCH -->
				<section id="research" class="case-section">
					<div class="section-eyebrow">{c.sections[1].eyebrow}</div>
					<h2>{c.sections[1].title}</h2>

					<figure class="ftj-audit">
						<EnlargeableImage
							src="/freedom-tax-japan/research/competitive-audit.png"
							alt={c.research.auditAlt}
							enlargeable={false}
						/>
						<figcaption class="ftj-audit__caption">{c.research.auditCaption}</figcaption>
					</figure>

					<div class="ftj-research-row">
						<figure class="ftj-research-row__visual">
							<EnlargeableImage
								src="/freedom-tax-japan/research/app-competitive-audit.png"
								alt={c.research.appAlt}
								enlargeable={false}
							/>
							<figcaption class="ftj-audit__caption">{c.research.appCaption}</figcaption>
						</figure>
						<div class="prose ftj-research-row__text">
							{c.research.text.map((p) => <p set:html={p} />)}
						</div>
					</div>

					<div class="ftj-insights-list">
						<div class="ftj-insights-list__tag">{c.research.insightsHeading}</div>
						<ul>
							{c.research.insights.map((t) => <li set:html={t} />)}
						</ul>
					</div>

					<div class="ftj-synthesis">
						<div class="section-eyebrow">{c.synthesis.eyebrow}</div>
						<h3 class="ftj-synthesis__heading">{c.synthesis.heading}</h3>
						<div class="prose">
							<p set:html={c.synthesis.text} />
						</div>

						<div class="ftj-synthesis__grid">
							{
								c.synthesis.items.map((item) => (
									<div class="ftj-synthesis__item">
										<div class="ftj-synthesis__tag">
											<span class="ftj-synthesis__num">{item.num}</span>
											<span class="ftj-synthesis__label">{item.label}</span>
										</div>
										<h4 class="ftj-synthesis__item-heading">{item.heading}</h4>
										<p class="ftj-synthesis__body" set:html={item.body} />
										<p class="ftj-synthesis__keywords" set:html={item.keywords} />
									</div>
								))
							}
						</div>
					</div>
				</section>

				<!-- 03 DESIGN EXPLORATION -->
				<section id="design-exploration" class="case-section">
					<div class="section-eyebrow">{c.sections[2].eyebrow}</div>
					<h2>{c.sections[2].title}</h2>

					<div class="prose">
						<p set:html={c.designBrainstorm} />
						<p>{c.designBrainstormDetail}</p>
						<p>{c.designIntro}</p>
					</div>

					<div class="ftj-examples">
						{
							designExamples.map((example) => (
								<div class="ftj-example">
									<div class="section-eyebrow">{example.eyebrow}</div>
									<h3 class="ftj-example__heading">{example.heading}</h3>

									<div class="ftj-ex-boxes" style={`--n: ${example.boxes.length};`}>
										{example.boxes.map((b) => (
											<div class:list={['ftj-ex-box', b.label === 'Result' && 'ftj-ex-box--result']}>
												<span class="ftj-ex-box__tag">{b.label}</span>
												<p class="ftj-ex-box__text" set:html={b.text} />
											</div>
										))}
									</div>

									{example.quote && (
										<blockquote class="ftj-quote">
											<p class="ftj-quote__text">{example.quote.text}</p>
											<footer class="ftj-quote__source">{example.quote.label}</footer>
										</blockquote>
									)}

									{example.gridLayout ? (
										<div class="ftj-steps-grid">
											{example.steps.map((step, i) => (
												<figure
													class:list={[
														'ftj-steps-grid__item',
														i === example.steps.length - 1 && example.steps.length % 2 !== 0 && 'ftj-steps-grid__item--full',
													]}
												>
													<div class="section-eyebrow">
														{String(i + 1).padStart(2, '0')} — {step.tag}
													</div>
													<div class="ftj-steps__images">
														{step.images.map((image) => (
															<img
																class="ftj-steps__img"
																src={`/freedom-tax-japan/design-exploration/${image.file}.png`}
																alt={image.label}
																width={image.width}
																height={image.height}
																loading="lazy"
																decoding="async"
															/>
														))}
													</div>
													{step.caption && <figcaption class="ftj-audit__caption">{step.caption}</figcaption>}
												</figure>
											))}
										</div>
									) : (
										<div class="ftj-steps">
											{example.steps.map((step, i) => (
												<figure class="ftj-steps__step">
													<div class="section-eyebrow">
														{String(i + 1).padStart(2, '0')} — {step.tag}
													</div>
													<div class="ftj-steps__images">
														{step.images.map((image) => (
															<img
																class="ftj-steps__img"
																src={`/freedom-tax-japan/design-exploration/${image.file}.png`}
																alt={image.label}
																width={image.width}
																height={image.height}
																loading="lazy"
																decoding="async"
															/>
														))}
													</div>
													{step.caption && <figcaption class="ftj-audit__caption">{step.caption}</figcaption>}
												</figure>
											))}
										</div>
									)}
								</div>
							))
						}
					</div>
				</section>

				<!-- 04 USABILITY TESTING (strongest section) -->
				<section id="usability-testing" class="case-section ftj-testing">
					<div class="section-eyebrow">{c.sections[3].eyebrow}</div>
					<h2>{c.sections[3].title}</h2>

					<div class="prose">
						{c.testing.text.map((p) => <p>{p}</p>)}
					</div>

					<EnlargeableImage
						src="/freedom-tax-japan/usability-testing/usability-testing-documentation.png"
						alt={c.testing.boardAlt}
						enlargeable={false}
					/>

					<div class="ftj-setup">
						<div class="ftj-setup__label">{c.testing.setupLabel}</div>
						<ul>
							{c.testing.setup.map((s) => <li>{s}</li>)}
						</ul>
					</div>

					<div class="ftj-insights-head">{c.testing.insightsHead}</div>
					<div class="ftj-insights">
						{
							participants.map((p) => (
								<article class="ftj-insight">
									<img
										class="ftj-avatar"
										src={`/freedom-tax-japan/usability-testing/${p.photo}.jpg`}
										alt=""
										width="120"
										height="120"
										loading="lazy"
										decoding="async"
									/>
									<h3 class="ftj-insight__name">{p.name}</h3>
									<dl>
										<dt>{c.testing.dt.context}</dt>
										<dd>{p.context}</dd>
										<dt>{c.testing.dt.reacted}</dt>
										<dd>{p.reacted}</dd>
										<dt>{c.testing.dt.revealed}</dt>
										<dd class="ftj-insight__revealed">{p.revealed}</dd>
									</dl>
								</article>
							))
						}
					</div>

					<div class="ftj-revision">
						<h3 class="ftj-revision__heading">{c.testing.revision.heading}</h3>
						<p class="ftj-revision__lead">{c.testing.revision.lead}</p>
						<div class="ftj-revision__table" role="table">
							<div class="ftj-revision__row ftj-revision__row--head" role="row">
								<span role="columnheader"></span>
								<span role="columnheader">{c.testing.revision.cols.before}</span>
								<span role="columnheader">{c.testing.revision.cols.after}</span>
							</div>
							{
								c.testing.revision.rows.map((r) => (
									<div class="ftj-revision__row" role="row">
										<span class="ftj-revision__what" role="rowheader">{r.what}</span>
										<span class="ftj-revision__before" role="cell">{r.before}</span>
										<span class="ftj-revision__after" role="cell">{r.after}</span>
									</div>
								))
							}
						</div>
					</div>
				</section>

				<!-- 05 POST-LAUNCH DATA -->
				<section id="post-launch-data" class="case-section">
					<div class="section-eyebrow">{c.sections[4].eyebrow}</div>
					<h2>{c.sections[4].title}</h2>

					<dl class="ftj-data__facts">
						{
							c.postLaunch.facts.map((f) => (
								<div class="ftj-data__fact">
									<dt>{f.label}</dt>
									<dd>{f.value}</dd>
								</div>
							))
						}
					</dl>

					<div class="ftj-data__metrics">
						{
							c.postLaunch.metrics.map((m) => (
								<div class="ftj-data__metric">
									<div class="ftj-data__value">{m.value}</div>
									<div class="ftj-data__label">{m.label}</div>
								</div>
							))
						}
					</div>

					<div class="prose">
						<p>{c.postLaunch.note}</p>
					</div>
				</section>

				<!-- 06 LEARNING -->
				<section id="learning" class="case-section">
					<div class="section-eyebrow">{c.sections[5].eyebrow}</div>
					<h2>{c.sections[5].title}</h2>

					<ol class="ftj-learnings">
						{
							c.learnings.map((l, i) => (
								<li>
									<div class="ftj-learnings__num">{String(i + 1).padStart(2, '0')}</div>
									<div class="ftj-learnings__title">{l.title}</div>
									<p class="ftj-learnings__body">{l.body}</p>
								</li>
							))
						}
					</ol>
				</section>
			</div>
		</div>

		<nav class="ftj-pager" aria-label="Case study navigation">
			<a href={c.pager.prev.href}>
				<span class="ftj-pager__label">{c.pager.prev.label}</span>
				<span class="ftj-pager__title">{c.pager.prev.title}</span>
			</a>
			<a href={c.pager.next.href} class="ftj-pager__next">
				<span class="ftj-pager__label">{c.pager.next.label}</span>
				<span class="ftj-pager__title">{c.pager.next.title}</span>
			</a>
		</nav>
	</article>
</BaseLayout>

<style>
	/* FTJ's own reserved accent (sampled from the product's brand blue,
	   same reasoning as the hubstep teal via --color-accent in
	   global.css) for the active Section Index item — kept local to
	   this page rather than promoted to a shared token, since it's a
	   per-case-study brand color, not a sitewide one. */
	.case-index a.is-active {
		color: #0496ce;
	}

	/* Vertical rhythm inside a section: heading, then blocks spaced evenly. */
	.case-section > :global(* + *) {
		margin-top: var(--space-4);
	}

	.case-section > h2 + :global(*) {
		margin-top: var(--space-4);
	}

	.ftj-example .ftj-steps-grid,
	.ftj-example .ftj-steps {
		margin-top: var(--space-4);
	}

	/* Problem / Suggestion / Result boxes inside each design example. */
	.ftj-ex-boxes {
		margin-top: var(--space-3);
		display: grid;
		grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
		gap: var(--space-3);
	}

	.ftj-ex-box {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-4) var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 20px;
		box-shadow: 0 4px 16px -8px rgba(17, 17, 17, 0.12);
	}

	.ftj-ex-box--result {
		background: rgba(21, 67, 132, 0.04);
		border-color: rgba(21, 67, 132, 0.25);
	}

	.ftj-ex-box__tag {
		font-family: var(--font-sans);
		font-size: var(--text-label);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.ftj-ex-box--result .ftj-ex-box__tag {
		color: #154384;
	}

	.ftj-ex-box__text {
		margin: 0;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.ftj-ex-box__text :global(strong) {
		color: var(--color-text);
		font-weight: 600;
	}

	/* Pull quote under the boxes — same look as the site's quotes (left
	   rule, italic), with the text in FTJ blue. */
	.ftj-quote {
		margin: var(--space-4) 0 0;
		padding-left: var(--space-3);
		border-left: 2px solid var(--color-border);
	}

	.ftj-quote__text {
		margin: 0;
		font-style: italic;
		font-weight: 600;
		line-height: 1.7;
		color: #154384;
	}

	.ftj-quote__source {
		margin-top: var(--space-1);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	/* Divider heading between the Overview and the detailed sections. */
	.ftj-part {
		margin-top: var(--space-editorial);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.ftj-part__title {
		margin: 0;
		font-size: var(--text-h2);
		font-weight: 700;
		line-height: 1.2;
	}

	.ftj-part__lead {
		margin: var(--space-2) 0 0;
		color: var(--color-text-muted);
	}

	/* Results: the project told as five short steps, each a filled
	   "point" block (FTJ blue tint) with its key number on the right. */
	.ftj-result-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.ftj-result-step {
		display: grid;
		grid-template-columns: 2.5rem 1fr 11rem;
		gap: var(--space-3);
		align-items: center;
		padding: var(--space-3) var(--space-4);
		border-radius: 14px;
		background: rgba(21, 67, 132, 0.06);
	}

	.ftj-result-step__n {
		font-family: var(--font-sans);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.ftj-result-step__text {
		margin: 0;
		line-height: 1.75;
		color: var(--color-text);
	}

	.ftj-result-step__text :global(strong) {
		color: #154384;
		font-weight: 700;
	}

	.ftj-result-step__stat {
		text-align: right;
	}

	.ftj-result-step__value {
		font-family: var(--font-sans);
		font-size: var(--text-h2);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: #154384;
	}

	.ftj-result-step__label {
		margin-top: 0.25em;
		font-size: var(--text-label);
		line-height: 1.4;
		color: var(--color-text-muted);
	}

	/* Post-launch data: the conditions of the comparison, then the two
	   headline numbers, in the same hairline-row look as the Results list. */
	.ftj-data__facts {
		margin: 0;
		border-top: 1px solid var(--color-border);
	}

	.ftj-data__fact {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: var(--space-3);
		padding: var(--space-2) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.ftj-data__fact dt {
		font-size: var(--text-label);
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}

	.ftj-data__fact dd {
		margin: 0;
		line-height: 1.7;
	}

	.ftj-data__metrics {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-4);
	}

	.ftj-data__value {
		font-family: var(--font-sans);
		font-size: var(--text-h2);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: #154384;
	}

	.ftj-data__label {
		margin-top: var(--space-1);
		color: var(--color-text-muted);
	}

	.ftj-result-step__text :global(a) {
		display: inline-block;
		margin-left: 0.5em;
		font-size: var(--text-label);
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.ftj-result-step__text :global(a:hover) {
		color: var(--color-text);
	}

	/* Highlighted panel (same callout look as the Key point on the hubstep
	   page, in FTJ's blue): a tinted rounded box with a small blue tag. */
	.ftj-insights-list {
		padding: var(--space-4);
		border-radius: 14px;
		background: rgba(21, 67, 132, 0.06);
	}

	.ftj-insights-list__tag {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #154384;
	}

	.ftj-insights-list ul {
		margin: var(--space-2) 0 0;
		padding-left: 1.25em;
	}

	.ftj-insights-list li {
		margin-top: var(--space-1);
		line-height: 1.75;
		color: var(--color-text);
	}

	.ftj-insights-list li::marker {
		color: #154384;
	}

	.ftj-insights-list li :global(strong) {
		color: #154384;
		font-weight: 700;
	}

	/* Revision example: what the testing showed, and the copy that changed. */
	.ftj-revision__heading {
		margin: 0;
		font-size: var(--text-body);
		font-weight: 600;
	}

	.ftj-revision__lead {
		margin: var(--space-2) 0 var(--space-3);
		line-height: 1.75;
		color: var(--color-text-muted);
	}

	.ftj-revision__row {
		display: grid;
		grid-template-columns: 8rem 1fr 1fr;
		gap: var(--space-3);
		padding: var(--space-2) 0;
		border-top: 1px solid var(--color-border);
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.ftj-revision__row:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.ftj-revision__row--head {
		font-size: var(--text-label);
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}

	.ftj-revision__what {
		color: var(--color-text-muted);
	}

	.ftj-revision__before {
		color: var(--color-text-muted);
	}

	.ftj-revision__after {
		font-weight: 600;
		color: #154384;
	}

	/* Research: the competitive-audit visual, enlargeable since its value
	   is in showing the breadth of the audit, not being legible inline
	   at full width (per EnlargeableImage's existing lightbox pattern). */
	.ftj-audit__caption {
		margin: var(--space-2) 0 0;
		font-size: var(--text-label);
		color: var(--color-text-muted);
	}

	/* App audit sits beside its own explanation rather than stacking as
	   a second full-width hero image — reads as an extension of the
	   research (smaller, paired with text) rather than competing with
	   the Desktop audit above. ~52/48 split, with a wide gap standing
	   in for "generous whitespace between them". */
	.ftj-research-row {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: var(--space-8);
		align-items: center;
		margin-top: var(--space-8);
	}

	.ftj-research-row__visual {
		margin: 0;
	}

	.ftj-research-row__text {
		max-width: none;
	}

	/* Research synthesis — two findings the audit narrowed the redesign
	   to. Deliberately plain (hairline + numbering, no card chrome) to
	   stay editorial rather than reading as a UI component. */
	.ftj-synthesis {
		margin-top: var(--space-8);
	}

	.ftj-synthesis__heading {
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	/* Card grid: rows are shared via subgrid, so each row (tag / heading /
	   body / keywords) takes the height of whichever card needs more —
	   the shorter card's cells stretch to match, which is what keeps the
	   heading block and the keywords line aligned across both cards
	   regardless of copy length, without hardcoding any heights. */
	.ftj-synthesis__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: auto auto auto auto;
		column-gap: var(--space-6);
		margin-top: var(--space-4);
	}

	.ftj-synthesis__item {
		display: grid;
		grid-template-rows: subgrid;
		grid-row: 1 / -1;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 20px;
		box-shadow: 0 4px 16px -8px rgba(17, 17, 17, 0.12);
	}

	.ftj-synthesis__tag {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
	}

	.ftj-synthesis__num,
	.ftj-learnings__num {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.ftj-synthesis__label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
	}

	.ftj-synthesis__item-heading {
		/* h4 isn't covered by global.css's h1/h2/h3 margin reset, so its
		   UA default margin-bottom (~1em) was adding extra space here on
		   top of the next element's own margin-top — reset it explicitly. */
		margin: var(--space-2) 0 0;
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
		color: #154384;
	}

	.ftj-synthesis__body {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.9em;
		line-height: 1.75;
	}

	.ftj-synthesis__body strong {
		font-weight: 600;
	}

	.ftj-synthesis__keywords {
		margin-top: var(--space-2);
		font-size: var(--text-label);
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	/* Design exploration: each example gets generous room to breathe
	   (space-editorial-ish gap) since the visuals carry the story and
	   shouldn't feel cramped together. */
	.ftj-examples {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
	}

	.ftj-insights-head,
	.ftj-setup__label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.ftj-example__heading {
		margin-top: var(--space-2);
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.3;
	}

	/* Flexbox rather than a fixed-column grid so a 2-step (exploration →
	   implemented) and a 3-step (before → reference → implemented)
	   example both lay out correctly without separate markup. */
	.ftj-steps {
		display: flex;
		align-items: flex-start;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.ftj-steps__step {
		flex: 1;
		min-width: 0;
		margin: 0;
	}

	.ftj-steps__step .section-eyebrow {
		margin-bottom: var(--space-2);
	}

	/* Real screenshots, not a uniform placeholder box — each renders at
	   its own natural aspect ratio (no crop/distortion), so steps in the
	   same row can end at different heights when their source images
	   have different proportions. */
	.ftj-steps__img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* A step can hold more than one image (Example 03's "Exploration"
	   step shows two directions explored before the team converged) —
	   stacked in place rather than spilling into their own columns, so
	   they still read as one step in the Before/Exploration/Implemented
	   sequence rather than a whole extra step. */
	.ftj-steps__images {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	/* Example 01 only: 2x2 editorial grid instead of a single row, so
	   four screens can run much larger. No arrows — numbering + the
	   existing eyebrow label style (reused as-is, not a new type style)
	   carry the sequence instead of a process-diagram feel. */
	.ftj-steps-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: var(--space-6);
		row-gap: var(--space-8);
		margin-top: var(--space-4);
	}

	.ftj-steps-grid__item {
		margin: 0;
	}

	/* A lone item in the last row (odd step count, e.g. Example 02's
	   3-step Before/My proposal/Implemented) spans both columns instead
	   of sitting half-width with an empty cell beside it — reads as the
	   result the other two lead up to, not a leftover. */
	.ftj-steps-grid__item--full {
		grid-column: 1 / -1;
	}

	.ftj-steps-grid__item--full .ftj-steps__images {
		max-width: 60%;
	}

	.ftj-steps-grid__item .section-eyebrow {
		margin-bottom: var(--space-2);
	}

	/* Usability testing: the heaviest section — bigger heading, more air,
	   a tinted band for the setup summary, larger participant blocks. */
	.ftj-testing {
		margin-top: calc(var(--space-editorial) * 1.15);
	}

	.case-section.ftj-testing > h2 {
		font-size: var(--text-h2);
	}

	.ftj-setup {
		padding: var(--space-3) 0;
		border-top: 1px solid var(--color-text);
		border-bottom: 1px solid var(--color-border);
	}

	.ftj-setup ul {
		list-style: none;
		margin: var(--space-2) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
		font-weight: 600;
		font-size: 0.9em;
	}

	.ftj-insights-head {
		margin-top: var(--space-8);
	}

	.ftj-insights {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-8) var(--space-4);
	}

	.case-section > .ftj-insights {
		margin-top: var(--space-3);
	}

	/* Anonymized-participant avatar — a generic themed photo, not a
	   portrait of the actual person, cropped to a small circle so it
	   reads as a lightweight identifier rather than a "final" image. */
	.ftj-avatar {
		display: block;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		object-fit: cover;
	}

	.ftj-insight__name {
		margin-top: var(--space-3);
		font-size: var(--text-h3);
	}

	.ftj-insight dl {
		margin: var(--space-3) 0 0;
	}

	.ftj-insight dt {
		margin-top: var(--space-4);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.ftj-insight dt:first-child {
		margin-top: 0;
	}

	.ftj-insight dd {
		margin: var(--space-1) 0 0;
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.9em;
		line-height: 1.75;
	}

	/* Specificity needs to beat ".ftj-insight dd" above (which now sets
	   the muted/Montserrat body treatment) so this stays the emphasized,
	   near-black takeaway line rather than blending into the rest of
	   the card. */
	.ftj-insight dd.ftj-insight__revealed {
		color: var(--color-text);
		font-family: var(--font-sans);
		font-weight: 600;
	}

	/* Learning: three short rows. */
	.ftj-learnings {
		list-style: none;
		margin: var(--space-4) 0 0;
		padding: 0;
	}

	.ftj-learnings li {
		display: grid;
		grid-template-columns: 3rem 1fr;
		column-gap: var(--space-2);
		padding: var(--space-3) 0;
		border-top: 1px solid var(--color-border);
	}

	.ftj-learnings li:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.ftj-learnings__title {
		font-size: var(--text-h3);
		font-weight: 700;
		line-height: 1.2;
	}

	.ftj-learnings__body {
		grid-column: 2;
		margin: var(--space-1) 0 0;
		max-width: var(--measure);
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-size: 0.9em;
		line-height: 1.75;
	}

	/* Footer navigation: Previous / Back to all work. */
	.ftj-pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
		margin-top: var(--space-16);
		padding: var(--space-6) 0 0;
		border-top: 1px solid var(--color-border);
	}

	.ftj-pager a {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		text-decoration: none;
		transition: opacity 150ms ease;
	}

	.ftj-pager a:hover,
	.ftj-pager a:focus-visible {
		opacity: 0.7;
	}

	.ftj-pager__next {
		text-align: right;
		align-items: flex-end;
	}

	.ftj-pager__label {
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.ftj-pager__title {
		font-size: var(--text-h3);
		font-weight: 700;
		line-height: 1.2;
	}

	@media (max-width: 640px) {
		.ftj-result-step {
			grid-template-columns: 2rem 1fr;
