				{ what: '1文目', before: '95% of accountants focus on companies', after: '95% of accountants in Japan focus on companies' },
				{ what: '結びの文', before: 'At FreedomTax Japan we want to close this gap.', after: 'FreedomTax Japan exists to close this gap.' },
			],
		},
		dt: { context: 'コンテキスト', reacted: '反応していた点', revealed: 'そこから見えたこと' },
		participants: [
			{
